---
interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  /** Optional OG image URL (absolute). Defaults to site + /og.png */
  imageURL?: string;
  /** 'website' | 'article'. Use 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** For article: ISO date string. Enables og:article:published_time */
  articlePublishedTime?: string;
  /** For article: ISO date string. Enables og:article:modified_time */
  articleModifiedTime?: string;
  /** For article: author name. Enables og:article:author */
  articleAuthor?: string;
}

const { title, description = 'Bloss0m — AI 平台與 Agentic AI 工程：企業級 RAG、多代理協作、即時 AI 系統。專案含投影片轉影片、LINE 貼圖、BloomRender、語音助理等；部落格分享 Generative AI、評估與實作經驗。', canonicalURL, imageURL, ogType = 'website', articlePublishedTime, articleModifiedTime, articleAuthor } = Astro.props;
const site = Astro.site ?? new URL('https://poirotw66.github.io');
const canonical = canonicalURL ?? new URL(Astro.url.pathname, site);
const ogImage = imageURL ?? new URL('/og.png', site).toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const siteUrl = site.toString().replace(/\/$/, '');
const navLinks = [
  { href: '/projects/', labelEn: 'Projects', labelZh: '專案' },
  { href: '/blog/', labelEn: 'Blog', labelZh: '部落格' },
  { href: '/paper-reading/', labelEn: 'Paper Reading', labelZh: '論文精讀' },
  { href: '/lab/', labelEn: 'Lab', labelZh: '實驗室' },
  { href: '/stickers/', labelEn: 'Stickers', labelZh: '貼圖' },
  { href: '/contact/', labelEn: 'Contact', labelZh: '聯絡' },
] as const;
---

<!DOCTYPE html>
<html lang="zh-Hant" class="lang-zh" data-theme="warm">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FKETRDJWMH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FKETRDJWMH');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bloss0m — AI Platform & Agentic AI Engineer" />
    <meta property="og:locale" content="zh_Hant" />
    <meta property="og:site_name" content="Bloss0m" />
    {ogType === 'article' && articlePublishedTime && <meta property="og:article:published_time" content={articlePublishedTime} />}
    {ogType === 'article' && articleModifiedTime && <meta property="og:article:modified_time" content={articleModifiedTime} />}
    {ogType === 'article' && articleAuthor && <meta property="og:article:author" content={articleAuthor} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: 'Bloss0m',
          description: 'Bloss0m — AI 平台與 Agentic AI 工程：企業級 RAG、多代理協作、即時 AI 系統。部落格分享 Generative AI、評估與實作經驗。',
          publisher: { '@id': `${siteUrl}/#organization` },
          inLanguage: 'zh-Hant',
        },
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: 'Bloss0m',
          url: siteUrl,
          logo: { '@type': 'ImageObject', url: new URL('/favicon.png', site).toString() },
        },
      ],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link" data-en="Skip to main content" data-zh="跳過至主內容">跳過至主內容</a>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">Bloss0m</a>
        <ul class="nav-links">
          {navLinks.map(({ href, labelEn, labelZh }) => {
            const hrefNorm = href === '/' ? '/' : href.replace(/\/$/, '');
            const isCurrent = path === hrefNorm || (hrefNorm !== '/' && path.startsWith(hrefNorm));
            return (
              <li>
                <a href={href} data-en={labelEn} data-zh={labelZh} aria-current={isCurrent ? 'page' : undefined}>{labelZh}</a>
              </li>
            );
          })}
        </ul>
        <div class="nav-right">
          <div class="theme-switcher" role="group" aria-label="Theme">
            <button type="button" data-theme-btn="dark" aria-pressed="false" class="theme-btn" data-en="Dark" data-zh="黑夜">黑夜</button>
            <button type="button" data-theme-btn="warm" aria-pressed="true" class="theme-btn theme-btn-active" data-en="Warm" data-zh="暖色">暖色</button>
          </div>
          <div class="lang-switcher">
            <button type="button" data-lang="en" aria-label="English">EN</button>
            <button type="button" data-lang="zh" aria-label="繁體中文">繁中</button>
          </div>
        </div>
      </div>
    </nav>
    <main id="main" class="main-content">
      <slot />
    </main>
    <script is:inline src="/js/theme.js" defer></script>
    <script is:inline src="/js/lang.js" defer></script>
  </body>
</html>
