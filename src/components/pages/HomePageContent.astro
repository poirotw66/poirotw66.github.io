---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate, getLabProjects } from '../../utils/sort';
import { groupLabProjectsByZone } from '../../utils/labZone';
import { toLocalizedPath } from '../../i18n/utils';
import ProjectCard from '../ProjectCard.astro';
import StickerCard from '../StickerCard.astro';
import PaperPreviewItem from '../PaperPreviewItem.astro';
import CtaBlock from '../CtaBlock.astro';
import SectionHeading from '../SectionHeading.astro';
import SectionIntro from '../SectionIntro.astro';
import HomeWritingLane from '../HomeWritingLane.astro';
import HomeSectionNav from '../HomeSectionNav.astro';
import HomeStartHere from '../HomeStartHere.astro';
import HomeRoadmap from '../HomeRoadmap.astro';
import HomeTrustBar from '../HomeTrustBar.astro';
import HomeCaseStudy from '../HomeCaseStudy.astro';
import HomeJourney from '../HomeJourney.astro';
import {
  BLOG_LANE_COPY,
  BLOG_WRITING_SECTION_COPY,
  getLanePreviewPosts,
} from '../../utils/blogLanes';
import { resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import {
  HOME_CASE_STUDY_SLUGS,
  homeCaseStudyDetails,
  type HomeCaseStudySlug,
} from '../../data/homeBrand';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const HOME_LIST_LIMIT = 3;

const allBlogPosts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const engineeringPreview = getLanePreviewPosts(allBlogPosts, 'engineering');
const pulsePreview = getLanePreviewPosts(allBlogPosts, 'pulse');
const starterPreview = getLanePreviewPosts(allBlogPosts, 'starter', { featured: 1, compact: 2 });
const writingLanes = [
  { id: 'starter' as const, preview: starterPreview },
  { id: 'engineering' as const, preview: engineeringPreview },
  { id: 'pulse' as const, preview: pulsePreview },
];
const allPaperReadings = sortByPubDate(resolveEntriesForLang(await getCollection('paperReading'), lang));
const paperReadings = allPaperReadings.slice(0, HOME_LIST_LIMIT);
const stickers = sortByPubDate(resolveEntriesForLang(await getCollection('stickers'), lang)).slice(0, 4);
const allProjectEntries = resolveEntriesForLang(await getCollection('projects'), lang);
const projectBySlug = new Map(allProjectEntries.map((entry) => [baseSlug(entry), entry]));
const projects = HOME_CASE_STUDY_SLUGS.flatMap((slug) => {
  const entry = projectBySlug.get(slug);
  return entry ? [entry] : [];
});
const mainProjectCount = allProjectEntries.filter((entry) => entry.data.tier !== 'lab').length;
const publicBuildCount = allProjectEntries.filter((entry) => Boolean(entry.data.repoUrl)).length;
const labProjects = getLabProjects(allProjectEntries);
const labByZone = groupLabProjectsByZone(allProjectEntries);
const labPreviewIds = new Set<string>();
const labPreview: typeof allProjectEntries = [];
for (const entry of [labByZone.competition[0], labByZone.creative[0], ...labProjects]) {
  if (!entry || labPreviewIds.has(baseSlug(entry))) continue;
  labPreviewIds.add(baseSlug(entry));
  labPreview.push(entry);
  if (labPreview.length >= 2) break;
}
const stickerPreview = stickers.slice(0, 2);
const isEn = lang === 'en';
const trustItems = isEn
  ? [
      { value: allBlogPosts.length, label: 'published insights' },
      { value: mainProjectCount, label: 'project case studies' },
      { value: allPaperReadings.length, label: 'paper notes' },
      { value: publicBuildCount, label: 'public repositories' },
    ]
  : [
      { value: allBlogPosts.length, label: '篇技術觀點' },
      { value: mainProjectCount, label: '個專案案例' },
      { value: allPaperReadings.length, label: '篇論文精讀' },
      { value: publicBuildCount, label: '個公開程式庫' },
    ];

const pageDescription =
  lang === 'en'
    ? "Bloss0m is Justin's AI Engineering Studio for turning enterprise AI, agent, and RAG prototypes into operable systems."
    : 'Bloss0m 是 Justin 經營的 AI Engineering Studio，專注把企業 AI、Agent 與 RAG 原型做成可維運、可驗證的系統。';

const hero = isEn
  ? {
      eyebrow: "Justin's AI Engineering Studio",
      title: 'I turn enterprise AI prototypes into operable systems.',
      tagline: 'Agentic RAG, document intelligence, and multi-agent workflows — designed for measurable delivery, not just demos.',
      pullQuote:
        'Build in public, measure what matters, and design every AI system for the people who will operate it.',
      lead:
        'Bloss0m is where I document how enterprise AI systems are designed, evaluated, deployed, and handed over — with public case studies, engineering notes, and reusable tools.',
      primaryCta: 'View case studies',
      primaryHref: '#showcase',
      secondaryCta: 'Discuss a collaboration',
      secondaryHref: toLocalizedPath('/contact/', lang),
      proof: [
        'Architecture documented in public',
        'Outcomes measured before claims',
        'Operations and handoff designed in',
      ],
      signalTitle: 'Four core topics',
      signals: [
        { title: 'AI Agent in practice', body: 'Architectures, tools, memory, evaluation, security, and multi-agent coordination.', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: 'Explore AI agents →' },
        { title: 'Enterprise RAG', body: 'Retrieval architecture, hybrid search, evaluation, knowledge governance, and real delivery cases.', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: 'Explore enterprise RAG →' },
        { title: 'AI Engineering', body: 'Harnesses, observability, guardrails, cost, latency, and production platform design.', href: toLocalizedPath('/blog/?lane=engineering', lang), cta: 'Explore AI engineering →' },
        { title: 'AI trends, unpacked', body: 'Model releases, technical papers, and industry signals translated into engineering implications.', href: toLocalizedPath('/blog/?lane=pulse', lang), cta: 'Explore trend analysis →' },
      ],
      showcaseTitle: 'AI systems, shown as evidence',
      showcaseLink: 'View all',
      blogTitle: 'Latest Insights',
      paperTitle: 'Paper Reading',
      labTitle: 'Competitions, tools & games',
      labSubtitle: 'Kaggle notes · playful builds',
      stickerTitle: 'Stickers & creator tools',
      stickerSubtitle: 'Original sets · open-source workflows',
      labLink: 'View all',
      stickerTools: 'Make your own (3 tools)',
      stickerLink: 'View all',
      ctaText: 'If you are evaluating an AI platform, agent workflow, or enterprise RAG initiative, I can help move it from prototype to a system your team can actually operate.',
      ctaButton: 'Start a conversation',
      mascotLabel: 'Your Bloss0m guide',
      mascotName: 'Meet Huahua',
      mascotLine: 'Huahua is organizing practical notes on agents, RAG, and AI engineering — so complex ideas can become systems teams can run.',
      mascotAlt: 'Huahua, the Bloss0m calico cat mascot, surrounded by flowers and a star',
      kickerSignals: 'Focus',
      kickerShowcase: 'Projects',
      kickerBlog: 'Writing',
      kickerPaper: 'Papers',
      kickerLab: 'Lab',
      kickerStickers: 'Stickers',
      exploreTitle: "Huahua's Creative Lab",
      exploreKicker: 'Huahua · Lab',
      startHereTitle: 'New here? Start here',
      startHerePaths: [
        { label: 'Understand AI agents → Practical guides', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), image: '/brand/start-here/agent.webp' },
        { label: 'Build enterprise RAG → Architecture & cases', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), image: '/brand/start-here/rag.webp' },
        { label: 'Ship an AI PoC → Engineering notes', href: toLocalizedPath('/blog/?lane=engineering', lang), image: '/brand/start-here/engineering.webp' },
        { label: 'Follow AI engineering → Trend analysis', href: toLocalizedPath('/blog/?lane=pulse', lang), image: '/brand/start-here/trends.webp' },
      ],
      writingGuide: 'Not sure where to begin? Start with curated picks.',
      authorKicker: 'About',
      authorTitle: 'Justin & Huahua',
      authorLead: 'Justin builds verifiable, deployable enterprise AI systems; Huahua makes the ideas easier to approach.',
      authorPanelTitle: 'Deep engineering, warm perspective',
      authorRole: 'AI Platform & Agentic AI Engineer',
      authorRoleBody: 'From document intelligence and enterprise RAG to production agent workflows.',
      huahuaRole: 'Bloss0m guide',
      huahuaRoleBody: 'A friendly guide to complex ideas and clear technical judgment.',
      authorTags: ['Enterprise AI', 'Agentic RAG', 'AI Platform'],
      authorAbout: 'About Justin',
      authorContact: 'LinkedIn',
    }
  : {
      eyebrow: 'Justin 的 AI Engineering Studio',
      title: '把企業 AI 從 PoC 做成可維運的系統',
      tagline: '專注 Agentic RAG、文件智能與多代理工作流；用可衡量的成果證明交付，而不只展示 Demo。',
      pullQuote: '公開建造、衡量真正重要的成果，並讓每套 AI 系統都為未來要維運它的人而設計。',
      lead:
        'Bloss0m 記錄我如何設計、評測、部署與交接企業 AI 系統，透過公開案例、工程筆記與可重用工具，讓技術能力與判斷都能被驗證。',
      primaryCta: '查看代表案例',
      primaryHref: '#showcase',
      secondaryCta: '討論合作',
      secondaryHref: toLocalizedPath('/contact/', lang),
      proof: [
        '架構與取捨公開可查',
        '先量測成果，再提出主張',
        '從一開始就設計維運與交接',
      ],
      signalTitle: '四大核心專題',
      signals: [
        { title: 'AI Agent 實戰', body: '架構、工具、記憶、評測、安全治理與多代理協作。', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: '探索 AI Agent →' },
        { title: 'Enterprise RAG', body: '檢索架構、Hybrid Search、評估、知識治理與真實落地案例。', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: '探索企業 RAG →' },
        { title: 'AI Engineering', body: 'Harness、可觀測性、Guardrails、成本延遲與正式環境平台設計。', href: toLocalizedPath('/blog/?lane=engineering', lang), cta: '探索 AI Engineering →' },
        { title: 'AI 趨勢拆解', body: '將模型發布、技術白皮書與產業訊號，轉化成工程與企業決策觀點。', href: toLocalizedPath('/blog/?lane=pulse', lang), cta: '探索趨勢解析 →' },
      ],
      showcaseTitle: '用真實系統證明能力',
      showcaseLink: '看全部',
      blogTitle: '最新觀點與實作',
      paperTitle: '論文精讀',
      labTitle: '競賽、工具與遊戲',
      labSubtitle: 'Kaggle 實作 · 創意實驗',
      stickerTitle: '貼圖與創作工具',
      stickerSubtitle: '原創貼圖 · 開源工作流',
      labLink: '看全部',
      stickerTools: '用 3 個開源工具自己做貼圖',
      stickerLink: '看全部',
      ctaText: '如果你正在評估 AI 平台、Agent 工作流或企業 RAG 專案，我可以協助你把 PoC 推進成團隊真的能用、能維運、能擴展的系統。',
      ctaButton: '開始聊聊',
      mascotLabel: 'Bloss0m 導覽員',
      mascotName: '花花陪你一起整理',
      mascotLine: '花花正在整理 Agent、RAG 與 AI Engineering 的實戰筆記，把複雜技術變成能落地的系統。',
      mascotAlt: 'Bloss0m 三花貓吉祥物花花，身旁有花朵與星星',
      kickerSignals: '重點 · Focus',
      kickerShowcase: '專案 · Projects',
      kickerBlog: '觀點 · Writing',
      kickerPaper: '精讀 · Papers',
      kickerLab: '實驗 · Lab',
      kickerStickers: '貼圖 · LINE',
      exploreTitle: '花花的創意實驗室',
      exploreKicker: '花花 · Lab',
      startHereTitle: '第一次來？從這裡開始',
      startHerePaths: [
        { label: '我想了解 AI Agent → 實戰指南', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), image: '/brand/start-here/agent.webp' },
        { label: '我想建立企業 RAG → 架構與案例', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), image: '/brand/start-here/rag.webp' },
        { label: '我想把 AI PoC 上線 → 工程實作', href: toLocalizedPath('/blog/?lane=engineering', lang), image: '/brand/start-here/engineering.webp' },
        { label: '我想追蹤 AI 工程趨勢 → 趨勢拆解', href: toLocalizedPath('/blog/?lane=pulse', lang), image: '/brand/start-here/trends.webp' },
      ],
      writingGuide: '不確定從哪讀？先從「精選入門」開始',
      authorKicker: '作者 · About',
      authorTitle: 'Justin 與花花',
      authorLead: 'Justin 將企業 AI 做成可驗證、可部署、可維運的系統；花花讓複雜技術更容易靠近。',
      authorPanelTitle: '技術深度，也有溫暖觀點',
      authorRole: 'AI Platform & Agentic AI Engineer',
      authorRoleBody: '從文件智能、企業 RAG 到 Agent 正式環境交付。',
      huahuaRole: 'Bloss0m 導覽員',
      huahuaRoleBody: '讓複雜內容更親近，也留下清楚的技術判斷。',
      authorTags: ['Enterprise AI', 'Agentic RAG', 'AI Platform'],
      authorAbout: '關於 Justin',
      authorContact: 'LinkedIn 聯絡',
    };
---

<Layout
  title={isEn ? "Bloss0m | Justin's AI Engineering Studio" : 'Bloss0m｜Justin 的 AI Engineering Studio'}
  description={pageDescription}
  lang={lang}
  bodyClass="page-home"
>
  <>
    <section id="hero" class="home-hero section-reveal home-scroll-anchor">
      <div class="home-hero-grid">
        <div class="home-hero-copy surface-raised">
          <p class="hero-eyebrow">{hero.eyebrow}</p>
          <h1 class="hero-title">{hero.title}</h1>
          <p class="hero-tagline">{hero.tagline}</p>
          <div class="btn-group hero-actions">
            <a href={hero.primaryHref} class="btn btn-primary">{hero.primaryCta}</a>
            <a href={hero.secondaryHref} class="btn btn-secondary">{hero.secondaryCta}</a>
          </div>
          <p class="hero-lead">{hero.lead}</p>
          <HomeStartHere title={hero.startHereTitle} paths={hero.startHerePaths} />
          <ul class="hero-proof-list">
            {hero.proof.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <HomeSectionNav lang={lang} />
        </div>

        <aside class="hero-spotlight hero-mascot surface-raised" aria-labelledby="hero-mascot-title">
          <p class="hero-spotlight-label">{hero.mascotLabel}</p>
          <div class="hero-spotlight-media hero-mascot-media surface-inset">
            <picture>
              <source media="(max-width: 640px)" srcset="/brand/bloom-mark-128.webp" />
              <img
                src="/brand/bloom-hero.webp"
                alt={hero.mascotAlt}
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div class="hero-spotlight-body hero-mascot-body">
            <h2 id="hero-mascot-title">{hero.mascotName}</h2>
            <p class="hero-mascot-line">{hero.mascotLine}</p>
          </div>
        </aside>
      </div>
    </section>

    <HomeTrustBar
      label={isEn ? 'Bloss0m by the numbers' : 'Bloss0m 公開成果'}
      items={trustItems}
    />

    <blockquote id="quote" class="home-pull-quote section-reveal home-scroll-anchor">
      <p>{hero.pullQuote}</p>
    </blockquote>

    <section id="focus" class="section-reveal home-signals home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerSignals} title={hero.signalTitle} index="01" />
      <div class="pillars tile-grid surface-inset home-section-body">
        {hero.signals.map((signal, index) => (
          <article class="pillar-card pillar-card-strong">
            <span class="pillar-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{signal.title}</h3>
            <p>{signal.body}</p>
            <a class="section-cta" href={signal.href}>{signal.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <HomeRoadmap lang={lang} />

    <section id="showcase" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerShowcase} title={hero.showcaseTitle} index="03" />
      <div class="showcase surface-inset home-section-body">
        {projects.map((entry) => (
          <HomeCaseStudy
            entry={entry}
            lang={lang}
            detail={homeCaseStudyDetails[lang][baseSlug(entry) as HomeCaseStudySlug]}
          />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <HomeJourney lang={lang} />

    <section id="writing" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading
        kicker={isEn ? BLOG_WRITING_SECTION_COPY.kicker.en : BLOG_WRITING_SECTION_COPY.kicker.zh}
        title={isEn ? BLOG_WRITING_SECTION_COPY.title.en : BLOG_WRITING_SECTION_COPY.title.zh}
        index="05"
      />
      <SectionIntro lead={isEn ? BLOG_WRITING_SECTION_COPY.lead.en : BLOG_WRITING_SECTION_COPY.lead.zh} />

      <p class="home-writing-guide">{hero.writingGuide}</p>

      <div class="home-writing-tabs" id="home-writing-tabs">
        <div class="home-writing-tablist" role="tablist" aria-label={isEn ? 'Writing lanes' : '觀點分類'}>
          {writingLanes.map(({ id }, index) => (
            <button
              type="button"
              class:list={['home-writing-tab', { 'is-active': index === 0 }]}
              id={`writing-tab-${id}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`writing-${id}`}
              data-lane={id}
            >
              {isEn ? BLOG_LANE_COPY[id].title.en : BLOG_LANE_COPY[id].title.zh}
            </button>
          ))}
        </div>

        <div class="home-writing-panels surface-inset home-section-body">
          {writingLanes.map(({ id, preview }, index) => (
            <HomeWritingLane
              laneId={id}
              lang={lang}
              featured={preview.featured}
              compact={preview.compact}
              active={index === 0}
            />
          ))}
        </div>
      </div>

      <p class="text-center-mt">
        <a href={toLocalizedPath('/blog/', lang)} class="btn btn-secondary">
          {isEn ? BLOG_WRITING_SECTION_COPY.topCta.en : BLOG_WRITING_SECTION_COPY.topCta.zh}
        </a>
      </p>
    </section>

    <section id="author" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.authorKicker} title={hero.authorTitle} index="06" />
      <div class="home-explore-grid tile-grid surface-inset home-section-body">
        <article class="home-explore-panel">
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.authorTitle}</h3>
            <p class="home-explore-panel-desc">{hero.authorLead}</p>
          </div>
          <ul class="post-tags" aria-label={isEn ? 'Expertise' : '專業領域'}>
            {hero.authorTags.map((tag) => (
              <li><span class="tag-pill">{tag}</span></li>
            ))}
          </ul>
          <p class="home-explore-actions">
            <a href={toLocalizedPath('/contact/', lang)} class="btn btn-primary">{hero.authorAbout}</a>
            <a href="https://github.com/poirotw66" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/wei-cyun-chang-23a882219/" class="btn btn-secondary" target="_blank" rel="noopener">{hero.authorContact}</a>
          </p>
        </article>

        <aside class="home-explore-panel home-explore-panel--lab" aria-label={hero.authorPanelTitle}>
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.authorPanelTitle}</h3>
          </div>
          <div class="home-explore-cards">
            <article class="pillar-card pillar-card-strong">
              <p class="hero-spotlight-label">Engineer</p>
              <h3>Justin</h3>
              <p><strong>{hero.authorRole}</strong></p>
              <p>{hero.authorRoleBody}</p>
            </article>
            <article class="pillar-card pillar-card-strong">
              <img src="/brand/bloom-mark-128.webp" alt="" width="60" height="60" class="home-start-here-icon" loading="lazy" decoding="async" />
              <h3>{isEn ? 'Huahua' : '花花'}</h3>
              <p><strong>{hero.huahuaRole}</strong></p>
              <p>{hero.huahuaRoleBody}</p>
            </article>
          </div>
        </aside>
      </div>
    </section>

    <section id="papers" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerPaper} title={hero.paperTitle} index="07" />
      <div class="blog-preview surface-inset home-section-body">
        {paperReadings.map((entry) => (
          <PaperPreviewItem entry={entry} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/paper-reading/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="explore" class="section-reveal home-scroll-anchor home-explore home-section-shell surface-raised">
      <SectionHeading kicker={hero.exploreKicker} title={hero.exploreTitle} index="08" />
      <div class="home-explore-grid tile-grid surface-inset home-section-body">
        <div class="home-explore-panel home-explore-panel--lab">
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.labTitle}</h3>
            <p class="home-explore-panel-desc">{hero.labSubtitle}</p>
          </div>
          {labPreview.length > 0 && (
            <div class="home-explore-cards">
              {labPreview.map((entry) => (
                <ProjectCard entry={entry} lang={lang} />
              ))}
            </div>
          )}
          <p class="home-explore-actions">
            <a href={toLocalizedPath('/lab/#competition', lang)} class="btn btn-secondary">
              {isEn ? 'Competitions' : '競賽專區'}
            </a>
            <a href={toLocalizedPath('/lab/', lang)} class="btn btn-secondary">
              {isEn ? "Enter Huahua's Lab" : '進入花花實驗室'}
            </a>
          </p>
        </div>
        <div class="home-explore-panel home-explore-panel--stickers">
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.stickerTitle}</h3>
            <p class="home-explore-panel-desc">{hero.stickerSubtitle}</p>
          </div>
          {stickerPreview.length > 0 && (
            <div class="home-explore-cards">
              {stickerPreview.map((entry) => (
                <StickerCard
                  entry={entry}
                  lang={lang}
                  lineStoreLabel={isEn ? 'LINE Store' : '貼圖小舖'}
                  exploreLayout
                  showStoreLink={false}
                />
              ))}
            </div>
          )}
          <p class="home-explore-actions">
            <a href={toLocalizedPath('/stickers/', lang)} class="btn btn-secondary">{hero.stickerLink}</a>
            <a href={toLocalizedPath('/stickers/tools/', lang)} class="btn btn-secondary">{hero.stickerTools}</a>
          </p>
        </div>
      </div>
    </section>

