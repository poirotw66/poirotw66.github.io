---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import { blogSlug } from '../utils/blogLocale';
import { HOME_READER_PICKS } from '../data/homeBrand';

interface Props { posts: CollectionEntry<'blog'>[]; lang: Lang; }
const { posts, lang } = Astro.props;
const isEn = lang === 'en';
const bySlug = new Map(posts.map((post) => [blogSlug(post), post]));
const picks = HOME_READER_PICKS.flatMap((pick) => {
  const post = bySlug.get(pick.slug);
  return post ? [{ ...pick, post }] : [];
});
---

<section id="start-here" class="home-reader-picks section-reveal home-scroll-anchor home-editorial-section" aria-labelledby="reader-picks-title">
  <div class="reader-picks-intro">
    <h2 id="reader-picks-title">{isEn ? 'New here? Start with these.' : '第一次來，推薦從這裡讀。'}</h2>
    <p>{isEn ? 'Two guides for the foundations, then a hands-on account of putting a tool to work.' : '兩篇指南建立全貌，再看一篇把工具用起來的實作紀錄。'}</p>
    <a href={toLocalizedPath('/paper-reading/', lang)}>{isEn ? 'Looking for paper readings? →' : '想直接讀論文精讀？→'}</a>
  </div>
  <ol class="reader-picks-list">
    {picks.map(({ post, reason }) => (
      <li>
        <a href={toLocalizedPath(`/blog/${blogSlug(post)}/`, lang)}>
          <h3>{post.data.displayTitle ?? post.data.title}</h3>
          <p>{reason[lang]}</p>
          <span class="reader-picks-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .home-reader-picks { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 5vw, 4rem); }
  .reader-picks-intro h2 { margin: 0; font: 700 clamp(1.5rem, 2.8vw, 2.25rem) / 1.3 var(--font-heading); letter-spacing: -0.025em; text-wrap: balance; }
  .reader-picks-intro p { margin: 1rem 0; max-width: 35ch; color: var(--text-muted); line-height: 1.8; }
  .reader-picks-intro a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); text-underline-offset: 0.2em; }
  .reader-picks-list { margin: 0; padding: 0; list-style: none; }
  .reader-picks-list li + li { border-top: 1px solid var(--border); }
  .reader-picks-list a { position: relative; display: block; padding: 1.25rem 2rem 1.25rem 0; text-decoration: none; color: var(--text); }
  .reader-picks-list li:first-child a { padding-top: 0; }
  .reader-picks-list h3 { margin: 0; font: 600 clamp(1.125rem, 1.7vw, 1.375rem) / 1.5 var(--font-heading); }
  .reader-picks-list p { margin: 0.5rem 0 0; color: var(--text-muted); font-size: 1rem; line-height: 1.75; }
  .reader-picks-arrow { position: absolute; top: 1.25rem; right: 0; color: var(--accent); }
  .reader-picks-list li:first-child .reader-picks-arrow { top: 0; }
  .reader-picks-list a:hover h3 { color: var(--accent); }
  .home-reader-picks a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: var(--radius-sm); }
  @media (max-width: 640px) { .home-reader-picks { grid-template-columns: 1fr; } .reader-picks-intro p { max-width: none; } }
</style>
