---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaNav from '../../components/CtaNav.astro';
import Footer from '../../components/Footer.astro';

const allProjects = sortByPubDate(await getCollection('projects'));
---

<Layout
  title="Projects | Bloss0m"
  description="Selected projects: Agentic AI, Enterprise RAG, Realtime Voice AI, OCR Automation. AI platform and agent design."
>
  <div class="block-en">
    <PageHeader title="Projects" subtitle="AI platform · Agent design · RAG · Realtime AI" />

    <section class="section-spacer">
      <div class="showcase">
        {allProjects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="View project" />
        ))}
      </div>
    </section>

    <CtaNav backLabel="← Home" backHref="/#showcase" primaryLabel="Contact" primaryHref="/contact/" />

    <Footer text="AI Platform & Agentic AI Engineer" />
  </div>

  <div class="block-zh">
    <PageHeader title="專案" subtitle="AI 平台 · Agent 設計 · RAG · 即時 AI" />

    <section class="section-spacer">
      <div class="showcase">
        {allProjects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="看專案" />
        ))}
      </div>
    </section>

    <CtaNav backLabel="← 回首頁" backHref="/#showcase" primaryLabel="聯絡" primaryHref="/contact/" />

    <Footer text="AI 平台與 Agentic AI 工程師" />
  </div>
</Layout>
