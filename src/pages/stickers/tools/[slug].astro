---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import StickerToolPostContent from '../../../components/pages/StickerToolPostContent.astro';

export async function getStaticPaths() {
  const tools = await getCollection('stickerTools');
  return tools.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'stickerTools'> };
---
<StickerToolPostContent lang="zh" entry={entry} />

