{
  "name": "poirotw66.github.io",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:tags": "node --experimental-strip-types scripts/validate-tags.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:reading-quality": "node scripts/validate-reading-quality.mjs",
    "check:i18n": "node scripts/validate-i18n.mjs",
    "test:tags": "node --test --experimental-strip-types scripts/validate-tags.test.mjs",
    "test:content": "node --test scripts/validate-content.test.mjs",
    "test:reading-quality": "node --test scripts/validate-reading-quality.test.mjs",
    "test:i18n": "node --test scripts/validate-i18n.test.mjs",
    "test:toc": "node --test scripts/article-toc-scroll.test.mjs",
    "test:huahua-callout": "node --test scripts/remark-huahua-callout.test.mjs",
    "build": "npm run check:tags && npm run check:content && npm run check:reading-quality && npm run check:i18n && astro build && npm run optimize:build-css && npm run check:performance-assets",
    "preview": "astro preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "migrate:blog-covers": "node scripts/migrate-blog-covers.mjs",
    "optimize:js": "node scripts/minify-js.mjs",
    "analyze:css": "node scripts/analyze-css.mjs",
    "optimize:build-css": "node scripts/optimize-build-css.mjs",
    "check:performance-assets": "node scripts/check-performance-assets.mjs",
    "test:performance": "npm run test:performance:desktop && npm run test:performance:mobile",
    "test:performance:desktop": "lhci autorun --config=./lighthouserc.cjs",
    "test:performance:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "optimize:all": "npm run optimize:images && npm run optimize:js",
    "cleanup:images:preview": "node scripts/cleanup-original-images.mjs",
    "replace:image-refs:preview": "node scripts/replace-image-refs.mjs",
    "compress:pdf": "./scripts/compress-pdf.sh",
    "compress:all-pdfs": "./scripts/compress-all-pdfs.sh",
    "lfs:status": "git lfs status",
    "lfs:ls": "git lfs ls-files -s"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "lightningcss": "^1.32.0",
    "sharp": "^0.33.5",
    "terser": "^5.36.0"
  },
  "overrides": {
    "postcss-url": {
      "minimatch": "^9.0.5"
    }
  }
}
