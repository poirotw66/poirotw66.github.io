---
import { getAlternatePath, getHtmlLang, toLocalizedPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  /** Optional OG image URL (absolute). Defaults to site + /og.webp */
  imageURL?: string;
  /** 'website' | 'article'. Use 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** For article: ISO date string. Enables og:article:published_time */
  articlePublishedTime?: string;
  /** For article: ISO date string. Enables og:article:modified_time */
  articleModifiedTime?: string;
  /** For article: author name. Enables og:article:author */
  articleAuthor?: string;
  lang: Lang;
}

const { title, description = 'Bloss0m — AI 平台與 Agentic AI 工程：企業級 RAG、多代理協作、即時 AI 系統。專案含投影片轉影片、LINE 貼圖、BloomRender、語音助理等；部落格分享 Generative AI、評估與實作經驗。', canonicalURL, imageURL, ogType = 'website', articlePublishedTime, articleModifiedTime, articleAuthor, lang } = Astro.props;
const site = Astro.site ?? new URL('https://poirotw66.github.io');
const canonical = canonicalURL ?? new URL(toLocalizedPath(Astro.url.pathname, lang), site);
const ogImage = imageURL ?? new URL('/og.webp', site).toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const siteUrl = site.toString().replace(/\/$/, '');
const t = useTranslations(lang);
const localizedPath = toLocalizedPath(Astro.url.pathname, lang);
const zhPath = toLocalizedPath(Astro.url.pathname, 'zh');
const enPath = toLocalizedPath(Astro.url.pathname, 'en');
const langToggleHref = getAlternatePath(Astro.url.pathname, lang);

const primaryNavLinks = [
  { href: '/projects/', key: 'nav.projects' },
  { href: '/blog/', key: 'nav.blog' },
  { href: '/paper-reading/', key: 'nav.paperReading' },
  { href: '/search/', key: 'nav.search' },
  { href: '/contact/', key: 'nav.contact' },
] as const;

const footerNavLinks = [
  { href: '/lab/', key: 'nav.lab' },
  { href: '/stickers/', key: 'nav.stickers' },
] as const;
---

<!DOCTYPE html>
<html lang={getHtmlLang(lang)} data-theme="warm">
  <head>
    <!-- Google tag (gtag.js) -->
    <script defer src="https://www.googletagmanager.com/gtag/js?id=G-FKETRDJWMH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FKETRDJWMH');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bloss0m — AI Platform & Agentic AI Engineer" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_Hant' : 'en_US'} />
    <meta property="og:site_name" content="Bloss0m" />
    {ogType === 'article' && articlePublishedTime && <meta property="og:article:published_time" content={articlePublishedTime} />}
    {ogType === 'article' && articleModifiedTime && <meta property="og:article:modified_time" content={articleModifiedTime} />}
    {ogType === 'article' && articleAuthor && <meta property="og:article:author" content={articleAuthor} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="zh-Hant" href={`${siteUrl}${zhPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${zhPath}`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: 'Bloss0m',
          description: 'Bloss0m — AI 平台與 Agentic AI 工程：企業級 RAG、多代理協作、即時 AI 系統。部落格分享 Generative AI、評估與實作經驗。',
          publisher: { '@id': `${siteUrl}/#organization` },
          inLanguage: getHtmlLang(lang),
        },
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: 'Bloss0m',
          url: siteUrl,
          logo: { '@type': 'ImageObject', url: new URL('/favicon.png', site).toString() },
        },
      ],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=optional" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skipToMain')}</a>
    <nav class="nav" aria-label={t('nav.landmark')}>
      <div class="nav-inner">
        <a href={toLocalizedPath('/', lang)} class="nav-logo">Bloss0m</a>
        <div class="nav-right">
          <div class="theme-switcher" role="group" aria-label="Theme">
            <button type="button" data-theme-btn="dark" aria-pressed="false" class="theme-btn">{t('theme.dark')}</button>
            <button type="button" data-theme-btn="warm" aria-pressed="true" class="theme-btn theme-btn-active">{t('theme.warm')}</button>
          </div>
          <div class="lang-switcher">
            <a href={lang === 'zh' ? langToggleHref : localizedPath} aria-label={t('lang.enLabel')} aria-current={lang === 'en' ? 'page' : undefined}>{t('lang.enShort')}</a>
            <a href={lang === 'en' ? langToggleHref : localizedPath} aria-label={t('lang.zhLabel')} aria-current={lang === 'zh' ? 'page' : undefined}>{t('lang.zhShort')}</a>
          </div>
        </div>
        <button
          type="button"
          class="nav-menu-toggle"
          aria-expanded="false"
          aria-controls="primary-nav-menu"
          aria-label={t('nav.menuButton')}
        >
          <span class="nav-menu-toggle-bars" aria-hidden="true"></span>
        </button>
        <div id="primary-nav-menu" class="nav-menu-panel">
          <ul class="nav-links">
            {primaryNavLinks.map(({ href, key }) => {
              const hrefNorm = href === '/' ? '/' : href.replace(/\/$/, '');
              const isCurrent = localizedPath.replace(/\/$/, '') === hrefNorm || (hrefNorm !== '/' && localizedPath.startsWith(hrefNorm));
              return (
                <li>
                  <a href={toLocalizedPath(href, lang)} aria-current={isCurrent ? 'page' : undefined}>{t(key)}</a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </nav>
    <main id="main" class="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="site-footer-brand">Bloss0m</p>
        <nav class="site-footer-nav" aria-label={t('footer.secondaryNav')}>
          <ul class="site-footer-links">
            {footerNavLinks.map(({ href, key }) => (
              <li>
                <a href={toLocalizedPath(href, lang)}>{t(key)}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="site-footer-note">{t('footer.note')}</p>
      </div>
    </footer>
    <script is:inline src="/js/theme.js" defer></script>
    <script is:inline src="/js/pdf-viewer-init.js" defer></script>
    <script is:inline src="/js/youtube-facade.js" defer></script>
  </body>
</html>
