---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import StickerToolPostContent from '../../../../components/pages/StickerToolPostContent.astro';
import { resolveEntriesForLang, baseSlug } from '../../../../utils/contentLocale';

export async function getStaticPaths() {
  const tools = resolveEntriesForLang(await getCollection('stickerTools'), 'en');
  return tools.map((entry) => ({
    params: { slug: baseSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'stickerTools'> };
---

<StickerToolPostContent lang="en" entry={entry} />
