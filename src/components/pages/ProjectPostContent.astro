---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import ArticleToc from '../article/ArticleToc.astro';
import { toLocalizedPath, useTranslations } from '../../i18n/utils';
import { formatPublishedDate, toDate } from '../../utils/formatPublishedDate';
import { projectTierLabel } from '../../utils/projectTierLabel';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const { Content, headings } = await render(entry);
const hasMermaid = entry.body.includes('```mermaid');
const t = useTranslations(lang);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length > 0;
const site = Astro.site ?? new URL('https://www.bloss0m.com');
const canonicalUrl = new URL(toLocalizedPath(`/projects/${entry.id}/`, lang), site).toString();
const pubDateObj = toDate(entry.data.pubDate);
const pubIso = pubDateObj.toISOString();

const tierLine = projectTierLabel(entry.data.tier, lang);
const isLabTier = entry.data.tier === 'lab';
const listParentPath = toLocalizedPath(isLabTier ? '/lab/' : '/projects/', lang);
const listParentLabel = isLabTier
  ? lang === 'en'
    ? 'Lab'
    : '實驗室'
  : lang === 'en'
    ? 'Projects'
    : '專案';
const listParentUrl = new URL(listParentPath, site).toString();
---

<Layout
  title={`${entry.data.title} | Bloss0m`}
  description={entry.data.description}
  canonicalURL={new URL(toLocalizedPath(`/projects/${entry.id}/`, lang), site)}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: entry.data.title,
      description: entry.data.description,
      datePublished: pubIso,
      author: { '@type': 'Person', name: 'Bloss0m' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: listParentLabel, item: listParentUrl },
        { '@type': 'ListItem', position: 2, name: entry.data.title, item: canonicalUrl },
      ],
    })} />
  </Fragment>
  <div class="content-region project-detail-page">
    <header class="page-header">
      <div class="page-header-inner">
        <h1>{entry.data.title}</h1>
        {entry.data.subtitle && <p>{entry.data.subtitle}</p>}
        <p class="article-meta page-header-meta">
          <span>{tierLine}</span>
          <span class="article-meta-sep" aria-hidden="true"> · </span>
          <time datetime={pubIso}>{formatPublishedDate(pubDateObj, lang)}</time>
        </p>
        {entry.data.repoUrl && (
          <p class="mt-half">
            <a href={entry.data.repoUrl} target="_blank" rel="noopener">
              {lang === 'en' ? 'View on GitHub →' : '於 GitHub 檢視 →'}
            </a>
          </p>
        )}
      </div>
    </header>

    <section class="proj-detail-section section-spacer">
      <div class="article-body proj-detail-body">
        <a href={listParentPath} class="back">← {listParentLabel}</a>
        {showToc && <ArticleToc headings={tocHeadings} label={t('blog.tocTitle')} />}
        <Content />
      </div>
      {hasMermaid && <script type="module" src="/js/mermaid.js"></script>}
      {entry.data.metrics && entry.data.metrics.length > 0 && (
        <div class="proj-metrics mt-section">
          {entry.data.metrics.map((m) => (
            <span>{m}</span>
          ))}
        </div>
      )}
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<style>
  .proj-detail-body {
    min-width: 0;
  }
  .proj-detail-body h2 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
    scroll-margin-top: 1.25rem;
  }
  .proj-detail-body h2:first-child {
    margin-top: 0;
  }
  .proj-detail-body p,
  .proj-detail-body ul {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .proj-detail-body ul {
    padding-left: 1.5rem;
  }
  .proj-detail-body pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 1rem 0;
  }
  .proj-detail-body code {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--surface);
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .proj-detail-body pre code {
    padding: 0;
    background: none;
    border: none;
  }
  .proj-detail-body .mermaid {
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: visible;
    text-align: center;
    padding: 0.25rem 0;
    -webkit-overflow-scrolling: touch;
  }
  .proj-detail-body .mermaid svg {
    display: block;
    max-width: none;
    height: auto;
  }
</style>
