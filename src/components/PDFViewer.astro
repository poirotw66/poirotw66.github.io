---
/**
 * PDFViewer Component
 * 功能完整的 PDF 檢視器元件,使用 PDF.js
 * 
 * @param src - PDF 檔案路徑 (本地或遠端 URL)
 * @param title - PDF 標題 (用於無障礙和下載)
 * @param height - 檢視器高度 (預設: 800px)
 * @param initialScale - 初始縮放模式 ('page-width' | 'page-fit' | number)
 * @param minScale - 最小縮放比例 (預設: 0.5)
 * @param maxScale - 最大縮放比例 (預設: 2.0)
 * @param showToolbar - 是否顯示工具列 (預設: true)
 * @param allowDownload - 是否允許下載 (預設: true)
 * @param allowFullscreen - 是否允許全螢幕 (預設: true)
 */

interface Props {
  src: string;
  title?: string;
  height?: string;
  initialScale?: 'page-width' | 'page-fit' | number;
  minScale?: number;
  maxScale?: number;
  showToolbar?: boolean;
  allowDownload?: boolean;
  allowFullscreen?: boolean;
}

const {
  src,
  title = 'PDF Document',
  height = '800px',
  initialScale = 'page-width',
  minScale = 0.5,
  maxScale = 2.0,
  showToolbar = true,
  allowDownload = true,
  allowFullscreen = true,
} = Astro.props;

// 生成唯一 ID
const viewerId = `pdf-viewer-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="pdf-viewer-container" style={`height: ${height}`}>
  <div class="pdf-viewer" id={viewerId}>
    
    {showToolbar && (
      <div class="pdf-toolbar" role="toolbar" aria-label="PDF 控制工具列">
        <!-- 頁面導航 -->
        <div class="pdf-toolbar-group pdf-page-nav">
          <button 
            type="button"
            class="pdf-prev" 
            aria-label="上一頁"
            title="上一頁 (←)"
          >
            <span>上一頁</span>
          </button>
          
          <div class="pdf-page-info" role="status" aria-live="polite">
            <input 
              type="number" 
              class="pdf-page-input" 
              min="1"
              aria-label="當前頁碼"
              title="輸入頁碼並按 Enter"
            />
            <span>/</span>
            <span class="pdf-total-pages" aria-label="總頁數">0</span>
          </div>
          
          <button 
            type="button"
            class="pdf-next" 
            aria-label="下一頁"
            title="下一頁 (→)"
          >
            <span>下一頁</span>
          </button>
        </div>

        <!-- 縮放控制 -->
        <div class="pdf-toolbar-group pdf-zoom-controls">
          <button 
            type="button"
            class="pdf-zoom-out" 
            aria-label="縮小"
            title="縮小 (-)"
          >
            <span>縮小</span>
          </button>
          
          <button 
            type="button"
            class="pdf-zoom-in" 
            aria-label="放大"
            title="放大 (+)"
          >
            <span>放大</span>
          </button>
          
          <button 
            type="button"
            class="pdf-fit-width" 
            aria-label="適應寬度"
            title="適應寬度"
          >
            <span>適應寬度</span>
          </button>
          
          <button 
            type="button"
            class="pdf-fit-page" 
            aria-label="適應頁面"
            title="適應頁面"
          >
            <span>適應頁面</span>
          </button>
        </div>

        <!-- 其他功能 -->
        <div class="pdf-toolbar-group">
          {allowFullscreen && (
            <button 
              type="button"
              class="pdf-fullscreen" 
              aria-label="全螢幕"
              title="全螢幕 (F)"
            >
              <span>全螢幕</span>
            </button>
          )}
          
          {allowDownload && (
            <button 
              type="button"
              class="pdf-download" 
              aria-label="下載 PDF"
              title="下載 PDF"
            >
              <span>下載</span>
            </button>
          )}
        </div>
      </div>
    )}

    <!-- Canvas 容器 -->
    <div class="pdf-canvas-container" role="main" aria-label={`${title} 內容`}>
      <canvas 
        class="pdf-canvas" 
        aria-label={title}
      ></canvas>
      
      <!-- 載入狀態 -->
      <div class="pdf-loading" role="status" aria-live="polite">
        <div class="pdf-loading-spinner" aria-hidden="true"></div>
        <div class="pdf-loading-text">載入 PDF 中...</div>
      </div>
      
      <!-- 錯誤訊息 -->
      <div class="pdf-error" role="alert" aria-live="assertive"></div>
    </div>

  </div>
</div>

<!-- 載入 PDF.js 函式庫 -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<!-- 載入 PDF 檢視器樣式 -->
<link rel="stylesheet" href="/css/pdf-viewer.css" />

<!-- 初始化 PDF 檢視器 -->
<script is:inline define:vars={{ viewerId, src, initialScale, minScale, maxScale, title }}>
  // 等待 DOM 和 PDF.js 載入完成
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViewer);
  } else {
    initViewer();
  }

  function initViewer() {
    // 確保 PDF.js 和控制器已載入
    const checkReady = setInterval(() => {
      if (window['pdfjs-dist/build/pdf'] && window.initPDFViewer) {
        clearInterval(checkReady);
        
        // 載入控制器腳本
        const script = document.createElement('script');
        script.src = '/js/pdf-viewer.js';
        script.onload = () => {
          // 初始化 PDF 檢視器
          window.initPDFViewer(viewerId, src, {
            initialScale: initialScale,
            minScale: minScale,
            maxScale: maxScale,
            title: title
          });
        };
        document.head.appendChild(script);
      }
    }, 100);

    // 超時保護 (10秒)
    setTimeout(() => {
      clearInterval(checkReady);
      const container = document.getElementById(viewerId);
      if (container) {
        const loading = container.querySelector('.pdf-loading');
        const error = container.querySelector('.pdf-error');
        if (loading) loading.style.display = 'none';
        if (error) {
          error.textContent = '載入 PDF 檢視器失敗。請重新整理頁面。';
          error.style.display = 'block';
        }
      }
    }, 10000);
  }
</script>

<!-- 鍵盤快捷鍵說明 (隱藏但可被螢幕閱讀器讀取) -->
<div class="sr-only" role="region" aria-label="鍵盤快捷鍵">
  <h3>PDF 檢視器鍵盤快捷鍵</h3>
  <ul>
    <li>左右方向鍵: 上一頁/下一頁</li>
    <li>加號/減號: 放大/縮小</li>
    <li>F 鍵: 切換全螢幕</li>
    <li>Home/End: 第一頁/最後一頁</li>
  </ul>
</div>

<style>
  /* 螢幕閱讀器專用內容 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>