---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { resolveEntriesForLang, baseSlug } from '../../utils/contentLocale';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const tools = resolveEntriesForLang(await getCollection('stickerTools'), lang).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout
  title={lang === 'en' ? 'AI Sticker Tools | Bloss0m' : 'AI 貼圖工具 | Bloss0m'}
  description={
    lang === 'en'
      ? 'Three open-source tools to help you ideate, generate, and pack LINE stickers with AI.'
      : '三個開源工具，協助你用 AI 從發想、生成到打包 LINE 貼圖。'
  }
  lang={lang}
>
  <div class="content-region">
    <PageHeader
      title={lang === 'en' ? 'AI Sticker Tools' : 'AI 貼圖工具'}
      subtitle={
        lang === 'en'
          ? 'Open-source tools to go from idea → sprite sheets → LINE-ready ZIP.'
          : '從靈感 → 精靈圖／動圖 → LINE 送審，一站式開源工具組。'
      }
    />

    <section class="section-spacer">
      <p class="article-meta">
        {lang === 'en' ? (
          <>
            These three tools form a complete flow: start with <strong>ideas</strong>, generate
            <strong>sprites and animations</strong>, then <strong>pack</strong> everything into a
            LINE Creators Market ZIP.
          </>
        ) : (
          <>
            這三個工具組成完整流程：先在 <strong>stickermind</strong> 想好主題與台詞，
            再用 <strong>Sprite-Animator</strong> 生成精靈圖與動圖，
            最後交給 <strong>LINE-Sticker-Packer</strong> 打包成符合官方規格的 ZIP。
          </>
        )}
      </p>

      <div class="tool-grid">
        {tools.map((entry) => (
          <article class="tool-card">
            <div class="tool-card-inner">
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              {entry.data.useCases && entry.data.useCases.length > 0 && (
                <ul class="tool-usecases">
                  {entry.data.useCases.map((u) => (
                    <li>{u}</li>
                  ))}
                </ul>
              )}
              <a href={toLocalizedPath(`/stickers/tools/${baseSlug(entry)}/`, lang)} class="btn btn-primary">
                {lang === 'en' ? 'View details →' : '看介紹 →'}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .tool-card-inner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tool-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0;
  }

  .tool-card p {
    color: var(--text-muted);
    margin: 0;
  }

  .tool-usecases {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--text-muted);
  }

  .tool-card .btn {
    align-self: flex-start;
  }
</style>
