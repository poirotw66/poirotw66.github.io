---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { sortByPubDate, getFeaturedProjects, getLabProjects } from '../../utils/sort';
import { toLocalizedPath } from '../../i18n/utils';
import ProjectCard from '../ProjectCard.astro';
import StickerCard from '../StickerCard.astro';
import BlogPreviewItem from '../BlogPreviewItem.astro';
import PaperPreviewItem from '../PaperPreviewItem.astro';
import CtaBlock from '../CtaBlock.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const posts = sortByPubDate(await getCollection('blog')).slice(0, 4);
const paperReadings = sortByPubDate(await getCollection('paperReading')).slice(0, 4);
const stickers = sortByPubDate(await getCollection('stickers')).slice(0, 4);
const projects = getFeaturedProjects(await getCollection('projects'));
const labProjects = getLabProjects(await getCollection('projects')).slice(0, 4);
const spotlightProject = projects.find((entry) => entry.id === 'agentic-rag') ?? projects[0];
const spotlightHref = spotlightProject ? toLocalizedPath(`/projects/${spotlightProject.id}/`, lang) : toLocalizedPath('/projects/', lang);
const isEn = lang === 'en';

const pageDescription =
  lang === 'en'
    ? 'Bloss0m — AI Platform & Agentic AI Engineering. Enterprise RAG, multi-agent systems, and real-time AI.'
    : 'Bloss0m — AI 平台與 Agentic AI 工程：企業級 RAG、多代理協作、即時 AI 系統。專案含投影片轉影片、LINE 貼圖、BloomRender、語音助理等；部落格分享 Generative AI、評估與實作經驗。';

const hero = isEn
  ? {
      eyebrow: 'AI Platform · Agentic AI Engineer',
      title: 'Ship AI systems that are ready for production, not just demo day.',
      tagline: 'Architecture, RAG, and agents — from prototype to something your team can run.',
      pullQuote:
        'Engineering you can verify in public repos and posts — systems designed for operators, not slide decks.',
      lead:
        'I help teams turn promising GenAI ideas into production-ready systems, from enterprise RAG and agent workflows to real-time and multimodal applications with clear architecture, measurable outcomes, and deployment readiness.',
      primaryCta: 'View case study',
      primaryHref: spotlightHref,
      secondaryCta: 'Discuss a project',
      secondaryHref: toLocalizedPath('/contact/', lang),
      proof: [
        'Experience building enterprise OCR and document intelligence systems',
        'RAG, agents, multimodal pipelines, and enterprise API integration',
        'From architecture design to deployment and operational handoff',
      ],
      signalTitle: 'Why teams work with me',
      signals: [
        { title: 'From PoC to production', body: 'I focus on the gap most teams struggle with: turning a working demo into a stable system with quality, latency, safety, and maintainability built in.' },
        { title: 'Built for real workflows', body: 'The work here is grounded in actual business scenarios such as knowledge assistants, document intelligence, reporting automation, and real-time user interaction.' },
        { title: 'Technical depth you can verify', body: 'Projects, technical writing, and architecture breakdowns make it easy to assess both implementation quality and engineering judgment before starting a collaboration.' },
      ],
      showcaseTitle: 'Featured Case Studies',
      showcaseLink: 'View all',
      blogTitle: 'Latest Insights',
      paperTitle: 'Paper Reading',
      labTitle: 'Creative Lab',
      stickerTitle: 'LINE Stickers',
      labLink: 'View all',
      stickerTools: 'Make your own (3 tools)',
      stickerLink: 'View all',
      ctaText: 'If you are evaluating an AI platform, agent workflow, or enterprise RAG initiative, I can help move it from prototype to a system your team can actually operate.',
      ctaButton: 'Start a conversation',
      spotlightLabel: 'Flagship Case',
      spotlightButton: 'Read case study',
      spotlightMetaLabel: 'Impact',
      kickerSignals: 'Focus',
      kickerShowcase: 'Projects',
      kickerBlog: 'Writing',
      kickerPaper: 'Papers',
      kickerLab: 'Lab',
      kickerStickers: 'Stickers',
    }
  : {
      eyebrow: 'AI 平台 · Agentic AI 工程師',
      title: 'AI 原型到商用規模',
      tagline: '從架構、RAG、Agent 到上線維運——把 demo 推成團隊真能用的系統。',
      pullQuote: '用公開的專案與文章讓技術深度可被驗證；設計上優先考慮維運與交付，而不是簡報規格。',
      lead:
        '我協助團隊把有潛力的 GenAI 構想落成可交付的產品與平台，涵蓋企業級 RAG、多代理工作流、即時與多模態 AI 應用，從架構、資料流程、API 到部署整合一路打通。',
      primaryCta: '看代表案例',
      primaryHref: spotlightHref,
      secondaryCta: '洽談合作',
      secondaryHref: toLocalizedPath('/contact/', lang),
      proof: [
        '具企業 OCR 與文件智能系統實務經驗',
        '聚焦 RAG、Agent、多模態流程與企業 API 整合',
        '從系統架構到部署交付，強調可維運、可擴展、可交接',
      ],
      signalTitle: '為什麼團隊會找我合作',
      signals: [
        { title: '擅長補上 PoC 到上線之間的落差', body: '不只做出可用 demo，而是把檢索品質、延遲、穩定性、安全性與維運一起納入系統設計。' },
        { title: '解的是實際業務場景', body: '這裡的案例聚焦在知識助手、文件智能、報告自動化與即時互動，不是只為了展示模型能力。' },
        { title: '技術深度看得到也驗證得到', body: '專案、文章與架構拆解一起公開，讓合作前就能判斷實作能力與工程判斷是否可靠。' },
      ],
      showcaseTitle: '代表案例與精選專案',
      showcaseLink: '看全部',
      blogTitle: '最新觀點與實作',
      paperTitle: '論文精讀',
      labTitle: '實驗室',
      stickerTitle: 'LINE 貼圖',
      labLink: '看全部',
      stickerTools: '用 3 個開源工具自己做貼圖',
      stickerLink: '看全部',
      ctaText: '如果你正在評估 AI 平台、Agent 工作流或企業 RAG 專案，我可以協助你把 PoC 推進成團隊真的能用、能維運、能擴展的系統。',
      ctaButton: '開始聊聊',
      spotlightLabel: '旗艦案例',
      spotlightButton: '閱讀案例',
      spotlightMetaLabel: '成效',
      kickerSignals: '重點 · Focus',
      kickerShowcase: '專案 · Projects',
      kickerBlog: '觀點 · Writing',
      kickerPaper: '精讀 · Papers',
      kickerLab: '實驗 · Lab',
      kickerStickers: '貼圖 · LINE',
    };
---

<Layout title="Bloss0m" description={pageDescription} lang={lang}>
  <>
    <section id="hero" class="home-hero section-reveal home-scroll-anchor">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="hero-eyebrow">{hero.eyebrow}</p>
          <h1 class="hero-title">{hero.title}</h1>
          <p class="hero-tagline">{hero.tagline}</p>
          <p class="hero-lead">{hero.lead}</p>
          <div class="btn-group hero-actions">
            <a href={hero.primaryHref} class="btn btn-primary">{hero.primaryCta}</a>
            <a href={hero.secondaryHref} class="btn btn-secondary">{hero.secondaryCta}</a>
          </div>
          <ul class="hero-proof-list">
            {hero.proof.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        {spotlightProject && (
          <aside class="hero-spotlight">
            <p class="hero-spotlight-label">{hero.spotlightLabel}</p>
            {spotlightProject.data.image && (
              <a href={spotlightHref} class="hero-spotlight-media">
                <Image
                  src={spotlightProject.data.image}
                  alt={spotlightProject.data.title}
                  width="640"
                  height="400"
                  format="webp"
                  quality={80}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </a>
            )}
            <div class="hero-spotlight-body">
              <h2>
                <a href={spotlightHref}>{spotlightProject.data.title}</a>
              </h2>
              {spotlightProject.data.subtitle && <p class="hero-spotlight-subtitle">{spotlightProject.data.subtitle}</p>}
              {spotlightProject.data.impact && (
                <p class="hero-spotlight-impact">
                  <span>{hero.spotlightMetaLabel}</span>
                  {spotlightProject.data.impact}
                </p>
              )}
              {spotlightProject.data.description && <p class="hero-spotlight-description">{spotlightProject.data.description}</p>}
              {spotlightProject.data.metrics && spotlightProject.data.metrics.length > 0 && (
                <div class="hero-metrics">
                  {spotlightProject.data.metrics.slice(0, 3).map((metric) => (
                    <span>{metric}</span>
                  ))}
                </div>
              )}
              <a href={spotlightHref} class="btn btn-secondary">{hero.spotlightButton}</a>
            </div>
          </aside>
        )}
      </div>
    </section>

    <blockquote id="quote" class="home-pull-quote section-reveal home-scroll-anchor">
      <p>{hero.pullQuote}</p>
    </blockquote>

    <section id="focus" class="section-reveal home-signals home-scroll-anchor">
      <SectionHeading kicker={hero.kickerSignals} title={hero.signalTitle} />
      <div class="pillars">
        {hero.signals.map((signal) => (
          <article class="pillar-card pillar-card-strong">
            <h3>{signal.title}</h3>
            <p>{signal.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="showcase" class="section-reveal home-scroll-anchor">
      <SectionHeading kicker={hero.kickerShowcase} title={hero.showcaseTitle} />
      <div class="showcase">
        {projects.map((entry) => (
          <ProjectCard entry={entry} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="writing" class="section-reveal home-scroll-anchor">
      <SectionHeading kicker={hero.kickerBlog} title={hero.blogTitle} />
      <div class="blog-preview">
        {posts.map((post) => (
          <BlogPreviewItem post={post} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/blog/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="papers" class="section-reveal home-scroll-anchor">
      <SectionHeading kicker={hero.kickerPaper} title={hero.paperTitle} />
      <div class="blog-preview">
        {paperReadings.map((entry) => (
          <PaperPreviewItem entry={entry} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/paper-reading/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="lab" class="section-reveal home-scroll-anchor">
      <SectionHeading kicker={hero.kickerLab} title={hero.labTitle} />
      <div class="showcase">
        {labProjects.map((entry) => (
          <ProjectCard entry={entry} lang={lang} />
        ))}
      </div>
      {labProjects.length > 0 && (
        <p class="text-center-mt">
          <a href={toLocalizedPath('/lab/', lang)} class="btn btn-secondary">{hero.labLink}</a>
        </p>
      )}
    </section>

    <section id="stickers" class="section-reveal home-scroll-anchor">
      <SectionHeading kicker={hero.kickerStickers} title={hero.stickerTitle} />
      <div class="sticker-grid">
        {stickers.map((entry) => (
          <StickerCard entry={entry} lang={lang} lineStoreLabel={isEn ? 'LINE Store' : '貼圖小舖'} buttonClass="btn-secondary" />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/stickers/tools/', lang)} class="btn btn-primary">{hero.stickerTools}</a>
      </p>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/stickers/', lang)} class="btn btn-secondary">{hero.stickerLink}</a>
      </p>
    </section>

    <CtaBlock id="cta" text={hero.ctaText} buttonText={hero.ctaButton} buttonHref={toLocalizedPath('/contact/', lang)} />
    <script src="/js/home-scroll-hash.js" defer></script>
  </>
</Layout>
