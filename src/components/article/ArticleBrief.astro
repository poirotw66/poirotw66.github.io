---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  tldr: readonly string[];
  audience: readonly string[];
  compactMobile?: boolean;
}

const { lang, tldr, audience, compactMobile = false } = Astro.props;
const copy = lang === 'en'
  ? {
      eyebrow: 'At a glance',
      title: 'TL;DR',
      audience: 'Who this is for',
    }
  : {
      eyebrow: '快速掌握',
      title: 'TL;DR',
      audience: '適合誰閱讀',
    };
---

<aside class="article-brief" aria-labelledby="article-brief-title">
  <div class="article-brief-summary">
    <p class="article-brief-eyebrow">{copy.eyebrow}</p>
    <h2 id="article-brief-title">{copy.title}</h2>
    <ul>
      {tldr.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  {compactMobile ? (
    <>
      <div class="article-brief-audience article-brief-audience--desktop">
        <h3>{copy.audience}</h3>
        <ul>
          {audience.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <details class="article-brief-audience article-brief-audience--mobile">
        <summary class="article-brief-audience-toggle">
          <span>{copy.audience}</span>
          <span class="article-brief-audience-chevron" aria-hidden="true"></span>
        </summary>
        <h3>{copy.audience}</h3>
        <ul>
          {audience.map((item) => <li>{item}</li>)}
        </ul>
      </details>
    </>
  ) : (
    <details class="article-brief-audience" open>
      <summary class="article-brief-audience-toggle">
        <span>{copy.audience}</span>
        <span class="article-brief-audience-chevron" aria-hidden="true"></span>
      </summary>
      <h3>{copy.audience}</h3>
      <ul>
        {audience.map((item) => <li>{item}</li>)}
      </ul>
    </details>
  )}
</aside>

{!compactMobile && <script>
  const audienceQuery = window.matchMedia('(max-width: 640px)');

  const syncAudienceDisclosure = ({ matches }: MediaQueryList | MediaQueryListEvent) => {
    document.querySelectorAll<HTMLDetailsElement>('.article-brief-audience').forEach((disclosure) => {
      disclosure.open = !matches;
    });
  };

  syncAudienceDisclosure(audienceQuery);
  audienceQuery.addEventListener('change', syncAudienceDisclosure);
</script>}
