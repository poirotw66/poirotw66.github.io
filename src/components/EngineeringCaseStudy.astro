---
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import type { EngineeringCaseStudy } from '../data/engineeringCaseStudies';

interface Props {
  lang: Lang;
  study: EngineeringCaseStudy;
}

const { lang, study } = Astro.props;
const isEn = lang === 'en';
const labels = isEn
  ? {
      overview: 'Engineering case study',
      context: 'Problem & constraints',
      design: 'Architecture & decisions',
      architecture: 'System flow',
      decisions: 'Technology decisions',
      role: 'My contribution',
      evaluation: 'Evaluation & outcomes',
      failures: 'Failures & corrections',
      evidence: 'Evidence & further reading',
      problem: 'Problem',
      constraints: 'Constraints',
      symptom: 'Failure',
      correction: 'Correction',
      lesson: 'Lesson',
      disclosure: 'Disclosure',
      linkKinds: {
        repository: 'Repository',
        article: 'Article',
        speaking: 'Speaking',
        documentation: 'Documentation',
      },
    }
  : {
      overview: '工程案例',
      context: '問題與限制',
      design: '架構與技術決策',
      architecture: '系統流程',
      decisions: '技術選型',
      role: '我的具體責任',
      evaluation: '評測方式與成果',
      failures: '失敗與修正',
      evidence: '證據與延伸資料',
      problem: '問題',
      constraints: '限制',
      symptom: '失敗現象',
      correction: '修正方式',
      lesson: '工程教訓',
      disclosure: '揭露說明',
      linkKinds: {
        repository: 'Repository',
        article: '文章',
        speaking: '演講',
        documentation: '技術文件',
      },
    };

const resolveHref = (href: string, external = false): string => {
  if (external || href.startsWith('#')) return href;
  return toLocalizedPath(href, lang);
};
---

<section class="engineering-case" aria-labelledby="engineering-case-title">
  <header class="engineering-case-intro">
    <p class="case-eyebrow">{study.eyebrow}</p>
    <div>
      <h2 id="engineering-case-title">{labels.overview}</h2>
      <p>{study.summary}</p>
    </div>
  </header>

  <section id="case-context" class="case-section" aria-labelledby="case-context-title">
    <header class="case-section-heading">
      <span>01</span>
      <h3 id="case-context-title">{labels.context}</h3>
    </header>
    <div class="case-section-body case-context">
      <div>
        <p class="case-label">{labels.problem}</p>
        <p class="case-lead">{study.problem}</p>
      </div>
      <div>
        <p class="case-label">{labels.constraints}</p>
        <ul class="case-list">
          {study.constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="case-design" class="case-section" aria-labelledby="case-design-title">
    <header class="case-section-heading">
      <span>02</span>
      <h3 id="case-design-title">{labels.design}</h3>
    </header>
    <div class="case-section-body">
      <p class="case-label">{labels.architecture}</p>
      <ol class="case-architecture" aria-label={labels.architecture}>
        {study.architecture.map((node) => (
          <li>
            <span>{node.step}</span>
            <strong>{node.title}</strong>
            <small>{node.detail}</small>
          </li>
        ))}
      </ol>

      <p class="case-label case-subheading">{labels.decisions}</p>
      <div class="case-decisions">
        {study.decisions.map((decision) => (
          <article>
            <h4>{decision.technology}</h4>
            <p>{decision.reason}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="case-role" class="case-section" aria-labelledby="case-role-title">
    <header class="case-section-heading">
      <span>03</span>
      <h3 id="case-role-title">{labels.role}</h3>
    </header>
    <div class="case-section-body">
      <ol class="case-responsibilities">
        {study.responsibilities.map((responsibility, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{responsibility}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="case-evaluation" class="case-section" aria-labelledby="case-evaluation-title">
    <header class="case-section-heading">
      <span>04</span>
      <h3 id="case-evaluation-title">{labels.evaluation}</h3>
    </header>
    <div class="case-section-body">
      <p class="case-lead case-method">{study.evaluationMethod}</p>
      <div class="case-metrics">
        {study.metrics.map((metric) => (
          <article>
            <strong>{metric.value}</strong>
            <div>
              <span>{metric.label}</span>
              <small>{metric.note}</small>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="case-failures" class="case-section" aria-labelledby="case-failures-title">
    <header class="case-section-heading">
      <span>05</span>
      <h3 id="case-failures-title">{labels.failures}</h3>
    </header>
    <div class="case-section-body case-failures">
      {study.failures.map((failure, index) => (
        <article>
          <span class="case-failure-number">{String(index + 1).padStart(2, '0')}</span>
          <dl>
            <div>
              <dt>{labels.symptom}</dt>
              <dd>{failure.symptom}</dd>
            </div>
            <div>
              <dt>{labels.correction}</dt>
              <dd>{failure.correction}</dd>
            </div>
            <div>
              <dt>{labels.lesson}</dt>
              <dd>{failure.lesson}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section id="case-evidence" class="case-section" aria-labelledby="case-evidence-title">
    <header class="case-section-heading">
      <span>06</span>
      <h3 id="case-evidence-title">{labels.evidence}</h3>
    </header>
    <div class="case-section-body">
      <div class="case-links">
        {study.links.map((link) => (
          <a
            href={resolveHref(link.href, link.external)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
          >
            <span>{labels.linkKinds[link.kind]}</span>
            <strong>{link.label}</strong>
            <i aria-hidden="true">{link.external ? '↗' : '→'}</i>
          </a>
        ))}
      </div>
      {study.disclosure && (
        <aside class="case-disclosure">
          <strong>{labels.disclosure}</strong>
          <p>{study.disclosure}</p>
        </aside>
      )}
    </div>
  </section>
</section>

<style>
  .engineering-case {
    --case-line: color-mix(in srgb, var(--border) 88%, transparent);
    margin: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-block: 1px solid var(--case-line);
  }

  .engineering-case-intro {
    display: grid;
    grid-template-columns: minmax(10rem, .32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.75rem, 4vw, 3rem) 0;
  }

  .case-eyebrow,
  .case-label {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .engineering-case-intro h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.15;
  }

  .engineering-case-intro div > p {
    max-width: 66ch;
    margin: .8rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .case-section-heading > span,
  .case-responsibilities span,
  .case-failure-number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 700;
  }

  .case-section {
    display: grid;
    grid-template-columns: minmax(10rem, .32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(2rem, 5vw, 3.75rem) 0;
    border-top: 1px solid var(--case-line);
    scroll-margin-top: 6rem;
  }

  .case-section-heading {
    display: grid;
    align-content: start;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: .6rem;
  }

  .case-section-heading h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.25;
  }

  .case-section-body {
    min-width: 0;
  }

  .case-context {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .case-label {
    margin-bottom: .75rem;
  }

  .case-lead {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.75;
  }

  .case-list {
    display: grid;
    gap: .75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .case-list li::before {
    content: "";
    position: absolute;
    top: .7em;
    left: 0;
    width: .35rem;
    height: .35rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .case-architecture {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--case-line);
    list-style: none;
  }

  .case-architecture li {
    display: grid;
    align-content: start;
    min-height: 9rem;
    padding: 1rem;
  }

  .case-architecture li + li {
    border-left: 1px solid var(--case-line);
  }

  .case-architecture li > span {
    margin-bottom: 1.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .68rem;
  }

  .case-architecture strong {
    font-size: .95rem;
    line-height: 1.35;
  }

  .case-architecture small {
    margin-top: .45rem;
    color: var(--text-muted);
    font-size: .76rem;
    line-height: 1.5;
  }

  .case-subheading {
    margin-top: 2rem;
  }

  .case-decisions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--case-line);
  }

  .case-decisions article {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--case-line);
  }

  .case-decisions article:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--case-line);
  }

  .case-decisions h4,
  .case-decisions p {
    margin: 0;
  }

  .case-decisions h4 {
    font-size: .95rem;
  }

  .case-decisions p {
    margin-top: .45rem;
    color: var(--text-muted);
    font-size: .88rem;
    line-height: 1.6;
  }

  .case-responsibilities {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--case-line);
    list-style: none;
  }

  .case-responsibilities li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: .75rem;
    padding: .9rem 0;
    border-bottom: 1px solid var(--case-line);
  }

  .case-responsibilities p {
    margin: 0;
    line-height: 1.65;
  }

  .case-method {
    max-width: 70ch;
    margin-bottom: 1.5rem;
  }

  .case-metrics {
    display: grid;
    border-top: 1px solid var(--case-line);
  }

  .case-metrics article {
    display: grid;
    grid-template-columns: minmax(5rem, .24fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--case-line);
  }

  .case-metrics article > strong {
    color: var(--accent);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1;
  }

  .case-metrics article div {
    display: grid;
    gap: .2rem;
  }

  .case-metrics article span {
    font-weight: 700;
  }

  .case-metrics article small {
    color: var(--text-muted);
    line-height: 1.45;
  }

  .case-failures {
    border-top: 1px solid var(--case-line);
  }

  .case-failures > article {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: .75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--case-line);
  }

  .case-failures dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .case-failures dl > div {
    padding-right: 1rem;
  }

  .case-failures dl > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--case-line);
  }

  .case-failures dt {
    margin-bottom: .35rem;
    color: var(--text);
    font-size: .76rem;
    font-weight: 700;
  }

  .case-failures dd {
    margin: 0;
    color: var(--text-muted);
    font-size: .86rem;
    line-height: 1.55;
  }

  .case-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--case-line);
  }

  .case-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .3rem 1rem;
    padding: .9rem 1rem .9rem 0;
    border-bottom: 1px solid var(--case-line);
    color: var(--text);
    text-decoration: none;
  }

  .case-links a:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--case-line);
  }

  .case-links a > span {
    grid-column: 1 / -1;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .case-links a strong {
    font-size: .88rem;
  }

  .case-links a i {
    color: var(--accent);
    font-style: normal;
  }

  .case-links a:hover strong {
    color: var(--accent);
  }

  .case-disclosure {
    display: grid;
    grid-template-columns: minmax(7rem, .2fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--case-line);
  }

  .case-disclosure strong {
    font-size: .76rem;
  }

  .case-disclosure p {
    margin: 0;
    color: var(--text-muted);
    font-size: .86rem;
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .engineering-case-intro,
    .case-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .case-section-heading {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .case-context {
      grid-template-columns: 1fr;
    }

    .case-architecture {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .case-architecture li {
      flex: 0 0 min(72vw, 15rem);
      scroll-snap-align: start;
    }

    .case-failures dl {
      grid-template-columns: 1fr;
    }

    .case-failures dl > div {
      padding: .65rem 0;
    }

    .case-failures dl > div + div {
      border-top: 1px solid var(--case-line);
      border-left: 0;
    }
  }

  @media (max-width: 560px) {
    .case-decisions,
    .case-links {
      grid-template-columns: 1fr;
    }

    .case-decisions article:nth-child(even),
    .case-links a:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .case-disclosure {
      grid-template-columns: 1fr;
      gap: .4rem;
    }
  }
</style>
