---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PaperReadingPostContent from '../../../components/pages/PaperReadingPostContent.astro';
import { baseSlug, resolveEntriesForLang } from '../../../utils/contentLocale';

export async function getStaticPaths() {
  const entries = resolveEntriesForLang(await getCollection('paperReading'), 'en');
  return entries.map((entry) => ({
    params: { slug: baseSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'paperReading'> };
---

<PaperReadingPostContent lang="en" entry={entry} />
