---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../utils/sort';
import ProjectCard from '../components/ProjectCard.astro';
import StickerCard from '../components/StickerCard.astro';
import BlogPreviewItem from '../components/BlogPreviewItem.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Footer from '../components/Footer.astro';

const posts = sortByPubDate(await getCollection('blog')).slice(0, 3);
const stickers = sortByPubDate(await getCollection('stickers')).slice(0, 3);
const projects = sortByPubDate(await getCollection('projects')).slice(0, 4);
---

<Layout
  title="Bloss0m"
  description="I design and build enterprise-grade AI platforms, focusing on RAG, multi-agent collaboration, and real-time AI systems."
>
  <div class="block-en">
    <section id="showcase" class="section-reveal">
      <div class="section-title">Selected Projects</div>
      <div class="showcase">
        {projects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="View project" />
        ))}
      </div>
    </section>

    <section id="blog-preview" class="section-reveal">
      <div class="section-title">Latest from Blog</div>
      <div class="blog-preview">
        {posts.map((post) => (
          <BlogPreviewItem post={post} />
        ))}
      </div>
    </section>

    <section id="stickers" class="section-reveal">
      <div class="section-title">LINE Stickers</div>
      <div class="sticker-grid">
        {stickers.map((entry) => (
          <StickerCard entry={entry} lineStoreLabel="LINE Store" buttonClass="btn-secondary" />
        ))}
      </div>
      <p class="text-center-mt">
        <a href="/stickers/" class="btn btn-secondary">View all</a>
      </p>
    </section>

    <CtaBlock text="Looking for an AI platform or Agentic AI partner? I help teams ship enterprise-grade RAG, multi-agent, and real-time AI systems." buttonText="Contact" buttonHref="/contact/" />
    <Footer text="AI Platform & Agentic AI Engineer · RAG · Multi-Agent · Realtime AI" />
  </div>

  <div class="block-zh">
    <section id="showcase" class="section-reveal">
      <div class="section-title">精選專案</div>
      <div class="showcase">
        {projects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="看專案" />
        ))}
      </div>
    </section>

    <section id="blog-preview" class="section-reveal">
      <div class="section-title">最新文章</div>
      <div class="blog-preview">
        {posts.map((post) => (
          <BlogPreviewItem post={post} />
        ))}
      </div>
    </section>

    <section id="stickers" class="section-reveal">
      <div class="section-title">LINE 貼圖</div>
      <div class="sticker-grid">
        {stickers.map((entry) => (
          <StickerCard entry={entry} lineStoreLabel="貼圖小舖" buttonClass="btn-secondary" />
        ))}
      </div>
      <p class="text-center-mt">
        <a href="/stickers/" class="btn btn-secondary">看全部</a>
      </p>
    </section>

    <CtaBlock text="正在找 AI 平台或 Agentic AI 夥伴？我協助團隊交付企業級 RAG、多代理與即時 AI 系統。" buttonText="聯絡" buttonHref="/contact/" />
    <Footer text="AI 平台與 Agentic AI 工程師 · RAG · 多代理 · 即時 AI" />
  </div>
</Layout>
