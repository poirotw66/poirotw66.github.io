---
interface TrustItem {
  value: string | number;
  label: string;
  detail: string;
  href: string;
}

interface Props {
  label: string;
  items: TrustItem[];
}

const { label, items } = Astro.props;
---

<div id="trust" aria-label={label}>
  <p class="home-trust-label">{label}</p>
  <div class="hero-metrics">
    {items.map((item) => (
      <a
        href={item.href}
        class="home-trust-item"
        target={item.href.startsWith('http') ? '_blank' : undefined}
        rel={item.href.startsWith('http') ? 'noopener' : undefined}
      >
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <small>{item.detail}</small>
      </a>
    ))}
  </div>
</div>
