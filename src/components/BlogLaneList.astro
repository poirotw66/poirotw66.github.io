---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import type { BlogLaneId } from '../utils/blogLanes';
import BlogPreviewItem from './BlogPreviewItem.astro';

type CompactVariant = 'compact' | 'card';

interface Props {
  featured: CollectionEntry<'blog'>[];
  compact: CollectionEntry<'blog'>[];
  lane: BlogLaneId;
  lang: Lang;
  compactVariant?: CompactVariant;
  priorityFeatured?: boolean;
}

const { featured, compact, lane, lang, compactVariant = 'compact', priorityFeatured = false } = Astro.props;
---

<div class="blog-lane-list">
  {featured.map((post, index) => (
    <BlogPreviewItem post={post} lang={lang} variant="featured" lane={lane} priority={priorityFeatured && index === 0} />
  ))}
  {compact.length > 0 && compactVariant === 'card' && (
    <div class="blog-lane-card-grid blog-preview">
      {compact.map((post) => (
        <BlogPreviewItem post={post} lang={lang} variant="card" lane={lane} />
      ))}
    </div>
  )}
  {compact.length > 0 && compactVariant === 'compact' && (
    <ul class="blog-lane-compact-list">
      {compact.map((post) => (
        <li>
          <BlogPreviewItem post={post} lang={lang} variant="compact" lane={lane} />
        </li>
      ))}
    </ul>
  )}
</div>
