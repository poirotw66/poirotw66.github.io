---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry, getCollection } from 'astro:content';
import PaperInfoCard from '../PaperInfoCard.astro';
import ArticlePageLayout from '../article/ArticlePageLayout.astro';
import ArticleBrief from '../article/ArticleBrief.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath, useTranslations } from '../../i18n/utils';
import { formatPublishedDate, toDate } from '../../utils/formatPublishedDate';
import { estimateReadingMinutes } from '../../utils/readingTime';
import { descriptionToTldr } from '../../utils/articleBrief';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import { hasMathContent } from '../../utils/mathContent';
import { hasHuahuaCallout } from '../../utils/huahuaCallout';
import { paperReadingPathForSlug } from '../../data/paperReadingPaths';
import { getPaperReadingTopicById } from '../../data/paperReadingTopics.mjs';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'paperReading'>;
}

const { lang, entry } = Astro.props;
const { Content, headings } = await render(entry);
const hasCode = entry.body.includes('`');
const hasMath = hasMathContent(entry.body);
const hasHuahua = hasHuahuaCallout(entry.body);
const t = useTranslations(lang);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = Boolean(entry.data.showToc) && tocHeadings.length > 0;
const slug = baseSlug(entry);

const site = Astro.site ?? new URL('https://www.bloss0m.com');
const canonicalUrl = new URL(toLocalizedPath(`/paper-reading/${slug}/`, lang), site).toString();
const articleImage = entry.data.image ? new URL(entry.data.image, site).toString() : new URL('/og.webp', site).toString();
const pubDateObj = toDate(entry.data.pubDate);
const pubIso = pubDateObj.toISOString();
const updatedDateObj = entry.data.updatedDate ? toDate(entry.data.updatedDate) : null;
const modifiedIso = updatedDateObj?.toISOString() ?? pubIso;
const readingMinutes = estimateReadingMinutes(entry.body);
const readerCopy = lang === 'en'
  ? { progress: 'Article reading progress', copy: 'Copy code', copied: 'Copied', read: `${readingMinutes} min read`, published: 'Published', readingTime: 'Reading time', updated: 'Updated' }
  : { progress: '文章閱讀進度', copy: '複製程式碼', copied: '已複製', read: `閱讀約 ${readingMinutes} 分鐘`, published: '發布日期', readingTime: '閱讀時間', updated: '更新' };
const tldrItems = entry.data.tldr ?? descriptionToTldr(entry.data.description);
const audienceItems = entry.data.audience ?? [
  lang === 'en'
    ? 'AI/ML practitioners and researchers who want the paper’s method, evidence, and engineering implications without reading it end to end first.'
    : '想先掌握論文方法、實驗證據與工程啟示，再決定是否深入閱讀的 AI／ML 實作者與研究者。',
];

const difficultyLabel =
  entry.data.difficulty === 'intro'
    ? lang === 'en'
      ? 'Intro'
      : '入門'
    : entry.data.difficulty === 'intermediate'
      ? lang === 'en'
        ? 'Intermediate'
        : '中階'
      : entry.data.difficulty === 'advanced'
        ? lang === 'en'
          ? 'Advanced'
          : '進階'
        : null;

const allEntries = resolveEntriesForLang(await getCollection('paperReading'), lang);
const seriesId = entry.data.series?.id;
const seriesEntries = seriesId
  ? allEntries
      .filter((e) => e.data.series?.id === seriesId)
      .sort((a, b) => (a.data.series?.part ?? 0) - (b.data.series?.part ?? 0))
  : [];

const seriesIndex = seriesEntries.findIndex((e) => baseSlug(e) === slug);
const prevInSeries = seriesIndex > 0 ? seriesEntries[seriesIndex - 1] : null;
const nextInSeries = seriesIndex >= 0 && seriesIndex < seriesEntries.length - 1 ? seriesEntries[seriesIndex + 1] : null;
const readingPath = paperReadingPathForSlug(slug);
const pathEntries = readingPath
  ? readingPath.slugs
      .map((pathSlug) => allEntries.find((candidate) => baseSlug(candidate) === pathSlug))
      .filter((candidate): candidate is CollectionEntry<'paperReading'> => Boolean(candidate))
  : [];
const pathIndex = pathEntries.findIndex((candidate) => baseSlug(candidate) === slug);
const nextInPath = pathIndex >= 0 && pathIndex < pathEntries.length - 1 ? pathEntries[pathIndex + 1] : null;
const topics = entry.data.topics.flatMap((topicId) => {
  const topic = getPaperReadingTopicById(topicId);
  return topic ? [topic] : [];
});
---

<Layout
  title={`${entry.data.title} | Bloss0m`}
  description={entry.data.description}
  canonicalURL={new URL(toLocalizedPath(`/paper-reading/${slug}/`, lang), site)}
  imageURL={articleImage}
  ogType="article"
  articlePublishedTime={pubIso}
  articleModifiedTime={modifiedIso}
  articleAuthor="Bloss0m"
  lang={lang}
  bodyClass="page-article"
>
  <Fragment slot="head">
    {hasCode && <link rel="stylesheet" href="/css/article-code.css" />}
    {hasMath && <link rel="stylesheet" href="/css/katex.min.css" />}
    {hasMath && <link rel="stylesheet" href="/css/article-math.css" />}
    {hasHuahua && <link rel="stylesheet" href="/css/huahua-callout.css" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: entry.data.title,
      description: entry.data.description,
      image: articleImage,
      datePublished: pubIso,
      dateModified: modifiedIso,
      author: { '@id': `${site.toString().replace(/\/$/, '')}/#person` },
      publisher: { '@id': `${site.toString().replace(/\/$/, '')}/#organization` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Paper Reading', item: new URL(toLocalizedPath('/paper-reading/', lang), site).toString() },
        { '@type': 'ListItem', position: 2, name: entry.data.title, item: canonicalUrl },
      ],
    })} />
  </Fragment>

  <div class="content-region">
    <section class="section-spacer-lg">
      <ArticlePageLayout
        showToc={showToc}
        tocHeadings={tocHeadings}
        tocLabel={t('blog.tocTitle')}
        progressLabel={readerCopy.progress}
        copyLabel={readerCopy.copy}
        copiedLabel={readerCopy.copied}
        wideHeader
      >
        <div slot="header" class="article-masthead article-masthead--paper article-masthead--wide article-masthead--text">
          <a href={toLocalizedPath('/paper-reading/', lang)} class="back">← {lang === 'en' ? 'Paper Reading' : '論文精讀'}</a>
          <p class="article-masthead-kicker">{lang === 'en' ? 'Paper reading' : '論文精讀'}</p>
          <h1>{entry.data.title}</h1>
          <p class="article-meta article-facts">
            {(entry.data.field || difficultyLabel) && (
              <span class="article-fact article-fact-topic">
                {entry.data.field && <span>{entry.data.field}</span>}
                {difficultyLabel && <span>{difficultyLabel}</span>}
              </span>
            )}
            <span class="article-fact article-fact-date">
              <span class="article-fact-label">{readerCopy.published}</span>
              <time datetime={pubIso}>{formatPublishedDate(pubDateObj, lang)}</time>
            </span>
            <span class="article-fact article-fact-reading">
              <span class="article-fact-label">{readerCopy.readingTime}</span>
              <span class="article-reading-time">{readerCopy.read}</span>
            </span>
            {updatedDateObj && (
              <span class="article-fact article-fact-updated">
                <span class="article-fact-label">{readerCopy.updated}</span>
                <time datetime={modifiedIso}>{formatPublishedDate(updatedDateObj, lang)}</time>
              </span>
            )}
          </p>
          {entry.data.series && (
            <p class="article-meta article-meta-series">
              <a href={toLocalizedPath(`/paper-reading/series/${entry.data.series.id}/`, lang)} class="series-link">
                {entry.data.series.title} · Part {entry.data.series.part}
                {entry.data.series.totalParts ? `/${entry.data.series.totalParts}` : ''}
              </a>
            </p>
          )}
          {topics.length > 0 && (
            <nav class="paper-topic-links" aria-label={lang === 'en' ? 'Research topics' : '研究議題'}>
              <span class="paper-topic-links-label">{lang === 'en' ? 'Research topics' : '研究議題'}</span>
              {topics.map((topic) => (
                <a href={toLocalizedPath(`/paper-reading/topics/${topic.id}/`, lang)}>{topic.title[lang]}</a>
              ))}
            </nav>
          )}
          <PaperInfoCard paper={entry.data.paper} />
        </div>
        <ArticleBrief slot="summary" lang={lang} tldr={tldrItems} audience={audienceItems} compactMobile />
        <Content />
        {(pathEntries.length > 1 || seriesEntries.length > 1) && (
          <div slot="footer">
            {readingPath && pathEntries.length > 1 && (
              <nav class="reading-path-nav" aria-label={lang === 'en' ? 'Reading path' : '閱讀路徑'}>
                <div>
                  <p class="reading-path-nav-kicker">{lang === 'en' ? 'Your reading path' : '你的閱讀路徑'}</p>
                  <h2>{readingPath.title[lang]}</h2>
                  <p>
                    {lang === 'en'
                      ? `Step ${pathIndex + 1} of ${pathEntries.length}`
                      : `第 ${pathIndex + 1} 篇，共 ${pathEntries.length} 篇`}
                  </p>
                </div>
                {nextInPath ? (
                  <a
                    class="reading-path-next"
                    href={toLocalizedPath(`/paper-reading/${baseSlug(nextInPath)}/`, lang)}
                    data-paper-next="path"
                    data-paper-path-link={readingPath.id}
                  >
                    <span>{lang === 'en' ? 'Continue with' : '下一篇讀'}</span>
                    <strong>{nextInPath.data.title}</strong>
                  </a>
                ) : (
                  <a
                    class="reading-path-next"
                    href={toLocalizedPath('/paper-reading/#reading-paths', lang)}
                    data-paper-next="path-complete"
                    data-paper-path-link={readingPath.id}
                  >
                    <span>{lang === 'en' ? 'Path complete' : '路徑完成'}</span>
                    <strong>{lang === 'en' ? 'Choose another path' : '選擇下一條閱讀路徑'}</strong>
                  </a>
                )}
              </nav>
            )}
            {seriesEntries.length > 1 && <div class="series-nav">
              <div class="series-nav-head">
                <span class="series-nav-title">{lang === 'en' ? 'Series' : '系列'}</span>
                <a class="series-nav-all" href={toLocalizedPath(`/paper-reading/series/${seriesId}/`, lang)}>{lang === 'en' ? 'View all' : '看全部'}</a>
              </div>
              <div class="series-nav-links">
                {prevInSeries ? (
                  <a class="series-nav-link" href={toLocalizedPath(`/paper-reading/${baseSlug(prevInSeries)}/`, lang)}>
                    <div class="series-nav-kicker">{lang === 'en' ? 'Previous' : '上一篇'}</div>
                    <div class="series-nav-name">{prevInSeries.data.title}</div>
                  </a>
                ) : (
                  <div class="series-nav-link series-nav-link-disabled">
                    <div class="series-nav-kicker">{lang === 'en' ? 'Previous' : '上一篇'}</div>
                    <div class="series-nav-name">-</div>
                  </div>
                )}
                {nextInSeries ? (
                  <a class="series-nav-link" href={toLocalizedPath(`/paper-reading/${baseSlug(nextInSeries)}/`, lang)}>
                    <div class="series-nav-kicker">{lang === 'en' ? 'Next' : '下一篇'}</div>
                    <div class="series-nav-name">{nextInSeries.data.title}</div>
                  </a>
                ) : (
                  <div class="series-nav-link series-nav-link-disabled">
                    <div class="series-nav-kicker">{lang === 'en' ? 'Next' : '下一篇'}</div>
                    <div class="series-nav-name">-</div>
                  </div>
                )}
              </div>
            </div>}
          </div>
        )}
      </ArticlePageLayout>
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<style>
  .paper-topic-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
  }
  .paper-topic-links-label {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .paper-topic-links a {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.18rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--surface) 90%, var(--accent) 10%);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }
  .paper-topic-links a:hover,
  .paper-topic-links a:focus-visible {
    border-color: var(--accent);
    text-decoration: underline;
  }
  .reading-path-nav {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 1rem;
    align-items: stretch;
    margin-top: 2.25rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface) 90%, var(--accent) 10%);
  }
  .reading-path-nav h2,
  .reading-path-nav p {
    margin: 0;
  }
  .reading-path-nav h2 {
    margin-top: 0.2rem;
    font-size: 1rem;
  }
  .reading-path-nav p:not(.reading-path-nav-kicker) {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .reading-path-nav-kicker {
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .reading-path-next {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    min-height: 4.5rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
  }
  .reading-path-next:hover {
    border-color: color-mix(in srgb, var(--accent) 38%, var(--border));
  }
  .reading-path-next span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }
  .reading-path-next strong {
    line-height: 1.35;
  }
  .series-link {
    text-decoration: none;
  }
  .series-link:hover {
    text-decoration: underline;
  }
  .series-nav {
    margin-top: 2.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.35);
  }
  .series-nav-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .series-nav-title {
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  .series-nav-all {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .series-nav-all:hover {
    text-decoration: underline;
  }
  .series-nav-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .series-nav-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    text-decoration: none;
    color: var(--text);
  }
  .series-nav-link:hover {
    border-color: color-mix(in srgb, var(--accent) 24%, var(--border));
  }
  .series-nav-link-disabled {
    opacity: 0.5;
  }
  .series-nav-kicker {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }
  .series-nav-name {
    font-weight: 600;
    line-height: 1.25;
  }
  .series-nav-all {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0;
  }

  @media (max-width: 720px) {
    .reading-path-nav,
    .series-nav-links {
      grid-template-columns: 1fr;
    }
  }
</style>
