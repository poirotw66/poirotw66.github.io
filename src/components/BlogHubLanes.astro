---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import type { BlogLaneId } from '../utils/blogLanes';
import { BLOG_LANE_COPY, BLOG_LANE_IDS, getPostsForLane } from '../utils/blogLanes';
import { toLocalizedPath } from '../i18n/utils';
import { blogSlug } from '../utils/blogLocale';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const isEn = lang === 'en';

function laneHref(laneId: BlogLaneId): string {
  return toLocalizedPath(`/blog/?lane=${laneId}`, lang);
}

function copyFor(laneId: BlogLaneId) {
  const copy = BLOG_LANE_COPY[laneId];
  return {
    title: isEn ? copy.title.en : copy.title.zh,
    lead: isEn ? copy.lead.en : copy.lead.zh,
    cta: isEn ? copy.cta.en : copy.cta.zh,
  };
}
---

<div class="blog-hub-lanes" id="blog-lane-previews">
  <div class="blog-hub-lanes-head">
    <h2>{isEn ? 'Choose a reading path' : '選擇閱讀路徑'}</h2>
    <p>{isEn ? 'Start with implementation work, then move to research updates or concept guides.' : '先從工程實作開始，再依需求閱讀研究觀測或概念導讀。'}</p>
  </div>
  <div class="blog-lane-nav-grid">
  {BLOG_LANE_IDS.map((laneId) => {
    const lanePosts = getPostsForLane(posts, laneId);
    const recentPosts = lanePosts.slice(0, laneId === 'engineering' ? 3 : 1);
    const copy = copyFor(laneId);

    return (
      <article class:list={['blog-lane-nav-card', `blog-lane-nav-card--${laneId}`]}>
        <h3><a href={laneHref(laneId)}>{copy.title}</a></h3>
        <p class="blog-lane-nav-lead">{copy.lead}</p>
        <ul class="blog-lane-nav-recent">
          {recentPosts.length === 0 && <li>{isEn ? 'No recommended articles yet.' : '目前沒有精選文章。'}</li>}
          {recentPosts.map((post) => (
            <li>
              <a href={toLocalizedPath(`/blog/${blogSlug(post)}/`, lang)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
        <a class="blog-lane-nav-cta" href={laneHref(laneId)}>{copy.cta}</a>
      </article>
    );
  })}
  </div>
</div>
