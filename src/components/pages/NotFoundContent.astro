---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import HuahuaEmptyState from '../HuahuaEmptyState.astro';
import { toLocalizedPath } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout
  title={lang === 'en' ? 'Page not found | Bloss0m' : '找不到頁面 | Bloss0m'}
  description={lang === 'en' ? 'The page you are looking for does not exist.' : '您尋找的頁面不存在。'}
  lang={lang}
  bodyClass="page-not-found"
  noindex
>
  <div class="page-404">
    <HuahuaEmptyState
      kicker={lang === 'en' ? 'Huahua got a little lost' : '花花好像迷路了'}
      title={lang === 'en' ? 'This page is hiding in the garden.' : '花花好像把這頁藏進花叢裡了。'}
      description={lang === 'en' ? 'The page may have moved or the link may no longer exist. Pick a path below and Huahua will guide you back.' : '這個頁面可能已經移動，或連結不再存在。從下方選一條路，讓花花帶你回到網站內容。'}
      code="404"
      headingLevel="h1"
    >
      <Fragment slot="actions">
        <a href={toLocalizedPath('/', lang)} class="btn btn-primary">
          ← {lang === 'en' ? 'Back to Home' : '回首頁'}
        </a>
        <a href={toLocalizedPath('/blog/', lang)} class="btn btn-secondary">
          {lang === 'en' ? 'Browse writing' : '瀏覽文章'}
        </a>
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">
          {lang === 'en' ? 'View projects' : '查看專案'}
        </a>
      </Fragment>
    </HuahuaEmptyState>
  </div>
</Layout>

<style>
  .page-404 {
    display: grid;
    place-items: center;
    width: min(calc(100% - (var(--page-gutter) * 2)), 1080px);
    min-height: 68vh;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }
  @media (max-width: 640px) {
    .page-404 {
      min-height: 64vh;
    }
  }
</style>
