---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const items = isEn
  ? [
      { id: 'trust', label: 'Proof' },
      { id: 'focus', label: 'Focus' },
      { id: 'roadmap', label: 'Building now' },
      { id: 'showcase', label: 'Case studies' },
      { id: 'journey', label: 'Journey' },
      { id: 'writing', label: 'Writing' },
      { id: 'cta', label: 'Contact' },
    ]
  : [
      { id: 'trust', label: '成果' },
      { id: 'focus', label: '重點' },
      { id: 'roadmap', label: '正在建造' },
      { id: 'showcase', label: '案例' },
      { id: 'journey', label: '歷程' },
      { id: 'writing', label: '觀點' },
      { id: 'cta', label: '聯絡' },
    ];

const ariaLabel = isEn ? 'Jump to sections on this page' : '本頁區塊快速導覽';
---

<nav class="home-jump-nav" aria-label={ariaLabel}>
  <p class="home-jump-nav-label">{isEn ? 'On this page' : '本頁導覽'}</p>
  <ul class="home-jump-nav-list">
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-home-jump={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>
