---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { toLocalizedPath } from '../../i18n/utils';
import SectionHeading from '../SectionHeading.astro';
import HomeTrustBar from '../HomeTrustBar.astro';
import HomeCaseStudy from '../HomeCaseStudy.astro';
import HomeLatestUpdates from '../HomeLatestUpdates.astro';
import HomeCollaborationCta from '../HomeCollaborationCta.astro';
import { getPostsForLane } from '../../utils/blogLanes';
import { resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import {
  HOME_CASE_STUDY_SLUGS,
  homeCaseStudyDetails,
  type HomeCaseStudySlug,
} from '../../data/homeBrand';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const isEn = lang === 'en';
const allBlogPosts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const latestWriting = getPostsForLane(allBlogPosts, 'starter').slice(0, 2);
const allProjectEntries = resolveEntriesForLang(await getCollection('projects'), lang);
const projectBySlug = new Map(allProjectEntries.map((entry) => [baseSlug(entry), entry]));
const projects = HOME_CASE_STUDY_SLUGS.flatMap((slug) => {
  const entry = projectBySlug.get(slug);
  return entry ? [entry] : [];
});
const [featuredProject, ...secondaryProjects] = projects;

const trustItems = isEn
  ? [
      { value: '98.0%', label: 'weighted RAG accuracy', detail: 'Fixed 100-query benchmark', href: toLocalizedPath('/projects/agentic-rag/', lang) },
      { value: '19', label: 'modular agent subflows', detail: 'Inspectable system design', href: toLocalizedPath('/projects/agentic-ai-platform/', lang) },
      { value: '5+', label: 'hospital formats normalized', detail: 'Built against real documents', href: toLocalizedPath('/projects/ocr-automation/', lang) },
    ]
  : [
      { value: '98.0%', label: 'RAG 加權準確率', detail: '固定 100 題 benchmark', href: toLocalizedPath('/projects/agentic-rag/', lang) },
      { value: '19', label: '個模組化 Agent 子流程', detail: '可查驗的系統設計', href: toLocalizedPath('/projects/agentic-ai-platform/', lang) },
      { value: '5+', label: '種醫院格式正規化', detail: '以真實文件完成實作', href: toLocalizedPath('/projects/ocr-automation/', lang) },
    ];

const copy = isEn
  ? {
      title: 'Bloss0m | Justin · AI Platform & Agentic AI Engineer',
      description: "Bloss0m is Justin's public AI engineering lab: frontier research, working systems, architecture notes, and reproducible experiments.",
      eyebrow: 'Justin · AI Platform & Agentic AI Engineer',
      titleLines: ['Turn frontier AI into', 'systems that actually run.'],
      tagline: 'Agent, RAG, and AI Platform engineering: architecture, evaluation, deployment, operations, and handoff.',
      primaryCta: 'View case studies',
      secondaryCta: 'Browse all projects ↗',
      mascotLabel: 'Start here with Huahua',
      mascotLine: 'Choose the question closest to yours. Huahua will take you directly to the useful evidence.',
      mascotAlt: 'Huahua, the Bloss0m calico cat field guide',
      trustLabel: 'Public engineering evidence. Open the source behind each signal.',
      showcaseTitle: 'Flagship system: a measurable Agentic RAG pipeline',
      showcaseLink: 'View all implementations',
    }
  : {
      title: 'Bloss0m｜Justin · AI Platform 與 Agentic AI 工程師',
      description: 'Bloss0m 是 Justin 的公開 AI 工程實驗室，記錄前沿研究、可運行系統、架構判斷與可重現的技術實驗。',
      eyebrow: 'Justin · AI Platform & Agentic AI Engineer',
      titleLines: ['把前沿 AI，', '做成真正能運行的系統。'],
      tagline: '專注 Agent、RAG 與 AI Platform，從架構與評測一路做到部署、維運與交接。',
      primaryCta: '查看代表案例',
      secondaryCta: '瀏覽全部專案 ↗',
      mascotLabel: '從花花導覽開始',
      mascotLine: '選一個最接近你的問題，花花會直接帶你找到有用的工程證據。',
      mascotAlt: 'Bloss0m 三花貓技術導覽花花',
      trustLabel: '公開工程證據｜每一項都有實作或評測可以查驗',
      showcaseTitle: '旗艦系統：可量測的 Agentic RAG 管線',
      showcaseLink: '看全部實作',
    };

const problemPaths = isEn
  ? [
      { title: 'How do enterprise Agents stay controllable?', body: 'Design evaluation, observability, permissions, and failure recovery into Agent workflows so they can be inspected and operated.', href: toLocalizedPath('/now/', lang) },
      { title: 'How can retrieval be made reliable?', body: 'Turn scattered documents, permissions, and difficult queries into retrieval systems with measurable quality and traceable answers.', href: toLocalizedPath('/projects/agentic-rag/', lang) },
      { title: 'Need a technical talk or architecture exchange?', body: 'Use an architecture review, PoC evaluation, or engineering talk to clarify the next decision for your team.', href: toLocalizedPath('/contact/', lang) },
    ]
  : [
      { title: '企業 Agent 如何維持可控？', body: '將評估、可觀測性、權限與失敗復原納入工作流，讓系統可檢查、可運行。', href: toLocalizedPath('/now/', lang) },
      { title: '如何讓檢索更可靠？', body: '把文件、權限與困難查詢轉化為有可量測品質與可追溯答案的檢索系統。', href: toLocalizedPath('/projects/agentic-rag/', lang) },
      { title: '需要技術演講或架構交流？', body: '以架構取捨、PoC 評估或可落地的 Agent／RAG 實務，展開下一場技術對話。', href: toLocalizedPath('/contact/', lang) },
    ];
---

<Layout title={copy.title} description={copy.description} lang={lang} bodyClass="page-home">
  <>
    <section id="hero" class="home-hero section-reveal home-scroll-anchor">
      <div class="home-hero-grid">
        <div class="home-hero-copy surface-raised">
          <p class="hero-eyebrow">{copy.eyebrow}</p>
          <h1 class="hero-title">{copy.titleLines.map((line) => <span>{line}</span>)}</h1>
          <p class="hero-tagline">{copy.tagline}</p>
          <div class="hero-actions">
            <a href="#showcase" class="btn btn-primary">{copy.primaryCta}</a>
            <a href={toLocalizedPath('/projects/', lang)} class="hero-contact-link">{copy.secondaryCta}</a>
          </div>
        </div>

        <aside class="hero-spotlight hero-mascot surface-raised" aria-label={copy.mascotLabel}>
          <div class="hero-guide-head">
            <img src="/brand/bloom-mark-128.webp" alt={copy.mascotAlt} width="96" height="96" decoding="async" />
            <div><p class="hero-spotlight-label">{copy.mascotLabel}</p><p>{copy.mascotLine}</p></div>
          </div>
          <a class="hero-guide-link" href="#focus">{isEn ? 'Explore the three starting points' : '從三個問題開始'}</a>
        </aside>
      </div>
      <HomeTrustBar label={copy.trustLabel} items={trustItems} />
    </section>

    <section id="focus" class="section-reveal home-signals home-scroll-anchor home-editorial-section">
      <header class="home-problem-head"><h2>{isEn ? 'Start with the question closest to yours' : '從你的問題開始'}</h2></header>
      <ol class="home-problem-list">
        {problemPaths.map((item, index) => (
          <li>
            <a href={item.href}>
              <span class="home-problem-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="home-problem-copy"><strong>{item.title}</strong><span>{item.body}</span></span>
              <span class="home-problem-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section id="showcase" class="section-reveal home-scroll-anchor home-editorial-section">
      <SectionHeading title={copy.showcaseTitle} />
      <div class="home-case-study-list">
        {featuredProject && <HomeCaseStudy entry={featuredProject} lang={lang} variant="featured" detail={homeCaseStudyDetails[lang][baseSlug(featuredProject) as HomeCaseStudySlug]} />}
      </div>
      <p class="text-center-mt"><a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{copy.showcaseLink}</a></p>
    </section>

    <HomeLatestUpdates posts={latestWriting} lang={lang} />
    {secondaryProjects.length > 0 && (
      <section id="other-cases" class="section-reveal home-scroll-anchor home-secondary-cases" aria-label={isEn ? 'Other production cases' : '其他正式環境案例'}>
        <header class="home-secondary-cases-head"><h2>{isEn ? 'More production cases' : '更多正式環境案例'}</h2></header>
        <div class="home-secondary-case-list">
          {secondaryProjects.map((entry) => <HomeCaseStudy entry={entry} lang={lang} variant="compact" detail={homeCaseStudyDetails[lang][baseSlug(entry) as HomeCaseStudySlug]} />)}
        </div>
      </section>
    )}
    <HomeCollaborationCta lang={lang} />
    <script src="/js/home-scroll-hash.js" defer></script>
  </>
</Layout>
