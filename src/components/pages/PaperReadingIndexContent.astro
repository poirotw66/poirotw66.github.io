---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import HubHero from '../HubHero.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import PaperReadingListItem from '../PaperReadingListItem.astro';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import { PAPER_READING_PATHS } from '../../data/paperReadingPaths';
import { PAPER_READING_TOPICS } from '../../data/paperReadingTopics.mjs';
import { toLocalizedPath } from '../../i18n/utils';
import ArchivePagination from '../ArchivePagination.astro';

import { PAPER_INDEX_PAGE_SIZE } from '../../utils/paperReadingPagination';

interface Props {
  lang: Lang;
  currentPage?: number;
}

type PaperEntry = CollectionEntry<'paperReading'>;

const { lang, currentPage = 1 } = Astro.props;
const entries = sortByPubDate(resolveEntriesForLang(await getCollection('paperReading'), lang));
const totalPages = Math.ceil(entries.length / PAPER_INDEX_PAGE_SIZE);
const pageStart = (currentPage - 1) * PAPER_INDEX_PAGE_SIZE;
const initialEntries = entries.slice(pageStart, pageStart + PAPER_INDEX_PAGE_SIZE);
const isArchivePage = currentPage > 1;
const entriesBySlug = new Map(entries.map((entry) => [baseSlug(entry), entry]));
const readingPaths = PAPER_READING_PATHS.map((path) => ({
  ...path,
  entries: path.slugs.map((slug) => entriesBySlug.get(slug)).filter((entry): entry is PaperEntry => Boolean(entry)),
}));
const researchTopics = PAPER_READING_TOPICS.map((topic) => ({
  ...topic,
  entries: entries.filter((entry) => entry.data.topics.includes(topic.id)),
}));

const uniqueSorted = (values: Array<string | undefined>): string[] => {
  const set = new Set(values.filter((v): v is string => v != null && v.trim().length > 0).map((v) => v.trim()));
  return Array.from(set).sort((a, b) => a.localeCompare(b));
};

const fields = uniqueSorted(entries.map((e) => e.data.field));
const difficulties = uniqueSorted(entries.map((e) => e.data.difficulty));
const years = uniqueSorted(entries.map((e) => String(e.data.paper.year))).sort((a, b) => Number(b) - Number(a));
const isEn = lang === 'en';
const difficultyLabel = (value: string): string => {
  const labels: Record<string, { zh: string; en: string }> = {
    intro: { zh: '入門', en: 'Intro' },
    intermediate: { zh: '中階', en: 'Intermediate' },
    advanced: { zh: '進階', en: 'Advanced' },
  };
  return labels[value]?.[isEn ? 'en' : 'zh'] ?? value;
};
---

<Layout
  title={isEn
    ? `AI Agent, RAG & LLM Paper Readings${isArchivePage ? ` — Page ${currentPage}` : ''} | Bloss0m`
    : `AI Agent、RAG 與 LLM 論文精讀${isArchivePage ? `｜第 ${currentPage} 頁` : ''} | Bloss0m`}
  description={lang === 'en' ? 'Engineering-focused readings of AI agent, RAG, and LLM papers: methods, evidence, evaluation limits, and reproducible takeaways.' : '從工程視角精讀 AI Agent、RAG 與 LLM 論文，整理方法、實驗證據、評測限制與可複現重點。'}
  lang={lang}
  hubPreview
>
  <div class="content-region">
    <HubHero
      kicker="PAPERS / REPRODUCTION / ENGINEERING NOTES"
      title={isEn ? 'Paper reading for working engineers' : '為工程實作而讀的論文'}
      lead={isEn
        ? 'Structured readings that extract architecture decisions, reproducible methods, evaluation limits, and what changes when research meets a real system.'
        : '不只摘要論文，而是整理架構決策、可複現方法、評測限制，以及研究進入真實系統後會發生什麼。'}
      stats={[
        { value: entries.length, label: isEn ? 'reading notes' : '篇精讀筆記' },
        { value: researchTopics.length, label: isEn ? 'research topics' : '個研究議題' },
        { value: readingPaths.length, label: isEn ? 'learning paths' : '條學習路徑' },
      ]}
    />

    {!isArchivePage && <div class="paper-discovery-search">
      <label class="filter-label" for="filter-query">{isEn ? 'Search the library' : '搜尋論文庫'}</label>
      <input
        id="filter-query"
        class="filter-input"
        type="search"
        placeholder={isEn ? 'Search title, summary, field, tags...' : '搜尋標題、摘要、領域、標籤...'}
        autocomplete="off"
      />
      <p id="paper-reading-summary" class="article-meta" role="status" aria-live="polite"></p>
    </div>}
    {!isArchivePage && <nav class="paper-discovery-nav" aria-label={isEn ? 'Explore paper readings' : '探索論文精讀'}>
      <a href="#paper-library">{isEn ? 'Latest readings' : '最新精讀'}</a>
      <a href="#research-topics">{isEn ? 'Research topics' : '研究議題'}</a>
      <a href="#reading-paths">{isEn ? 'Reading paths' : '學習路徑'}</a>
    </nav>}
    {!isArchivePage && <noscript>
      <p class="article-meta">{isEn ? 'Search and filters require JavaScript. You can still browse every paper reading with the page links below.' : '搜尋與篩選需要 JavaScript。你仍可使用下方分頁連結瀏覽所有論文精讀。'}</p>
      <style is:inline>.paper-discovery-search, #paper-reading-filters, #paper-list-pagination { display: none !important; }</style>
    </noscript>}

    <section id="paper-library" class="hub-section paper-library">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{isEn ? 'READING LIBRARY' : 'READING LIBRARY'}</p>
          <h2>{isArchivePage ? (isEn ? `Paper archive — page ${currentPage}` : `論文精讀封存｜第 ${currentPage} 頁`) : (isEn ? 'Find a paper by engineering question' : '依工程問題尋找論文')}</h2>
        </div>
        <p>{isArchivePage
          ? (isEn ? `Showing notes ${pageStart + 1}–${pageStart + initialEntries.length} of ${entries.length}.` : `顯示第 ${pageStart + 1}–${pageStart + initialEntries.length} 篇，共 ${entries.length} 篇。`)
          : (isEn ? 'Filter by field, reading depth, or the paper’s publication year.' : '可依研究領域、閱讀難度或論文發表年份篩選。')}</p>
      </div>
      {!isArchivePage && <div class="filters" id="paper-reading-filters">
        <div class="filter-row">
          <label class="filter-label" for="filter-field">{lang === 'en' ? 'Field' : '領域'}</label>
          <select id="filter-field" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {fields.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
        <div class="filter-row">
          <label class="filter-label" for="filter-difficulty">{lang === 'en' ? 'Difficulty' : '難度'}</label>
          <select id="filter-difficulty" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {difficulties.map((d) => <option value={d}>{difficultyLabel(d)}</option>)}
          </select>
        </div>
        <div class="filter-row">
          <label class="filter-label" for="filter-year">{lang === 'en' ? 'Paper year' : '論文年份'}</label>
          <select id="filter-year" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>
        <button type="button" class="btn btn-secondary filter-reset" id="filter-reset">{lang === 'en' ? 'Reset' : '重設'}</button>
      </div>}
      {entries.length === 0 ? (
        <p class="article-meta">{lang === 'en' ? 'No paper reading posts yet.' : '目前尚無論文精讀文章。'}</p>
      ) : (
        <>
          <ul class="blog-list" id="paper-reading-list">
            {initialEntries.map((entry: PaperEntry) => (
              <PaperReadingListItem entry={entry} lang={lang} />
            ))}
          </ul>
          {!isArchivePage && entries.length > PAPER_INDEX_PAGE_SIZE && (
            <div class="paper-list-pagination" id="paper-list-pagination">
              <p class="paper-list-pagination-status" id="paper-list-status" role="status">
                {isEn ? `Showing ${initialEntries.length} of ${entries.length} notes` : `已顯示 ${initialEntries.length} / ${entries.length} 篇精讀`}
              </p>
              <button
                type="button"
                class="btn btn-secondary paper-list-more-btn"
                id="paper-list-more"
                data-next-page="2"
                data-total-pages={totalPages}
                data-total-count={entries.length}
              >
                {isEn ? 'Load more notes' : '載入更多筆記'}
              </button>
            </div>
          )}
          <ArchivePagination
            basePath="/paper-reading/"
            currentPage={currentPage}
            totalPages={totalPages}
            lang={lang}
            label={isEn ? 'Paper reading archive pages' : '論文精讀分頁'}
          />
        </>
      )}
    </section>

    {!isArchivePage && <section id="research-topics" class="hub-section research-topics" aria-labelledby="research-topics-title">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{isEn ? 'EXPLORE BY RESEARCH TOPIC' : '依研究議題探索'}</p>
          <h2 id="research-topics-title">{isEn ? 'Explore the library by research topic' : '依研究議題探索論文庫'}</h2>
        </div>
        <p>{isEn
          ? 'Daily notes remain below. These topic paths collect every relevant deep dive, even when a paper belongs to more than one engineering question.'
          : '每日新文章仍在下方；這些主題入口會收錄所有相關精讀，一篇論文也可以同時回答多個工程問題。'}</p>
      </div>

      <div class="research-topic-grid">
        {researchTopics.map((topic) => (
          <article class="research-topic-card">
            <div class="research-topic-card-head">
              <span>{topic.entries.length} {isEn ? 'notes' : '篇精讀'}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3><a href={toLocalizedPath(`/paper-reading/topics/${topic.id}/`, lang)}>{topic.title[lang]}</a></h3>
            <p>{topic.description[lang]}</p>
            <p class="research-topic-question"><strong>{isEn ? 'Question:' : '讀者問題：'}</strong>{topic.readerQuestion[lang]}</p>
            {topic.entries.length > 0 && (
              <ol class="research-topic-preview">
                {topic.entries.slice(0, 2).map((entry) => (
                  <li><a href={toLocalizedPath(`/paper-reading/${baseSlug(entry)}/`, lang)}>{entry.data.title}</a></li>
                ))}
              </ol>
            )}
            <a class="research-topic-link" href={toLocalizedPath(`/paper-reading/topics/${topic.id}/`, lang)}>
              {isEn ? 'View this topic' : '查看這個主題'} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>}

    {!isArchivePage && <section id="reading-paths" class="hub-section reading-paths" aria-labelledby="reading-paths-title">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{isEn ? 'START WITH A PATH' : 'START WITH A PATH'}</p>
          <h2 id="reading-paths-title">{isEn ? 'Choose the question you want to learn' : '先選問題，再選論文'}</h2>
        </div>
        <p>{isEn
          ? 'Three bounded routes turn the library into a sequence. Start at your level and stop when you have the engineering answer you need.'
          : '三條有限路徑把文章庫變成有順序的學習旅程；從適合的難度開始，讀到取得需要的工程答案即可。'}</p>
        <p>{isEn
          ? (
            <>
              If you already have ReAct through Reflexion in hand and need a spine for how those classics connect to later notes, start from the <a href={toLocalizedPath('/blog/91-agent-method-foundation-reading-map/', lang)}>How to Read AI Agent Papers: From CoT and WebGPT to ReAct</a> rather than Path 3. If you just finished DPR and Lewis RAG and need the retrieval spine onto leaves already on this site, use the <a href={toLocalizedPath('/blog/92-rag-method-foundation-reading-map/', lang)}>How to Read RAG Papers: From Dense Retrieval (DPR) to Lewis RAG</a> rather than treating Path 2 as that genealogy.
            </>
          )
          : (
            <>
              若你剛讀完 ReAct 到 Reflexion，需要一張脊椎圖說明這些經典怎麼接到站上後續精讀，請先看 <a href={toLocalizedPath('/blog/91-agent-method-foundation-reading-map/', lang)}>AI Agent 論文怎麼讀：從 CoT、WebGPT 到 ReAct</a>，不必從路徑三的 OSReward 清單開始。若你剛讀完 DPR 與 Lewis RAG，需要檢索脊椎接到站上已有葉子，請用 <a href={toLocalizedPath('/blog/92-rag-method-foundation-reading-map/', lang)}>RAG 論文怎麼讀：從向量檢索 DPR 到 Lewis RAG</a>，不要把路徑二當成那張家族圖。
            </>
          )}</p>
      </div>

      <div class="reading-path-grid">
        {readingPaths.map((path) => {
          const first = path.entries[0];
          return (
            <article class="reading-path-card" data-paper-path={path.id}>
              <div class="reading-path-card-head">
                <span class="reading-path-level">{path.level[lang]}</span>
                <span class="reading-path-count">{path.entries.length} {isEn ? 'reads' : '篇'}</span>
              </div>
              <h3>{path.title[lang]}</h3>
              <p>{path.description[lang]}</p>
              <ol class="reading-path-preview">
                {path.entries.slice(0, 3).map((entry) => <li>{entry.data.title}</li>)}
              </ol>
              {path.entries.length > 3 && (
                <p class="reading-path-more">+ {path.entries.length - 3} {isEn ? 'more steps' : '個後續步驟'}</p>
              )}
              {first && (
                <a
                  class="btn btn-secondary reading-path-start"
                  href={toLocalizedPath(`/paper-reading/${baseSlug(first)}/`, lang)}
                  data-paper-path-link={path.id}
                >
                  {isEn ? 'Start this path' : '從這裡開始'} <span aria-hidden="true">→</span>
                </a>
              )}
            </article>
          );
        })}
      </div>

      <div class="difficulty-guide" aria-label={isEn ? 'Difficulty guide' : '難度說明'}>
        <span><strong>{isEn ? 'Intro' : '入門'}</strong>{isEn ? ': problem and intuition' : '：先懂問題與直覺'}</span>
        <span><strong>{isEn ? 'Intermediate' : '中階'}</strong>{isEn ? ': method and experiments' : '：跟著方法與實驗'}</span>
        <span><strong>{isEn ? 'Advanced' : '進階'}</strong>{isEn ? ': evidence boundaries and adoption' : '：判讀證據邊界與採用條件'}</span>
      </div>
    </section>}

    <section class="projects-contact-strip">
      <div>
        <p class="section-kicker">{isEn ? 'RESEARCH EXCHANGE' : 'RESEARCH EXCHANGE'}</p>
        <h2>{isEn ? 'Turn a paper into an engineering discussion' : '把論文變成可以落地的工程討論'}</h2>
      </div>
      <a class="btn btn-primary" href={isEn ? '/en/contact/' : '/contact/'}>
        {isEn ? 'Speaking & contact' : '演講與聯絡'}
      </a>
    </section>
  </div>
</Layout>

{!isArchivePage && (<script is:inline>
  const root = document;
  const list = document.getElementById('paper-reading-list');
  const summary = document.getElementById('paper-reading-summary');
  const moreBtn = document.getElementById('paper-list-more');
  const statusEl = document.getElementById('paper-list-status');
  if (list) {
    const queryEl = root.querySelector('#filter-query');
    const fieldEl = root.querySelector('#filter-field');
    const difficultyEl = root.querySelector('#filter-difficulty');
    const yearEl = root.querySelector('#filter-year');
    const resetEl = document.getElementById('filter-reset');
    const isEn = document.documentElement.lang === 'en';

    const totalPages = Number(moreBtn?.getAttribute('data-total-pages') ?? '1');
    const totalCount = Number(moreBtn?.getAttribute('data-total-count') ?? '0');
    let nextPage = 2;
    let allPagesLoaded = nextPage > totalPages;

    const createPaperCard = (item) => {
      const li = document.createElement('li');
      li.className = 'blog-list-item';
      li.setAttribute('data-paper-reading-item', '1');
      li.setAttribute('data-year', item.year);
      li.setAttribute('data-field', item.field);
      li.setAttribute('data-difficulty', item.difficulty);
      li.setAttribute('data-search-text', item.searchText);

      let thumbHtml = '';
      if (item.image) {
        thumbHtml = `<a href="${item.href}" class="blog-list-thumb" aria-hidden="true" tabindex="-1"><img src="${item.image}" alt="" class="blog-list-thumb-img" width="200" height="125" loading="lazy" decoding="async" /></a>`;
      }

      let seriesHtml = '';
      if (item.series) {
        const seriesHref = isEn ? `/en/paper-reading/series/${item.series.id}/` : `/paper-reading/series/${item.series.id}/`;
        seriesHtml = `<a class="series-chip" href="${seriesHref}">${item.series.title}: Part ${item.series.part}</a><span class="meta-sep">,</span>`;
      }

      let diffHtml = '';
      if (item.difficulty) {
        diffHtml = `<span class="difficulty difficulty-${item.difficulty}">${item.difficultyLabel}</span>`;
      }

      let pathHtml = '';
      if (item.readingPathTitle) {
        pathHtml = `<span class="reading-path-chip">${item.readingPathTitle}</span>`;
      }

      let fieldHtml = '';
      if (item.field) {
        fieldHtml = `<span class="meta-sep">,</span><span>${item.field}</span>`;
      }

      const noteLabel = isEn ? 'Note' : '筆記';
      const paperLabel = isEn ? 'Paper' : '論文';
      const essenceSummary = isEn ? 'Understand it in 90 seconds' : '90 秒掌握這篇論文';
      const readFull = isEn ? 'Read the full deep dive' : '進入完整精讀';

      li.innerHTML = `
        ${thumbHtml}
        <div class="blog-list-body">
          <h3 class="blog-list-title"><a href="${item.href}">${item.title}</a></h3>
          <div class="paper-list-labels">
            ${diffHtml}
            ${pathHtml}
          </div>
          <div class="meta">
            ${seriesHtml}
            <span>${noteLabel}: ${item.formattedDate}</span>
            <span class="meta-sep">,</span>
            <span>${paperLabel}: ${item.year}</span>
            ${fieldHtml}
          </div>
          <p class="blog-list-desc">${item.description}</p>
          <details class="paper-essence" data-paper-essence="${item.slug}">
            <summary>${essenceSummary}</summary>
            <div class="paper-essence-content" data-essence-content>
              <a href="${item.href}" class="paper-essence-read" data-paper-next="essence">
                ${readFull} <span aria-hidden="true">→</span>
              </a>
            </div>
          </details>
        </div>
      `;
      return li;
    };

    const apply = () => {
      const query = (queryEl?.value ?? '').trim().toLowerCase();
      const field = fieldEl?.value ?? '';
      const difficulty = difficultyEl?.value ?? '';
      const year = yearEl?.value ?? '';
      let visibleCount = 0;

      const items = list.querySelectorAll('[data-paper-reading-item="1"]');
      items.forEach((el) => {
        const searchText = (el.getAttribute('data-search-text') ?? '').toLowerCase();
        const okQuery = !query || searchText.includes(query);
        const okField = !field || el.getAttribute('data-field') === field;
        const okDifficulty = !difficulty || el.getAttribute('data-difficulty') === difficulty;
        const okYear = !year || el.getAttribute('data-year') === year;
        const visible = okQuery && okField && okDifficulty && okYear;
        el.style.display = visible ? '' : 'none';
        if (visible) visibleCount += 1;
      });

      if (summary) {
        summary.textContent = isEn ? `${visibleCount} result(s)` : `共 ${visibleCount} 篇文章`;
      }
    };

    const loadNextPage = () => {
      if (nextPage > totalPages || moreBtn?.disabled) return Promise.resolve();
      if (moreBtn) moreBtn.disabled = true;

      const url = isEn ? `/en/paper-reading/data/${nextPage}.json` : `/paper-reading/data/${nextPage}.json`;
      return fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((items) => {
          const fragment = document.createDocumentFragment();
          items.forEach((item) => {
            fragment.appendChild(createPaperCard(item));
          });
          list.appendChild(fragment);
          nextPage += 1;
          const currentCount = list.querySelectorAll('[data-paper-reading-item="1"]').length;
          if (statusEl) {
            statusEl.textContent = isEn ? `Showing ${currentCount} of ${totalCount} notes` : `已顯示 ${currentCount} / ${totalCount} 篇精讀`;
          }
          if (nextPage > totalPages) {
            allPagesLoaded = true;
            if (moreBtn) moreBtn.style.display = 'none';
          }
          apply();
        })
        .catch((err) => {
          console.error(err);
        })
        .finally(() => {
          if (moreBtn) moreBtn.disabled = false;
        });
    };

    if (moreBtn) {
      moreBtn.addEventListener('click', loadNextPage);
    }

    let loadAllPromise = null;
    const ensureAllPagesLoaded = () => {
      if (allPagesLoaded) return Promise.resolve();
      if (loadAllPromise) return loadAllPromise;

      const pagePromises = [];
      for (let p = nextPage; p <= totalPages; p++) {
        const url = isEn ? `/en/paper-reading/data/${p}.json` : `/paper-reading/data/${p}.json`;
        pagePromises.push(fetch(url).then((res) => (res.ok ? res.json() : [])));
      }

      loadAllPromise = Promise.all(pagePromises)
        .then((pages) => {
          const fragment = document.createDocumentFragment();
          pages.forEach((items) => {
            items.forEach((item) => {
              fragment.appendChild(createPaperCard(item));
            });
          });
          list.appendChild(fragment);
          allPagesLoaded = true;
          nextPage = totalPages + 1;
          if (moreBtn) moreBtn.style.display = 'none';
          if (statusEl) {
            statusEl.textContent = isEn ? `Showing ${totalCount} of ${totalCount} notes` : `已顯示 ${totalCount} / ${totalCount} 篇精讀`;
          }
          apply();
        })
        .catch((err) => {
          loadAllPromise = null;
          console.error(err);
        });

      return loadAllPromise;
    };

    const onFilterInput = () => {
      const query = (queryEl?.value ?? '').trim();
      const field = fieldEl?.value ?? '';
      const difficulty = difficultyEl?.value ?? '';
      const year = yearEl?.value ?? '';

      if ((query || field || difficulty || year) && !allPagesLoaded) {
        ensureAllPagesLoaded()?.then(apply);
      }
      apply();
    };

    queryEl?.addEventListener('input', onFilterInput);
    fieldEl?.addEventListener('change', onFilterInput);
    difficultyEl?.addEventListener('change', onFilterInput);
    yearEl?.addEventListener('change', onFilterInput);

    resetEl?.addEventListener('click', () => {
      if (queryEl) queryEl.value = '';
      if (fieldEl) fieldEl.value = '';
      if (difficultyEl) difficultyEl.value = '';
      if (yearEl) yearEl.value = '';
      apply();
    });

    let essencePromise = null;
    const loadEssenceMap = () => {
      if (!essencePromise) {
        const url = isEn ? '/en/paper-reading/data/essence.json' : '/paper-reading/data/essence.json';
        essencePromise = fetch(url)
          .then((res) => {
            if (!res.ok) throw new Error('Failed to load essence');
            return res.json();
          })
          .catch((err) => {
            essencePromise = null;
            throw err;
          });
      }
      return essencePromise;
    };

    list.addEventListener('toggle', (event) => {
      const details = event.target;
      if (!details || !details.matches || !details.matches('details.paper-essence') || !details.open) return;
      const content = details.querySelector('[data-essence-content]');
      if (!content || content.querySelector('dl')) return;

      const slug = details.getAttribute('data-paper-essence');
      if (!slug) return;

      loadEssenceMap()
        .then((essenceMap) => {
          if (content.querySelector('dl')) return;
          const points = essenceMap[slug];
          if (points && points.length > 0) {
            const dl = document.createElement('dl');
            points.forEach((point) => {
              const div = document.createElement('div');
              const dt = document.createElement('dt');
              dt.textContent = point.label;
              const dd = document.createElement('dd');
              dd.textContent = point.text;
              div.appendChild(dt);
              div.appendChild(dd);
              dl.appendChild(div);
            });
            const readLink = content.querySelector('.paper-essence-read');
            if (readLink) {
              content.insertBefore(dl, readLink);
            } else {
              content.appendChild(dl);
            }
          }
        })
        .catch(() => {});
    }, true);

    apply();
  }
</script>)}

