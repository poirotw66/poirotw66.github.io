---
import type { MarkdownHeading } from 'astro';
import ArticleToc from './ArticleToc.astro';

interface Props {
  showToc: boolean;
  tocHeadings: readonly MarkdownHeading[];
  tocLabel: string;
  progressLabel: string;
  copyLabel: string;
  copiedLabel: string;
  variant?: 'article' | 'project';
  wideHeader?: boolean;
  tocCompact?: boolean;
  tocLabels?: Record<string, string>;
  wideProse?: boolean;
}

const {
  showToc,
  tocHeadings,
  tocLabel,
  progressLabel,
  copyLabel,
  copiedLabel,
  variant = 'article',
  wideHeader = false,
  tocCompact = false,
  tocLabels,
  wideProse = false,
} = Astro.props;
const hasSummary = Astro.slots.has('summary');
const hasFooter = Astro.slots.has('footer');
---

<div
  class:list={[
    'article-layout',
    'article-body',
    `article-layout--${variant}`,
    {
      'article-layout--with-toc': showToc,
      'article-layout--wide-header': wideHeader,
      'article-layout--wide-prose': wideProse,
    },
  ]}
  data-article-reader
  data-copy-label={copyLabel}
  data-copied-label={copiedLabel}
>
  <div
    class="article-reading-progress"
    role="progressbar"
    aria-label={progressLabel}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <span data-reading-progress-fill></span>
  </div>
  <div class="article-header">
    <slot name="header" />
  </div>
  {hasSummary && (
    <div class="article-summary">
      <slot name="summary" />
    </div>
  )}
  {showToc && (
    <aside class="article-sidebar">
      <ArticleToc headings={tocHeadings} label={tocLabel} compact={tocCompact} labels={tocLabels} />
    </aside>
  )}
  <div class="article-content">
    <slot />
  </div>
  {hasFooter && (
    <div class="article-footer">
      <slot name="footer" />
    </div>
  )}
  {showToc && <script src="/js/article-toc-scroll.js" defer></script>}
  <script src="/js/article-reader.js" defer></script>
</div>

<style is:global>
  @media (min-width: 1100px) {
    .article-layout.article-layout--wide-prose .article-content {
      max-width: min(84ch, 100%);
    }
  }
</style>
