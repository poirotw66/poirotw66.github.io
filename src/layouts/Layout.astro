---
import { getAlternatePath, getHtmlLang, toLocalizedPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  /** Optional OG image URL (absolute). Defaults to site + /og.webp */
  imageURL?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** 'website' | 'article'. Use 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** For article: ISO date string. Enables og:article:published_time */
  articlePublishedTime?: string;
  /** For article: ISO date string. Enables og:article:modified_time */
  articleModifiedTime?: string;
  /** For article: author name. Enables og:article:author */
  articleAuthor?: string;
  lang: Lang;
  /** Optional page-level class for route-specific visual treatments. */
  bodyClass?: string;
}

const props = Astro.props as Props;
const { lang } = props;
const pageCss =
  props.bodyClass?.includes('page-home')
    ? 'home'
    : props.bodyClass?.includes('page-article')
      ? 'article'
      : 'hub';
const defaultDescription =
  lang === 'en'
    ? 'Bloss0m is a practical publication for enterprise AI, agents, and RAG — covering technical trends, architecture, engineering trade-offs, and production delivery.'
    : 'Bloss0m 是企業 AI、Agent 與 RAG 工程實戰媒體，追蹤技術趨勢、拆解系統架構，分享從 PoC 到正式上線的方法與案例。';
const siteJsonLdDescription =
  lang === 'en'
    ? 'Practical enterprise AI, agent, and RAG engineering — from technical trends and architecture to production delivery.'
    : '企業 AI、Agent 與 RAG 工程實戰：從技術趨勢、架構設計到正式上線。';

const { title, description = defaultDescription, canonicalURL, imageURL, imageAlt, imageWidth = 1200, imageHeight = 630, ogType = 'website', articlePublishedTime, articleModifiedTime, articleAuthor, bodyClass } = props;
const site = Astro.site ?? new URL('https://poirotw66.github.io');
const canonical = canonicalURL ?? new URL(toLocalizedPath(Astro.url.pathname, lang), site);
const ogImage = imageURL ?? new URL('/og.webp', site).toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const siteUrl = site.toString().replace(/\/$/, '');
const t = useTranslations(lang);
const localizedPath = toLocalizedPath(Astro.url.pathname, lang);
const zhPath = toLocalizedPath(Astro.url.pathname, 'zh');
const enPath = toLocalizedPath(Astro.url.pathname, 'en');
const langToggleHref = getAlternatePath(Astro.url.pathname, lang);

const primaryNavLinks = [
  { href: '/projects/', key: 'nav.projects' },
  { href: '/blog/', key: 'nav.blog' },
  { href: '/paper-reading/', key: 'nav.paperReading' },
  { href: '/search/', key: 'nav.search' },
  { href: '/contact/', key: 'nav.contact' },
] as const;

const footerNavLinks = [
  { href: '/lab/', key: 'nav.lab' },
] as const;
---

<!DOCTYPE html>
<html lang={getHtmlLang(lang)} data-theme="warm">
  <head>
    <!-- Google tag (gtag.js) -->
    <script defer src="https://www.googletagmanager.com/gtag/js?id=G-FKETRDJWMH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FKETRDJWMH');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/brand/bloom-mark-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/brand/bloom-mark-180.png" sizes="180x180" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt ?? (lang === 'en' ? 'Bloss0m — Enterprise AI, Agent & RAG Engineering' : 'Bloss0m — 企業 AI、Agent 與 RAG 工程實戰')} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_Hant' : 'en_US'} />
    <meta property="og:site_name" content="Bloss0m" />
    {ogType === 'article' && articlePublishedTime && <meta property="og:article:published_time" content={articlePublishedTime} />}
    {ogType === 'article' && articleModifiedTime && <meta property="og:article:modified_time" content={articleModifiedTime} />}
    {ogType === 'article' && articleAuthor && <meta property="og:article:author" content={articleAuthor} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? (lang === 'en' ? 'Bloss0m — Enterprise AI, Agent & RAG Engineering' : 'Bloss0m — 企業 AI、Agent 與 RAG 工程實戰')} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="zh-Hant" href={`${siteUrl}${zhPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${zhPath}`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: 'Bloss0m',
          description: siteJsonLdDescription,
          publisher: { '@id': `${siteUrl}/#organization` },
          author: { '@id': `${siteUrl}/#person` },
          inLanguage: getHtmlLang(lang),
        },
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: 'Bloss0m',
          url: siteUrl,
          logo: { '@type': 'ImageObject', url: new URL('/brand/bloom-mark-1024.webp', site).toString() },
          founder: { '@id': `${siteUrl}/#person` },
        },
        {
          '@type': 'Person',
          '@id': `${siteUrl}/#person`,
          name: 'Justin',
          alternateName: 'Bloss0m',
          url: `${siteUrl}${toLocalizedPath('/contact/', lang)}`,
          jobTitle: lang === 'en' ? 'AI Platform & Agentic AI Engineer' : 'AI 平台與 Agentic AI 工程師',
          sameAs: [
            'https://github.com/poirotw66',
            'https://www.linkedin.com/in/wei-cyun-chang-23a882219/',
          ],
        },
      ],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=optional" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    {(pageCss === 'home' || pageCss === 'hub') && <link rel="stylesheet" href="/css/preview.css" />}
    <link rel="stylesheet" href={`/css/${pageCss}.css`} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">{t('skipToMain')}</a>
    <nav class="nav" aria-label={t('nav.landmark')}>
      <div class="nav-inner">
        <a href={toLocalizedPath('/', lang)} class="nav-logo" aria-label={lang === 'en' ? 'Bloss0m home' : 'Bloss0m 首頁'}>
          <img src="/brand/bloom-mark.webp" alt="" width="32" height="32" class="brand-mark" decoding="async" />
          <span>Bloss0m</span>
        </a>
        <div class="nav-right">
          <div class="theme-switcher" role="group" aria-label="Theme">
            <button type="button" data-theme-btn="dark" aria-pressed="false" class="theme-btn">{t('theme.dark')}</button>
            <button type="button" data-theme-btn="warm" aria-pressed="true" class="theme-btn theme-btn-active">{t('theme.warm')}</button>
          </div>
          <div class="lang-switcher">
            <a href={lang === 'zh' ? langToggleHref : localizedPath} aria-label={`${t('lang.enShort')} — ${t('lang.enLabel')}`} aria-current={lang === 'en' ? 'page' : undefined}>{t('lang.enShort')}</a>
            <a href={lang === 'en' ? langToggleHref : localizedPath} aria-label={`${t('lang.zhShort')} — ${t('lang.zhLabel')}`} aria-current={lang === 'zh' ? 'page' : undefined}>{t('lang.zhShort')}</a>
          </div>
        </div>
        <button
          type="button"
          class="nav-menu-toggle"
          aria-expanded="false"
          aria-controls="primary-nav-menu"
          aria-label={t('nav.menuButton')}
        >
          <span class="nav-menu-toggle-bars" aria-hidden="true"></span>
        </button>
        <div id="primary-nav-menu" class="nav-menu-panel">
          <ul class="nav-links">
            {primaryNavLinks.map(({ href, key }) => {
              const hrefNorm = href === '/' ? '/' : href.replace(/\/$/, '');
              const isCurrent = localizedPath.replace(/\/$/, '') === hrefNorm || (hrefNorm !== '/' && localizedPath.startsWith(hrefNorm));
              return (
                <li>
                  <a href={toLocalizedPath(href, lang)} aria-current={isCurrent ? 'page' : undefined}>{t(key)}</a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </nav>
    <main id="main" class="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="site-footer-brand">
          <img src="/brand/bloom-mark.webp" alt="" width="36" height="36" class="brand-mark" loading="lazy" decoding="async" />
          <span>Bloss0m</span>
        </p>
        <nav class="site-footer-nav" aria-label={t('footer.secondaryNav')}>
          <ul class="site-footer-links">
            {footerNavLinks.map(({ href, key }) => (
              <li>
                <a href={toLocalizedPath(href, lang)}>{t(key)}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="site-footer-note">{t('footer.note')}</p>
      </div>
    </footer>
    <script is:inline src="/js/theme.js" defer></script>
  </body>
</html>
