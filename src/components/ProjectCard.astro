---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  viewLabel?: string;
}

const { entry, viewLabel = 'View project' } = Astro.props;
---

<div class="showcase-card">
  <h3>{entry.data.title}</h3>
  
  {entry.data.impact && (
    <p class="showcase-impact">{entry.data.impact}</p>
  )}
  <p>{entry.data.description}</p>
  <a href={`/projects/${entry.id}/`} class="btn btn-secondary">{viewLabel}</a>
</div>
