---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { sortByPubDate, getFeaturedProjects, getLabProjects } from '../../utils/sort';
import { groupLabProjectsByZone } from '../../utils/labZone';
import { toLocalizedPath } from '../../i18n/utils';
import ProjectCard from '../ProjectCard.astro';
import StickerCard from '../StickerCard.astro';
import PaperPreviewItem from '../PaperPreviewItem.astro';
import CtaBlock from '../CtaBlock.astro';
import SectionHeading from '../SectionHeading.astro';
import SectionIntro from '../SectionIntro.astro';
import HomeWritingLane from '../HomeWritingLane.astro';
import HomeSectionNav from '../HomeSectionNav.astro';
import HomeStartHere from '../HomeStartHere.astro';
import {
  BLOG_LANE_COPY,
  BLOG_WRITING_SECTION_COPY,
  getLanePreviewPosts,
} from '../../utils/blogLanes';
import { resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const HOME_LIST_LIMIT = 3;

const allBlogPosts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const engineeringPreview = getLanePreviewPosts(allBlogPosts, 'engineering');
const pulsePreview = getLanePreviewPosts(allBlogPosts, 'pulse');
const starterPreview = getLanePreviewPosts(allBlogPosts, 'starter', { featured: 1, compact: 2 });
const writingLanes = [
  { id: 'starter' as const, preview: starterPreview },
  { id: 'engineering' as const, preview: engineeringPreview },
  { id: 'pulse' as const, preview: pulsePreview },
];
const paperReadings = sortByPubDate(resolveEntriesForLang(await getCollection('paperReading'), lang)).slice(0, HOME_LIST_LIMIT);
const stickers = sortByPubDate(resolveEntriesForLang(await getCollection('stickers'), lang)).slice(0, 4);
const allProjectEntries = resolveEntriesForLang(await getCollection('projects'), lang);
const projects = getFeaturedProjects(allProjectEntries, HOME_LIST_LIMIT);
const labProjects = getLabProjects(allProjectEntries);
const labByZone = groupLabProjectsByZone(allProjectEntries);
const labPreviewIds = new Set<string>();
const labPreview: typeof allProjectEntries = [];
for (const entry of [labByZone.competition[0], labByZone.creative[0], ...labProjects]) {
  if (!entry || labPreviewIds.has(baseSlug(entry))) continue;
  labPreviewIds.add(baseSlug(entry));
  labPreview.push(entry);
  if (labPreview.length >= 2) break;
}
const stickerPreview = stickers.slice(0, 2);
const spotlightProject = projects.find((entry) => baseSlug(entry) === 'agentic-rag') ?? projects[0];
const spotlightHref = spotlightProject
  ? toLocalizedPath(`/projects/${baseSlug(spotlightProject)}/`, lang)
  : toLocalizedPath('/projects/', lang);
const isEn = lang === 'en';

const pageDescription =
  lang === 'en'
    ? 'Bloss0m is a practical publication for enterprise AI, agents, and RAG — from technical trends and architecture to production delivery.'
    : 'Bloss0m 是企業 AI、Agent 與 RAG 工程實戰媒體，追蹤重要趨勢、拆解架構與工程方法，分享從 PoC 到正式上線的真實經驗。';

const hero = isEn
  ? {
      eyebrow: 'Enterprise AI · Agents · RAG',
      title: 'Practical engineering for enterprise AI, agents, and RAG.',
      tagline: 'Track important AI shifts, unpack the architecture, and turn promising prototypes into systems teams can run.',
      pullQuote:
        'Engineering you can verify in public repos and posts — systems designed for operators, not slide decks.',
      lead:
        'I help teams turn promising GenAI ideas into production-ready systems, from enterprise RAG and agent workflows to real-time and multimodal applications with clear architecture, measurable outcomes, and deployment readiness.',
      primaryCta: 'Start reading',
      primaryHref: toLocalizedPath('/blog/?lane=starter', lang),
      secondaryCta: 'View case studies',
      secondaryHref: '#showcase',
      proof: [
        'Experience building enterprise OCR and document intelligence systems',
        'RAG, agents, multimodal pipelines, and enterprise API integration',
        'From architecture design to deployment and operational handoff',
      ],
      signalTitle: 'Four core topics',
      signals: [
        { title: 'AI Agent in practice', body: 'Architectures, tools, memory, evaluation, security, and multi-agent coordination.', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: 'Explore AI agents →' },
        { title: 'Enterprise RAG', body: 'Retrieval architecture, hybrid search, evaluation, knowledge governance, and real delivery cases.', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: 'Explore enterprise RAG →' },
        { title: 'AI Engineering', body: 'Harnesses, observability, guardrails, cost, latency, and production platform design.', href: toLocalizedPath('/blog/?lane=engineering', lang), cta: 'Explore AI engineering →' },
        { title: 'AI trends, unpacked', body: 'Model releases, technical papers, and industry signals translated into engineering implications.', href: toLocalizedPath('/blog/?lane=pulse', lang), cta: 'Explore trend analysis →' },
      ],
      showcaseTitle: 'Featured Case Studies',
      showcaseLink: 'View all',
      blogTitle: 'Latest Insights',
      paperTitle: 'Paper Reading',
      labTitle: 'Creative Lab',
      labSubtitle: 'Competitions · side projects',
      stickerTitle: 'LINE Stickers',
      stickerSubtitle: 'Original sets · LINE Store',
      labLink: 'View all',
      stickerTools: 'Make your own (3 tools)',
      stickerLink: 'View all',
      ctaText: 'If you are evaluating an AI platform, agent workflow, or enterprise RAG initiative, I can help move it from prototype to a system your team can actually operate.',
      ctaButton: 'Start a conversation',
      spotlightLabel: 'Flagship Case',
      spotlightButton: 'Read case study',
      spotlightMetaLabel: 'Impact',
      kickerSignals: 'Focus',
      kickerShowcase: 'Projects',
      kickerBlog: 'Writing',
      kickerPaper: 'Papers',
      kickerLab: 'Lab',
      kickerStickers: 'Stickers',
      exploreTitle: 'Lab & creative side projects',
      exploreKicker: 'More',
      startHereTitle: 'New here? Start here',
      startHerePaths: [
        { label: 'Understand AI agents → Practical guides', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang) },
        { label: 'Build enterprise RAG → Architecture & cases', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang) },
        { label: 'Ship an AI PoC → Engineering notes', href: toLocalizedPath('/blog/?lane=engineering', lang) },
        { label: 'Follow AI engineering → Trend analysis', href: toLocalizedPath('/blog/?lane=pulse', lang) },
      ],
      writingGuide: 'Not sure where to begin? Start with curated picks.',
    }
  : {
      eyebrow: '企業 AI · Agent · RAG',
      title: '企業 AI、Agent 與 RAG 的實戰技術媒體',
      tagline: '追蹤重要 AI 趨勢，拆解架構與工程方法，分享從 PoC 到正式上線的真實經驗。',
      pullQuote: '用公開的專案與文章讓技術深度可被驗證；設計上優先考慮維運與交付，而不是簡報規格。',
      lead:
        '我協助團隊把有潛力的 GenAI 構想落成可交付的產品與平台，涵蓋企業級 RAG、多代理工作流、即時與多模態 AI 應用，從架構、資料流程、API 到部署整合一路打通。',
      primaryCta: '開始閱讀',
      primaryHref: toLocalizedPath('/blog/?lane=starter', lang),
      secondaryCta: '查看專案案例',
      secondaryHref: '#showcase',
      proof: [
        '具企業 OCR 與文件智能系統實務經驗',
        '聚焦 RAG、Agent、多模態流程與企業 API 整合',
        '從系統架構到部署交付，強調可維運、可擴展、可交接',
      ],
      signalTitle: '四大核心專題',
      signals: [
        { title: 'AI Agent 實戰', body: '架構、工具、記憶、評測、安全治理與多代理協作。', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: '探索 AI Agent →' },
        { title: 'Enterprise RAG', body: '檢索架構、Hybrid Search、評估、知識治理與真實落地案例。', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: '探索企業 RAG →' },
        { title: 'AI Engineering', body: 'Harness、可觀測性、Guardrails、成本延遲與正式環境平台設計。', href: toLocalizedPath('/blog/?lane=engineering', lang), cta: '探索 AI Engineering →' },
        { title: 'AI 趨勢拆解', body: '將模型發布、技術白皮書與產業訊號，轉化成工程與企業決策觀點。', href: toLocalizedPath('/blog/?lane=pulse', lang), cta: '探索趨勢解析 →' },
      ],
      showcaseTitle: '代表案例與精選專案',
      showcaseLink: '看全部',
      blogTitle: '最新觀點與實作',
      paperTitle: '論文精讀',
      labTitle: '實驗室',
      labSubtitle: '競賽專區 · 創意實驗',
      stickerTitle: 'LINE 貼圖',
      stickerSubtitle: '原創貼圖 · 小舖上架',
      labLink: '看全部',
      stickerTools: '用 3 個開源工具自己做貼圖',
      stickerLink: '看全部',
      ctaText: '如果你正在評估 AI 平台、Agent 工作流或企業 RAG 專案，我可以協助你把 PoC 推進成團隊真的能用、能維運、能擴展的系統。',
      ctaButton: '開始聊聊',
      spotlightLabel: '旗艦案例',
      spotlightButton: '閱讀案例',
      spotlightMetaLabel: '成效',
      kickerSignals: '重點 · Focus',
      kickerShowcase: '專案 · Projects',
      kickerBlog: '觀點 · Writing',
      kickerPaper: '精讀 · Papers',
      kickerLab: '實驗 · Lab',
      kickerStickers: '貼圖 · LINE',
      exploreTitle: '實驗室與創意副線',
      exploreKicker: '更多',
      startHereTitle: '第一次來？從這裡開始',
      startHerePaths: [
        { label: '我想了解 AI Agent → 實戰指南', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang) },
        { label: '我想建立企業 RAG → 架構與案例', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang) },
        { label: '我想把 AI PoC 上線 → 工程實作', href: toLocalizedPath('/blog/?lane=engineering', lang) },
        { label: '我想追蹤 AI 工程趨勢 → 趨勢拆解', href: toLocalizedPath('/blog/?lane=pulse', lang) },
      ],
      writingGuide: '不確定從哪讀？先從「精選入門」開始',
    };
---

<Layout
  title={isEn ? 'Bloss0m | Enterprise AI, Agent & RAG Engineering' : 'Bloss0m｜企業 AI、Agent 與 RAG 工程實戰'}
  description={pageDescription}
  lang={lang}
  bodyClass="page-home"
>
  <>
    <section id="hero" class="home-hero section-reveal home-scroll-anchor">
      <div class="home-hero-grid">
        <div class="home-hero-copy surface-raised">
          <p class="hero-eyebrow">{hero.eyebrow}</p>
          <h1 class="hero-title">{hero.title}</h1>
          <p class="hero-tagline">{hero.tagline}</p>
          <p class="hero-lead">{hero.lead}</p>
          <div class="btn-group hero-actions">
            <a href={hero.primaryHref} class="btn btn-primary">{hero.primaryCta}</a>
            <a href={hero.secondaryHref} class="btn btn-secondary">{hero.secondaryCta}</a>
          </div>
          <HomeStartHere title={hero.startHereTitle} paths={hero.startHerePaths} />
          <ul class="hero-proof-list">
            {hero.proof.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <HomeSectionNav lang={lang} />
        </div>

        {spotlightProject && (
          <aside class="hero-spotlight surface-raised">
            <p class="hero-spotlight-label">{hero.spotlightLabel}</p>
            {spotlightProject.data.image && (
              <a href={spotlightHref} class="hero-spotlight-media surface-inset">
                <Image
                  src={spotlightProject.data.image}
                  alt={spotlightProject.data.title}
                  width="640"
                  height="400"
                  format="webp"
                  quality={80}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </a>
            )}
            <div class="hero-spotlight-body">
              <h2>
                <a href={spotlightHref}>{spotlightProject.data.title}</a>
              </h2>
              {spotlightProject.data.subtitle && <p class="hero-spotlight-subtitle">{spotlightProject.data.subtitle}</p>}
              {spotlightProject.data.impact && (
                <p class="hero-spotlight-impact">
                  <span>{hero.spotlightMetaLabel}</span>
                  {spotlightProject.data.impact}
                </p>
              )}
              {spotlightProject.data.description && <p class="hero-spotlight-description">{spotlightProject.data.description}</p>}
              {spotlightProject.data.metrics && spotlightProject.data.metrics.length > 0 && (
                <div class="hero-metrics">
                  {spotlightProject.data.metrics.slice(0, 3).map((metric) => (
                    <span>{metric}</span>
                  ))}
                </div>
              )}
              <a href={spotlightHref} class="btn btn-secondary">{hero.spotlightButton}</a>
            </div>
          </aside>
        )}
      </div>
    </section>

    <blockquote id="quote" class="home-pull-quote section-reveal home-scroll-anchor">
      <p>{hero.pullQuote}</p>
    </blockquote>

    <section id="focus" class="section-reveal home-signals home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerSignals} title={hero.signalTitle} index="01" />
      <div class="pillars tile-grid surface-inset home-section-body">
        {hero.signals.map((signal, index) => (
          <article class="pillar-card pillar-card-strong">
            <span class="pillar-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{signal.title}</h3>
            <p>{signal.body}</p>
            <a class="section-cta" href={signal.href}>{signal.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section id="showcase" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerShowcase} title={hero.showcaseTitle} index="02" />
      <div class="showcase surface-inset home-section-body">
        {projects.map((entry) => (
          <ProjectCard entry={entry} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="writing" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading
        kicker={isEn ? BLOG_WRITING_SECTION_COPY.kicker.en : BLOG_WRITING_SECTION_COPY.kicker.zh}
        title={isEn ? BLOG_WRITING_SECTION_COPY.title.en : BLOG_WRITING_SECTION_COPY.title.zh}
        index="03"
      />
      <SectionIntro lead={isEn ? BLOG_WRITING_SECTION_COPY.lead.en : BLOG_WRITING_SECTION_COPY.lead.zh} />

      <p class="home-writing-guide">{hero.writingGuide}</p>

      <div class="home-writing-tabs" id="home-writing-tabs">
        <div class="home-writing-tablist" role="tablist" aria-label={isEn ? 'Writing lanes' : '觀點分類'}>
          {writingLanes.map(({ id }, index) => (
            <button
              type="button"
              class:list={['home-writing-tab', { 'is-active': index === 0 }]}
              id={`writing-tab-${id}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`writing-${id}`}
              data-lane={id}
            >
              {isEn ? BLOG_LANE_COPY[id].title.en : BLOG_LANE_COPY[id].title.zh}
            </button>
          ))}
        </div>

        <div class="home-writing-panels surface-inset home-section-body">
          {writingLanes.map(({ id, preview }, index) => (
            <HomeWritingLane
              laneId={id}
              lang={lang}
              featured={preview.featured}
              compact={preview.compact}
              active={index === 0}
            />
          ))}
        </div>
      </div>

      <p class="text-center-mt">
        <a href={toLocalizedPath('/blog/', lang)} class="btn btn-secondary">
          {isEn ? BLOG_WRITING_SECTION_COPY.topCta.en : BLOG_WRITING_SECTION_COPY.topCta.zh}
        </a>
      </p>
    </section>

    <section id="papers" class="section-reveal home-scroll-anchor home-section-shell surface-raised">
      <SectionHeading kicker={hero.kickerPaper} title={hero.paperTitle} index="04" />
      <div class="blog-preview surface-inset home-section-body">
        {paperReadings.map((entry) => (
          <PaperPreviewItem entry={entry} lang={lang} />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/paper-reading/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="explore" class="section-reveal home-scroll-anchor home-explore home-section-shell surface-raised">
      <SectionHeading kicker={hero.exploreKicker} title={hero.exploreTitle} index="05" />
      <div class="home-explore-grid tile-grid surface-inset home-section-body">
        <div class="home-explore-panel home-explore-panel--lab">
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.labTitle}</h3>
            <p class="home-explore-panel-desc">{hero.labSubtitle}</p>
          </div>
          {labPreview.length > 0 && (
            <div class="home-explore-cards">
              {labPreview.map((entry) => (
                <ProjectCard entry={entry} lang={lang} />
              ))}
            </div>
          )}
          <p class="home-explore-actions">
            <a href={toLocalizedPath('/lab/#competition', lang)} class="btn btn-secondary">
              {isEn ? 'Competitions' : '競賽專區'}
            </a>
            <a href={toLocalizedPath('/lab/', lang)} class="btn btn-secondary">{hero.labLink}</a>
          </p>
        </div>
        <div class="home-explore-panel home-explore-panel--stickers">
          <div class="home-explore-panel-head">
            <h3 class="home-explore-panel-title">{hero.stickerTitle}</h3>
            <p class="home-explore-panel-desc">{hero.stickerSubtitle}</p>
          </div>
          {stickerPreview.length > 0 && (
            <div class="home-explore-cards">
              {stickerPreview.map((entry) => (
                <StickerCard
                  entry={entry}
                  lang={lang}
                  lineStoreLabel={isEn ? 'LINE Store' : '貼圖小舖'}
                  exploreLayout
                  showStoreLink={false}
                />
              ))}
            </div>
          )}
          <p class="home-explore-actions">
            <a href={toLocalizedPath('/stickers/', lang)} class="btn btn-secondary">{hero.stickerLink}</a>
          </p>
        </div>
      </div>
    </section>

    <CtaBlock id="cta" text={hero.ctaText} buttonText={hero.ctaButton} buttonHref={toLocalizedPath('/contact/', lang)} />
    <script src="/js/home-scroll-hash.js" defer></script>
    <script src="/js/home-writing-tabs.js" defer></script>
  </>
</Layout>
