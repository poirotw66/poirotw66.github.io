{
  "name": "poirotw66.github.io",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run generate:covers",
    "dev": "astro dev",
    "check:tags": "node --experimental-strip-types scripts/validate-tags.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:markdown-emphasis": "node scripts/validate-markdown-emphasis.mjs",
    "check:blog-format": "node scripts/validate-blog-format.mjs",
    "check:reading-quality": "node scripts/validate-reading-quality.mjs",
    "check:paper-topics": "node scripts/validate-paper-topics.mjs",
    "check:i18n": "node scripts/validate-i18n.mjs",
    "check:english-purity": "node scripts/validate-english-purity.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:skills": "node scripts/validate-project-skills.mjs",
    "check:blog-radar": "node skills/bloss0m-frontier-watch/scripts/validate-blog-radar.mjs",
    "check:paper-radar": "node skills/bloss0m-frontier-watch/scripts/validate-paper-radar.mjs",
    "check:editorial-reviews": "node skills/bloss0m-frontier-watch/scripts/validate-editorial-reviews.mjs",
    "check:editorial-radar": "npm run check:blog-radar && npm run check:paper-radar && npm run check:editorial-reviews",
    "audit:paper-pair": "node skills/publish-bilingual-paper-reading/scripts/audit-paper-pair.mjs",
    "audit:paper-comprehension": "node skills/publish-bilingual-paper-reading/scripts/audit-paper-comprehension.mjs",
    "check:paper-figures": "node skills/publish-bilingual-paper-reading/scripts/audit-paper-figures.mjs --strict --all --min-body-figures 1",
    "check:paper-figures:new": "node skills/publish-bilingual-paper-reading/scripts/audit-paper-figures.mjs --strict --min-body-figures 3",
    "check:paper-publication": "npm run check:paper-figures && npm run audit:paper-pair -- --strict --all && npm run audit:paper-comprehension -- --strict --all",
    "test:tags": "node --test --experimental-strip-types scripts/validate-tags.test.mjs",
    "test:content": "node --test scripts/validate-content.test.mjs",
    "test:markdown-emphasis": "node --test scripts/validate-markdown-emphasis.test.mjs",
    "test:markdown-emphasis-normalizer": "node --test scripts/normalize-markdown-emphasis.test.mjs",
    "test:blog-format": "node --test scripts/validate-blog-format.test.mjs",
    "test:blog-index": "node --test --experimental-strip-types src/utils/blogIndexData.test.ts",
    "test:reading-quality": "node --test scripts/validate-reading-quality.test.mjs",
    "test:paper-comprehension": "node --test skills/publish-bilingual-paper-reading/scripts/audit-paper-comprehension.test.mjs",
    "test:paper-essence": "node --test --experimental-strip-types src/utils/paperEssence.test.ts",
    "test:paper-paths": "node --test --experimental-strip-types src/data/paperReadingPaths.test.ts",
    "test:paper-topics": "node --test scripts/validate-paper-topics.test.mjs",
    "test:i18n": "node --test scripts/validate-i18n.test.mjs",
    "test:english-purity": "node --test scripts/validate-english-purity.test.mjs",
    "test:external-links": "node --test scripts/check-external-links.test.mjs",
    "test:covers": "node --test scripts/generate-responsive-covers.test.mjs",
    "test:toc": "node --test scripts/article-toc-scroll.test.mjs",
    "test:huahua-callout": "node --test scripts/remark-huahua-callout.test.mjs",
    "test:image-dimensions": "node --test scripts/remark-image-dimensions.test.mjs",
    "test:home-roadmap": "node --test --experimental-strip-types scripts/home-roadmap.test.mjs",
    "test:home-roadmap:render": "node --test scripts/home-roadmap-render.test.mjs",
    "test:home-brand": "node --test --experimental-strip-types scripts/home-brand.test.mjs",
    "test:studio-updates": "node --test --experimental-strip-types scripts/studio-updates.test.mjs",
    "test:performance-assets": "node --test scripts/check-performance-assets.test.mjs",
    "test:finalize-sitemap": "node --test scripts/finalize-sitemap.test.mjs",
    "test:legacy-redirects": "node --test --experimental-strip-types scripts/legacy-redirects.test.mjs",
    "build": "npm run check:tags && npm run check:content && npm run check:markdown-emphasis && npm run check:blog-format && npm run check:reading-quality && npm run check:paper-topics && npm run check:paper-publication && npm run check:i18n && npm run check:english-purity && npm run check:skills && npm run check:editorial-radar && npm run generate:covers && astro build && npm run finalize:sitemap && npm run optimize:build-css && npm run check:performance-assets",
    "preview": "astro preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:covers": "node scripts/generate-responsive-covers.mjs",
    "migrate:blog-covers": "node scripts/migrate-blog-covers.mjs",
    "normalize:blog-format": "node scripts/normalize-blog-format.mjs",
    "normalize:markdown-emphasis": "node scripts/normalize-markdown-emphasis.mjs",
    "optimize:js": "node scripts/minify-js.mjs",
    "analyze:css": "node scripts/analyze-css.mjs",
    "optimize:build-css": "node scripts/optimize-build-css.mjs",
    "finalize:sitemap": "node scripts/finalize-sitemap.mjs",
    "check:performance-assets": "node scripts/check-performance-assets.mjs",
    "audit:content-growth": "node skills/bloss0m-content-refresh/scripts/audit-archive.mjs",
    "test:performance": "npm run test:performance:desktop && npm run test:performance:mobile",
    "test:performance:pr": "lhci autorun --config=./lighthouserc.pr.cjs",
    "test:performance:desktop": "lhci autorun --config=./lighthouserc.cjs",
    "test:performance:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
    "optimize:all": "npm run optimize:images && npm run optimize:js",
    "cleanup:images:preview": "node scripts/cleanup-original-images.mjs",
    "replace:image-refs:preview": "node scripts/replace-image-refs.mjs",
    "compress:pdf": "./scripts/compress-pdf.sh",
    "compress:all-pdfs": "./scripts/compress-all-pdfs.sh",
    "lfs:status": "git lfs status",
    "lfs:ls": "git lfs ls-files -s",
    "sync:skills": "node scripts/sync-personal-skill.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "lightningcss": "^1.32.0",
    "puppeteer-core": "^24.43.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "terser": "^5.36.0",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss-url": {
      "minimatch": "^9.0.5"
    }
  }
}
