---
interface Props {
  id?: string;
  kicker: string;
  title: string;
  description: string;
  image?: string;
  code?: string;
  headingLevel?: 'h1' | 'h2';
  compact?: boolean;
  hidden?: boolean;
  live?: 'off' | 'polite';
}

const {
  id,
  kicker,
  title,
  description,
  image = '/brand/bloom-mark-128.webp',
  code,
  headingLevel = 'h2',
  compact = false,
  hidden = false,
  live = 'off',
} = Astro.props;

const Heading = headingLevel;
---

<section
  id={id}
  class:list={['huahua-empty-state', { 'huahua-empty-state--compact': compact }]}
  data-code={code}
  aria-live={live === 'off' ? undefined : live}
  aria-atomic={live === 'off' ? undefined : 'true'}
  hidden={hidden}
>
  <div class="huahua-empty-visual" aria-hidden="true">
    <img src={image} alt="" width="128" height="128" loading="lazy" decoding="async" />
  </div>
  <div class="huahua-empty-copy">
    <p class="huahua-empty-kicker">{kicker}</p>
    <Heading>{title}</Heading>
    <p class="huahua-empty-description">{description}</p>
    <slot />
    <div class="huahua-empty-actions">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .huahua-empty-state {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: center;
    width: 100%;
    padding: clamp(2rem, 6vw, 4.75rem);
    overflow: hidden;
    border: 1px solid var(--editorial-line, var(--border));
    border-radius: clamp(24px, 4vw, 42px);
    background:
      radial-gradient(circle at 8% 18%, color-mix(in srgb, var(--accent-soft) 74%, transparent), transparent 36%),
      linear-gradient(145deg, var(--surface-raised-bg), var(--surface-raised-bg-end));
    box-shadow: var(--editorial-shadow, var(--shadow-card-hover));
  }

  .huahua-empty-state[hidden] {
    display: none;
  }

  .huahua-empty-state::after {
    position: absolute;
    right: -0.04em;
    bottom: -0.22em;
    z-index: -1;
    content: attr(data-code);
    font-family: var(--font-heading);
    font-size: clamp(9rem, 30vw, 24rem);
    font-weight: 700;
    line-height: 0.8;
    color: color-mix(in srgb, var(--accent) 6%, transparent);
    pointer-events: none;
  }

  .huahua-empty-state:not([data-code])::after,
  .huahua-empty-state[data-code='']::after {
    content: none;
  }

  .huahua-empty-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(7rem, 14vw, 10rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface-card) 88%, var(--accent-soft));
    box-shadow: 0 18px 40px color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .huahua-empty-visual::after {
    position: absolute;
    inset: -0.55rem;
    z-index: -1;
    content: '';
    border: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 50%;
  }

  .huahua-empty-visual img {
    width: 82%;
    height: 82%;
    border-radius: 50%;
    object-fit: cover;
  }

  .huahua-empty-copy {
    position: relative;
    max-width: 42rem;
  }

  .huahua-empty-kicker {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .huahua-empty-copy :global(h1),
  .huahua-empty-copy :global(h2) {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .huahua-empty-description {
    max-width: 56ch;
    margin: 1rem 0 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .huahua-empty-copy :global(.huahua-empty-detail) {
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .huahua-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .huahua-empty-state--compact {
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 24px;
    box-shadow: none;
  }

  .huahua-empty-state--compact .huahua-empty-visual {
    width: 6.5rem;
  }

  .huahua-empty-state--compact .huahua-empty-copy :global(h1),
  .huahua-empty-state--compact .huahua-empty-copy :global(h2) {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  @media (max-width: 640px) {
    .huahua-empty-state,
    .huahua-empty-state--compact {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 1.35rem;
      padding: 1.75rem 1.25rem;
      border-radius: 24px;
    }

    .huahua-empty-visual,
    .huahua-empty-state--compact .huahua-empty-visual {
      width: 5.75rem;
    }

    .huahua-empty-copy :global(h1),
    .huahua-empty-copy :global(h2) {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .huahua-empty-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .huahua-empty-actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
