---
/**
 * CTA block on non-contact pages: link to /contact/ with generic copy.
 * LinkedIn-specific CTA is only on the contact page (CtaBlock there).
 */
interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;

const copy = {
  en: {
    text: 'Looking for an AI platform or Agentic AI partner? I help teams ship enterprise-grade RAG, multi-agent, and real-time AI systems.',
    buttonText: 'Contact',
  },
  zh: {
    text: '正在找 AI 平台或 Agentic AI 夥伴？我協助團隊交付企業級 RAG、多代理與即時 AI 系統。',
    buttonText: '聯絡',
  },
} as const;

const { text, buttonText } = copy[lang];
---

<div class="cta-block">
  <p>{text}</p>
  <a href="/contact/" class="btn btn-primary">{buttonText}</a>
</div>
