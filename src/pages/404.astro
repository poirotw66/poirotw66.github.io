---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Bloss0m"
  description="The page you are looking for does not exist."
>
  <div class="block-en">
    <div class="page-404">
      <h1>Page not found</h1>
      <p class="article-meta">The page you are looking for does not exist or has been moved.</p>
      <a href="/" class="btn btn-primary">← Back to Home</a>
    </div>
  </div>
  <div class="block-zh">
    <div class="page-404">
      <h1>找不到頁面</h1>
      <p class="article-meta">您尋找的頁面不存在或已移動。</p>
      <a href="/" class="btn btn-primary">← 回首頁</a>
    </div>
  </div>
</Layout>

<style>
  .page-404 {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
  }
  .page-404 h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .page-404 .btn {
    margin-top: 1.5rem;
  }
</style>
