---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const copy = isEn
  ? {
      eyebrow: 'From signal to system',
      thesis: 'Frontier technology becomes useful only after it survives engineering.',
      prompt: 'Scroll through the loop',
      stages: [
        ['01', 'Observe', 'Separate a durable technical signal from the surrounding noise.', 'Papers · Models · Constraints'],
        ['02', 'Architect', 'Define the boundaries, interfaces, and trade-offs before choosing tools.', 'Flows · Contracts · Decisions'],
        ['03', 'Evaluate', 'Measure quality and failure modes before asking anyone to trust the system.', 'Quality · Latency · Failure'],
        ['04', 'Operate', 'Design for observability, maintenance, and a real team taking ownership.', 'Trace · Control · Handoff'],
      ],
    }
  : {
      eyebrow: '從訊號到系統 · From signal to system',
      thesis: '前沿技術，通過完整的工程驗證後才真正有用。',
      prompt: '向下捲動，走過工程循環',
      stages: [
        ['01', '觀察', '先從大量雜訊裡，辨認值得投入的長期技術訊號。', '論文 · 模型 · 限制'],
        ['02', '架構', '先定義邊界、介面與取捨，再決定要使用哪些工具。', '流程 · 契約 · 決策'],
        ['03', '評測', '在要求任何人信任系統之前，先量測品質與失敗模式。', '品質 · 延遲 · 失敗'],
        ['04', '維運', '把可觀測性、維護與團隊接手條件納入系統設計。', '追蹤 · 控制 · 交接'],
      ],
    };
---

<section id="engineering-rhythm" class="motion-passage" data-motion-passage aria-labelledby="motion-title">
  <div class="motion-sticky">
    <header class="motion-heading">
      <p>{copy.eyebrow}</p>
      <h2 id="motion-title">{copy.thesis}</h2>
    </header>

    <div class="motion-stage" aria-live="polite">
      <div class="motion-index" aria-hidden="true">
        <span data-motion-readout>01</span>
        <small>/ 04</small>
      </div>

      <div class="motion-stage-copy">
        {copy.stages.map((stage, index) => (
          <article class:list={{ 'is-active': index === 0 }} data-motion-stage>
            <p>{stage[3]}</p>
            <h3>{stage[1]}</h3>
            <div>
              <span>{stage[0]}</span>
              <p>{stage[2]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <footer class="motion-progress">
      <span>{copy.prompt}</span>
      <div aria-hidden="true"><i></i></div>
      <ol aria-hidden="true">
        {copy.stages.map((stage, index) => (
          <li class:list={{ 'is-active': index === 0 }} data-motion-marker>{stage[0]}</li>
        ))}
      </ol>
    </footer>
  </div>
</section>

<style>
  .motion-passage {
    --motion-progress: 0;
    width: min(calc(100% - (var(--page-gutter) * 2)), 1280px);
    height: 190vh;
    margin: clamp(3.5rem, 8vw, 7.5rem) auto;
  }

  .motion-sticky {
    position: sticky;
    top: 7rem;
    display: grid;
    grid-template-columns: minmax(240px, .7fr) minmax(0, 1.3fr);
    grid-template-rows: 1fr auto;
    min-height: calc(100vh - 8.5rem);
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: var(--bg);
  }

  .motion-sticky::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 35%;
    width: 1px;
    background: var(--border);
  }

  .motion-heading {
    align-self: start;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 4vw, 3.5rem) 2rem 0;
  }

  .motion-heading > p,
  .motion-progress,
  .motion-stage-copy article > p,
  .motion-index {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .motion-heading > p {
    margin: 0 0 1.2rem;
    color: var(--accent);
    font-size: .68rem;
    letter-spacing: .14em;
  }

  .motion-heading h2 {
    max-width: 13ch;
    margin: 0;
    color: var(--display-ink);
    font-size: clamp(1.55rem, 2.2vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -.035em;
  }

  .motion-stage {
    position: relative;
    min-height: 0;
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(2rem, 4vw, 4rem) clamp(2rem, 6vw, 6rem);
  }

  .motion-index {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    color: var(--accent);
    font-size: clamp(2rem, 3.4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -.07em;
    line-height: 1;
  }

  .motion-index small {
    color: var(--text-muted);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .12em;
  }

  .motion-stage-copy {
    position: relative;
    min-height: 19rem;
    margin-top: auto;
  }

  .motion-stage-copy article {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 320ms ease, transform 420ms cubic-bezier(.2, .75, .25, 1);
    pointer-events: none;
  }

  .motion-stage-copy article.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .motion-stage-copy article > p {
    margin: 0 0 .7rem;
    color: var(--text-muted);
    font-size: .64rem;
    letter-spacing: .12em;
  }

  .motion-stage-copy h3 {
    margin: 0;
    color: var(--display-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 700;
    line-height: .8;
    letter-spacing: -.075em;
  }

  .motion-stage-copy article > div {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 35rem);
    gap: 1.2rem;
    margin-top: clamp(1.5rem, 3vw, 2.8rem);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .motion-stage-copy article > div > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: .68rem;
  }

  .motion-stage-copy article > div > p {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(.95rem, 1.35vw, 1.15rem);
    line-height: 1.65;
  }

  .motion-progress {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(100px, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: .62rem;
    letter-spacing: .1em;
  }

  .motion-progress > div {
    height: 2px;
    overflow: hidden;
    background: var(--border);
  }

  .motion-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--motion-progress));
    transform-origin: left;
  }

  .motion-progress ol {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .motion-progress li {
    transition: color 220ms ease;
  }

  .motion-progress li.is-active {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .motion-passage {
      height: auto;
      margin-block: 2.5rem;
    }

    .motion-sticky {
      position: relative;
      top: auto;
      display: block;
      min-height: 0;
      padding-block: 1.5rem;
    }

    .motion-sticky::before,
    .motion-index,
    .motion-progress {
      display: none;
    }

    .motion-heading {
      padding: 0 0 1.75rem;
    }

    .motion-stage {
      padding: 0;
    }

    .motion-stage-copy {
      display: grid;
      gap: 0;
      min-height: 0;
    }

    .motion-stage-copy article {
      position: relative;
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: 0 1rem;
      padding: 1.25rem 0;
      border-top: 1px solid var(--border);
      opacity: 1;
      transform: none;
    }

    .motion-stage-copy article > p {
      grid-column: 2;
      grid-row: 1;
    }

    .motion-stage-copy h3 {
      grid-column: 2;
      font-size: clamp(2.1rem, 10vw, 3.2rem);
      line-height: .9;
    }

    .motion-stage-copy article > div {
      display: contents;
    }

    .motion-stage-copy article > div > span {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .motion-stage-copy article > div > p {
      grid-column: 2;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-passage {
      height: auto;
    }

    .motion-sticky {
      position: relative;
      top: auto;
    }

    .motion-stage-copy article {
      transition: none;
    }
  }
</style>
