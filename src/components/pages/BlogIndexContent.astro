---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { tagToUrlSlug } from '../../utils/tag';
import {
  BLOG_HUB_COPY,
  BLOG_LANE_COPY,
  BLOG_LANE_IDS,
  getPostLanes,
} from '../../utils/blogLanes';
import SectionIntro from '../SectionIntro.astro';
import BlogHubLanes from '../BlogHubLanes.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { blogSlug, resolveBlogPostsForLang } from '../../utils/blogLocale';
import EditorialCover from '../EditorialCover.astro';
import { getBlogCoverMeta } from '../../utils/editorialCover';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const INITIAL_POST_COUNT = 18;
const initialPosts = posts.slice(0, INITIAL_POST_COUNT);
const blogDataUrl = toLocalizedPath('/blog/index.json', lang);
const isEn = lang === 'en';
const categories = Array.from(new Set(posts.map((p) => p.data.category))).sort((a, b) => a.localeCompare(b));
const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags ?? []))).sort((a, b) => a.localeCompare(b));
const categoryLabels: Record<string, { zh: string; en: string }> = {
  'AI Engineering': { zh: 'AI 工程', en: 'AI Engineering' },
  'Cloud & Platform': { zh: '雲端與平台', en: 'Cloud & Platform' },
  'Creator Tools': { zh: '創作者工具', en: 'Creator Tools' },
  'Enterprise AI': { zh: '企業 AI', en: 'Enterprise AI' },
  'Industry Pulse': { zh: '產業觀測', en: 'Industry Pulse' },
  'Practice Notes': { zh: '實作筆記', en: 'Practice Notes' },
  Startup: { zh: '產品與創業', en: 'Product & Startup' },
};
const categoryLabel = (category: string) =>
  categoryLabels[category]?.[isEn ? 'en' : 'zh'] ?? category;
const categoryDisplayLabels = Object.fromEntries(
  categories.map((category) => [category, categoryLabel(category)]),
);
const formatDate = (d: Date) =>
  d.toLocaleDateString(isEn ? 'en-US' : 'zh-TW', {
    year: 'numeric',
    month: lang === 'en' ? 'short' : '2-digit',
    day: 'numeric',
  });

const hubCopy = {
  kicker: isEn ? BLOG_HUB_COPY.kicker.en : BLOG_HUB_COPY.kicker.zh,
  title: isEn ? BLOG_HUB_COPY.title.en : BLOG_HUB_COPY.title.zh,
  lead: isEn ? BLOG_HUB_COPY.lead.en : BLOG_HUB_COPY.lead.zh,
  cta: isEn ? BLOG_HUB_COPY.cta.en : BLOG_HUB_COPY.cta.zh,
};

const laneOptions = BLOG_LANE_IDS.map((laneId) => ({
  id: laneId,
  label: isEn ? BLOG_LANE_COPY[laneId].title.en : BLOG_LANE_COPY[laneId].title.zh,
}));
---

<Layout
  title={lang === 'en' ? 'Blog | Bloss0m' : '部落格 | Bloss0m'}
  description={
    lang === 'en'
      ? 'Articles on Generative AI, Enterprise AI, and Realtime AI. Agent design, RAG, evaluation, governance.'
      : '分享 Generative AI、企業 AI 與即時 AI 的設計、評估與工程落地。'
  }
  lang={lang}
  hubPreview
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/blog-hub.css" />
    <script is:inline src="/js/blog-index.js" defer></script>
  </Fragment>
  <div class="content-region">
    <header class="page-header blog-hub-header">
      <div class="page-header-inner">
        <h1>{hubCopy.title}</h1>
        <SectionIntro lead={hubCopy.lead} />

        <div class="blog-index-tools">
          <div class="blog-index-tools-head">
            <h2 class="blog-index-tools-title">{isEn ? 'Search the archive' : '搜尋內容庫'}</h2>
          </div>

          <div
            class="blog-filters"
            id="blog-filters"
            data-blog-index
            data-lang={lang}
            data-data-url={blogDataUrl}
            data-category-labels={JSON.stringify(categoryDisplayLabels)}
            data-initial-count={INITIAL_POST_COUNT}
          >
            <div class="blog-filter-row blog-filter-row-query">
              <label class="blog-filter-label" for="blog-filter-query">{isEn ? 'Keyword' : '關鍵字'}</label>
              <input
                id="blog-filter-query"
                class="blog-filter-query"
                type="search"
                placeholder={isEn ? 'Search by title, summary, category, tag...' : '搜尋標題、摘要、分類或標籤...'}
                autocomplete="off"
              />
            </div>
            <details class="blog-filter-more" open>
              <summary>
                <span>{isEn ? 'More filters' : '更多篩選'}</span>
                <span id="blog-filter-more-count" class="blog-filter-more-count" hidden></span>
              </summary>
              <div class="blog-filter-more-content">
                <div class="blog-filter-row">
                  <label class="blog-filter-label" for="blog-filter-lane">{isEn ? 'Reading path' : '閱讀路徑'}</label>
                  <select id="blog-filter-lane" class="blog-filter-select">
                    <option value="">{isEn ? 'All paths' : '全部路徑'}</option>
                    {laneOptions.map((lane) => <option value={lane.id}>{lane.label}</option>)}
                  </select>
                </div>
                <div class="blog-filter-row">
                  <label class="blog-filter-label" for="blog-filter-category">{isEn ? 'Content type' : '內容類型'}</label>
                  <select id="blog-filter-category" class="blog-filter-select">
                    <option value="">{isEn ? 'All content types' : '全部類型'}</option>
                    {categories.map((category) => <option value={category}>{categoryLabel(category)}</option>)}
                  </select>
                </div>
                <div class="blog-filter-row">
                  <label class="blog-filter-label" for="blog-filter-tag">{isEn ? 'Technical topic' : '技術主題'}</label>
                  <select id="blog-filter-tag" class="blog-filter-select">
                    <option value="">{isEn ? 'All technical topics' : '全部主題'}</option>
                    {tags.map((tag) => <option value={tag}>{tag}</option>)}
                  </select>
                </div>
              </div>
            </details>
            <button type="button" id="blog-filter-reset" class="btn btn-secondary blog-filter-reset" disabled>
              {isEn ? 'Reset' : '清除篩選'}
            </button>
          </div>
          <p id="blog-filter-summary" class="article-meta mt-half" role="status" aria-live="polite"></p>
        </div>
      </div>
    </header>

    <section class="section-spacer inner-page-sections">
      <BlogHubLanes posts={posts} lang={lang} />

      <ul class="blog-list" id="blog-list">
        {initialPosts.map((post) => {
          const postHref = toLocalizedPath(`/blog/${blogSlug(post)}/`, lang);
          const searchableText = [
            post.data.title,
            post.data.description,
            post.data.category,
            ...(post.data.tags ?? []),
          ]
            .join(' ')
            .toLowerCase();
          const postLanes = getPostLanes(post);
          const cover = getBlogCoverMeta(post, lang);
          return (
            <li
              class="blog-list-item"
              data-search-text={searchableText}
              data-category={post.data.category}
              data-tags={(post.data.tags ?? []).join('|')}
              data-lanes={postLanes.join('|')}
            >
              <a href={postHref} class="blog-list-thumb" aria-hidden="true" tabindex="-1">
                <EditorialCover title={post.data.title} image={post.data.image} {...cover} size="thumb" />
              </a>
              <div class="blog-list-body">
                <a href={postHref}>{post.data.title}</a>
                <div class="meta">{categoryLabel(post.data.category)} · {formatDate(post.data.pubDate)}</div>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="post-tags">
                    {post.data.tags.map((t) => (
                      <li class="post-tag-item"><a class="tag-pill" href={toLocalizedPath(`/blog/tag/${tagToUrlSlug(t)}/`, lang)}>{t}</a></li>
                    ))}
                    {post.data.tags.length > 3 && (
                      <li
                        class="post-tags-overflow"
                        aria-label={isEn ? `${post.data.tags.length - 3} additional tags` : `另外 ${post.data.tags.length - 3} 個標籤`}
                      >
                        +{post.data.tags.length - 3}
                      </li>
                    )}
                  </ul>
                )}
                {post.data.description && <p class="blog-list-desc">{post.data.description}</p>}
              </div>
            </li>
          );
        })}
      </ul>
      <div id="blog-filter-empty" class="blog-filter-empty" hidden aria-live="polite">
        <h2>{isEn ? 'No matching articles' : '找不到符合的文章'}</h2>
        <p>{isEn ? 'Try a broader keyword or clear the current filters.' : '請改用較寬鬆的關鍵字，或清除目前篩選。'}</p>
        <button type="button" id="blog-filter-empty-reset" class="btn btn-secondary">
          {isEn ? 'Clear filters' : '清除篩選'}
        </button>
      </div>
      <div class="blog-list-more">
        <button type="button" id="blog-list-more" class="btn btn-secondary">
          {isEn ? 'Show more articles' : '顯示更多文章'}
        </button>
      </div>
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>
