---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { tagToUrlSlug } from '../../utils/tag';
import {
  BLOG_HUB_COPY,
  BLOG_LANE_COPY,
  BLOG_LANE_IDS,
  getPostLanes,
} from '../../utils/blogLanes';
import SectionIntro from '../SectionIntro.astro';
import BlogHubLanes from '../BlogHubLanes.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { blogSlug, resolveBlogPostsForLang } from '../../utils/blogLocale';
import EditorialCover from '../EditorialCover.astro';
import { getBlogCoverMeta } from '../../utils/editorialCover';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const INITIAL_POST_COUNT = 18;
const initialPosts = posts.slice(0, INITIAL_POST_COUNT);
const blogDataUrl = toLocalizedPath('/blog/index.json', lang);
const isEn = lang === 'en';
const categories = Array.from(new Set(posts.map((p) => p.data.category))).sort((a, b) => a.localeCompare(b));
const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags ?? []))).sort((a, b) => a.localeCompare(b));
const categoryLabels: Record<string, { zh: string; en: string }> = {
  'AI Engineering': { zh: 'AI 工程', en: 'AI Engineering' },
  'Cloud & Platform': { zh: '雲端與平台', en: 'Cloud & Platform' },
  'Creator Tools': { zh: '創作者工具', en: 'Creator Tools' },
  'Enterprise AI': { zh: '企業 AI', en: 'Enterprise AI' },
  'Industry Pulse': { zh: '產業觀測', en: 'Industry Pulse' },
  'Practice Notes': { zh: '實作筆記', en: 'Practice Notes' },
  Startup: { zh: '產品與創業', en: 'Product & Startup' },
};
const categoryLabel = (category: string) =>
  categoryLabels[category]?.[isEn ? 'en' : 'zh'] ?? category;
const categoryDisplayLabels = Object.fromEntries(
  categories.map((category) => [category, categoryLabel(category)]),
);
const formatDate = (d: Date) =>
  d.toLocaleDateString(isEn ? 'en-US' : 'zh-TW', {
    year: 'numeric',
    month: lang === 'en' ? 'short' : '2-digit',
    day: 'numeric',
  });

const hubCopy = {
  kicker: isEn ? BLOG_HUB_COPY.kicker.en : BLOG_HUB_COPY.kicker.zh,
  title: isEn ? BLOG_HUB_COPY.title.en : BLOG_HUB_COPY.title.zh,
  lead: isEn ? BLOG_HUB_COPY.lead.en : BLOG_HUB_COPY.lead.zh,
  cta: isEn ? BLOG_HUB_COPY.cta.en : BLOG_HUB_COPY.cta.zh,
};

const laneOptions = BLOG_LANE_IDS.map((laneId) => ({
  id: laneId,
  label: isEn ? BLOG_LANE_COPY[laneId].title.en : BLOG_LANE_COPY[laneId].title.zh,
}));
---

<Layout
  title={lang === 'en' ? 'Blog | Bloss0m' : '部落格 | Bloss0m'}
  description={
    lang === 'en'
      ? 'Articles on Generative AI, Enterprise AI, and Realtime AI. Agent design, RAG, evaluation, governance.'
      : '分享 Generative AI、企業 AI 與即時 AI 的設計、評估與工程落地。'
  }
  lang={lang}
  hubPreview
>
  <div class="content-region">
    <header class="page-header blog-hub-header">
      <div class="page-header-inner">
        <h1>{hubCopy.title}</h1>
        <SectionIntro lead={hubCopy.lead} />

        <div class="blog-index-tools">
          <div class="blog-index-tools-head">
            <h2 class="blog-index-tools-title">{isEn ? 'Search the archive' : '搜尋內容庫'}</h2>
          </div>

          <div class="blog-filters" id="blog-filters">
            <div class="blog-filter-row blog-filter-row-query">
              <label class="blog-filter-label" for="blog-filter-query">{isEn ? 'Keyword' : '關鍵字'}</label>
              <input
                id="blog-filter-query"
                class="blog-filter-query"
                type="search"
                placeholder={isEn ? 'Search by title, summary, category, tag...' : '搜尋標題、摘要、分類或標籤...'}
                autocomplete="off"
              />
            </div>
            <div class="blog-filter-row">
              <label class="blog-filter-label" for="blog-filter-lane">{isEn ? 'Reading path' : '閱讀路徑'}</label>
              <select id="blog-filter-lane" class="blog-filter-select">
                <option value="">{isEn ? 'All paths' : '全部路徑'}</option>
                {laneOptions.map((lane) => <option value={lane.id}>{lane.label}</option>)}
              </select>
            </div>
            <div class="blog-filter-row">
              <label class="blog-filter-label" for="blog-filter-category">{isEn ? 'Content type' : '內容類型'}</label>
              <select id="blog-filter-category" class="blog-filter-select">
                <option value="">{isEn ? 'All content types' : '全部類型'}</option>
                {categories.map((category) => <option value={category}>{categoryLabel(category)}</option>)}
              </select>
            </div>
            <div class="blog-filter-row">
              <label class="blog-filter-label" for="blog-filter-tag">{isEn ? 'Technical topic' : '技術主題'}</label>
              <select id="blog-filter-tag" class="blog-filter-select">
                <option value="">{isEn ? 'All technical topics' : '全部主題'}</option>
                {tags.map((tag) => <option value={tag}>{tag}</option>)}
              </select>
            </div>
            <button type="button" id="blog-filter-reset" class="btn btn-secondary blog-filter-reset">
              {isEn ? 'Reset' : '清除篩選'}
            </button>
          </div>
          <p id="blog-filter-summary" class="article-meta mt-half" role="status" aria-live="polite"></p>
        </div>
      </div>
    </header>

    <section class="section-spacer inner-page-sections">
      <BlogHubLanes posts={posts} lang={lang} />

      <ul class="blog-list" id="blog-list">
        {initialPosts.map((post) => {
          const postHref = toLocalizedPath(`/blog/${blogSlug(post)}/`, lang);
          const searchableText = [
            post.data.title,
            post.data.description,
            post.data.category,
            ...(post.data.tags ?? []),
          ]
            .join(' ')
            .toLowerCase();
          const postLanes = getPostLanes(post);
          const cover = getBlogCoverMeta(post, lang);
          return (
            <li
              class="blog-list-item"
              data-search-text={searchableText}
              data-category={post.data.category}
              data-tags={(post.data.tags ?? []).join('|')}
              data-lanes={postLanes.join('|')}
            >
              <a href={postHref} class="blog-list-thumb" aria-hidden="true" tabindex="-1">
                <EditorialCover title={post.data.title} image={post.data.image} {...cover} size="thumb" />
              </a>
              <div class="blog-list-body">
                <a href={postHref}>{post.data.title}</a>
                <div class="meta">{categoryLabel(post.data.category)} · {formatDate(post.data.pubDate)}</div>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="post-tags">
                    {post.data.tags.map((t) => (
                      <li><a class="tag-pill" href={toLocalizedPath(`/blog/tag/${tagToUrlSlug(t)}/`, lang)}>{t}</a></li>
                    ))}
                  </ul>
                )}
                {post.data.description && <p class="blog-list-desc">{post.data.description}</p>}
              </div>
            </li>
          );
        })}
      </ul>
      <div class="blog-list-more">
        <button type="button" id="blog-list-more" class="btn btn-secondary">
          {isEn ? 'Show more articles' : '顯示更多文章'}
        </button>
      </div>
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<script is:inline define:vars={{ isEn, blogDataUrl, categoryDisplayLabels, initialPostCount: INITIAL_POST_COUNT }}>
  const root = document.getElementById('blog-filters');
  const list = document.getElementById('blog-list');
  const summary = document.getElementById('blog-filter-summary');
  const lanePreviews = document.getElementById('blog-lane-previews');
  const moreButton = document.getElementById('blog-list-more');

  if (root && list) {
    const queryInput = root.querySelector('#blog-filter-query');
    const laneSelect = root.querySelector('#blog-filter-lane');
    const categorySelect = root.querySelector('#blog-filter-category');
    const tagSelect = root.querySelector('#blog-filter-tag');
    const resetButton = root.querySelector('#blog-filter-reset');
    let allItems = [];
    let visibleLimit = initialPostCount;

    const readLaneFromUrl = () => {
      const lane = new URLSearchParams(window.location.search).get('lane');
      if (lane && laneSelect) {
        const hasOption = Array.from(laneSelect.options).some((option) => option.value === lane);
        if (hasOption) laneSelect.value = lane;
      }
    };

    const syncLaneToUrl = (lane) => {
      const url = new URL(window.location.href);
      if (lane) url.searchParams.set('lane', lane);
      else url.searchParams.delete('lane');
      window.history.replaceState({}, '', url);
    };

    const filtersActive = () => Boolean(
      (queryInput?.value ?? '').trim()
      || (laneSelect?.value ?? '')
      || (categorySelect?.value ?? '')
      || (tagSelect?.value ?? ''),
    );

    const createItem = (item) => {
      const row = document.createElement('li');
      row.className = 'blog-list-item';

      const media = document.createElement('a');
      media.href = item.href;
      media.className = 'blog-list-thumb';
      media.setAttribute('aria-hidden', 'true');
      media.tabIndex = -1;
      const cover = document.createElement('div');
      cover.className = `editorial-cover editorial-cover--${item.coverVariant} editorial-cover--thumb${item.image ? '' : ' editorial-cover--generated'}`;
      if (item.image) {
        const image = document.createElement('img');
        image.src = item.image;
        image.alt = '';
        image.className = 'editorial-cover-image';
        image.width = 200;
        image.height = 125;
        image.loading = 'lazy';
        image.fetchPriority = 'low';
        image.decoding = 'async';
        cover.appendChild(image);
      } else {
        const fallbackTitle = document.createElement('span');
        fallbackTitle.className = 'editorial-cover-fallback-title';
        fallbackTitle.textContent = item.title;
        cover.appendChild(fallbackTitle);
      }
      const topic = document.createElement('span');
      topic.className = 'editorial-cover-topic';
      topic.textContent = item.coverLabel;
      cover.appendChild(topic);
      const brand = document.createElement('span');
      brand.className = 'editorial-cover-brand';
      const mark = document.createElement('span');
      mark.className = 'editorial-cover-mark';
      mark.setAttribute('aria-hidden', 'true');
      brand.appendChild(mark);
      const brandName = document.createElement('span');
      brandName.textContent = 'Bloss0m';
      brand.appendChild(brandName);
      const note = document.createElement('span');
      note.className = 'editorial-cover-number';
      note.textContent = `Note ${item.coverNumber}`;
      brand.appendChild(note);
      cover.appendChild(brand);
      media.appendChild(cover);
      row.appendChild(media);

      const body = document.createElement('div');
      body.className = 'blog-list-body';
      const title = document.createElement('a');
      title.href = item.href;
      title.textContent = item.title;
      body.appendChild(title);

      const meta = document.createElement('div');
      meta.className = 'meta';
      meta.textContent = `${categoryDisplayLabels[item.category] ?? item.category} · ${item.date}`;
      body.appendChild(meta);

      if (item.tags.length > 0) {
        const tags = document.createElement('ul');
        tags.className = 'post-tags';
        item.tags.forEach((tag) => {
          const tagItem = document.createElement('li');
          const tagLink = document.createElement('a');
          tagLink.className = 'tag-pill';
          tagLink.href = tag.href;
          tagLink.textContent = tag.label;
          tagItem.appendChild(tagLink);
          tags.appendChild(tagItem);
        });
        body.appendChild(tags);
      }

      if (item.description) {
        const description = document.createElement('p');
        description.className = 'blog-list-desc';
        description.textContent = item.description;
        body.appendChild(description);
      }
      row.appendChild(body);
      return row;
    };

    const renderItems = (items) => {
      const fragment = document.createDocumentFragment();
      items.forEach((item) => fragment.appendChild(createItem(item)));
      list.replaceChildren(fragment);
    };

    const matchingItems = () => {
      const query = (queryInput?.value ?? '').trim().toLowerCase();
      const lane = laneSelect?.value ?? '';
      const category = categorySelect?.value ?? '';
      const tag = tagSelect?.value ?? '';
      return allItems.filter((item) => {
        const searchText = [item.title, item.description, item.category, ...item.tags.map((entry) => entry.label)]
          .join(' ')
          .toLowerCase();
        return (!query || searchText.includes(query))
          && (!lane || item.lanes.includes(lane))
          && (!category || item.category === category)
          && (!tag || item.tags.some((entry) => entry.label === tag));
      });
    };

    const applyFilters = () => {
      if (allItems.length === 0) return;
      const active = filtersActive();
      const matches = matchingItems();
      const rendered = active ? matches : matches.slice(0, visibleLimit);
      renderItems(rendered);

      if (lanePreviews) lanePreviews.hidden = active;
      if (moreButton) moreButton.hidden = active || rendered.length >= matches.length;
      if (summary) {
        summary.textContent = isEn
          ? `${matches.length} result(s)${active ? '' : ` · showing ${rendered.length}`}`
          : `共 ${matches.length} 篇文章${active ? '' : ` · 顯示 ${rendered.length} 篇`}`;
      }
      syncLaneToUrl(laneSelect?.value ?? '');
    };

    readLaneFromUrl();
    fetch(blogDataUrl)
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then((items) => {
        allItems = items;
        if (filtersActive()) applyFilters();
        else {
          if (summary) {
            summary.textContent = isEn
              ? `${items.length} result(s) · showing ${Math.min(initialPostCount, items.length)}`
              : `共 ${items.length} 篇文章 · 顯示 ${Math.min(initialPostCount, items.length)} 篇`;
          }
          if (moreButton) moreButton.hidden = items.length <= initialPostCount;
        }
      })
      .catch(() => {
        if (summary) summary.textContent = isEn
          ? 'Showing the latest articles. Full filtering is temporarily unavailable.'
          : '目前顯示最新文章，完整篩選暫時無法使用。';
        if (moreButton) moreButton.hidden = true;
      });

    queryInput?.addEventListener('input', applyFilters);
    laneSelect?.addEventListener('change', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    tagSelect?.addEventListener('change', applyFilters);
    moreButton?.addEventListener('click', () => {
      visibleLimit += initialPostCount;
      applyFilters();
    });
    resetButton?.addEventListener('click', () => {
      if (queryInput) queryInput.value = '';
      if (laneSelect) laneSelect.value = '';
      if (categorySelect) categorySelect.value = '';
      if (tagSelect) tagSelect.value = '';
      visibleLimit = initialPostCount;
      applyFilters();
    });
  }
</script>

<style>
  .blog-list-more {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .blog-filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    align-items: end;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: visible;
    margin-bottom: 0.8rem;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .blog-filter-row {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .blog-filter-row-query {
    min-width: 0;
  }

  .blog-filter-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .blog-filter-query,
  .blog-filter-select {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0.55rem 0.72rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg) 94%, #fff 6%);
    color: var(--text);
    font: inherit;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }

  .blog-filter-query::placeholder {
    color: color-mix(in srgb, var(--text-muted) 82%, transparent);
  }

  .blog-filter-query:focus-visible,
  .blog-filter-select:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-soft) 85%, transparent);
    background: var(--bg);
  }

  .blog-filter-reset {
    height: 42px;
    align-self: end;
    white-space: nowrap;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 901px) {
    .blog-hub-header h1:lang(zh-Hant) {
      max-width: none;
      font-size: clamp(2.5rem, 5vw, 4.75rem);
      white-space: nowrap;
    }
  }

  @media (min-width: 640px) {
    .blog-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .blog-filter-row-query {
      grid-column: 1 / -1;
    }
    .blog-filter-reset {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media (min-width: 960px) {
    .blog-filters {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 1fr) auto;
    }
    .blog-filter-row-query {
      grid-column: auto;
    }
    .blog-filter-reset {
      grid-column: auto;
      width: auto;
    }
  }
</style>
