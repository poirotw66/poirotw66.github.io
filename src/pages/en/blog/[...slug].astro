---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BlogPostContent from '../../../components/pages/BlogPostContent.astro';
import { blogSlug, resolveBlogPostsForLang } from '../../../utils/blogLocale';

export async function getStaticPaths() {
  const posts = resolveBlogPostsForLang(await getCollection('blog'), 'en');
  return posts.map((post) => ({
    params: { slug: blogSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
---

<BlogPostContent lang="en" post={post} />
