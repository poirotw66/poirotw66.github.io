---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLabProjects } from '../../utils/sort';
import PageHeader from '../../components/PageHeader.astro';
import CtaLinkedIn from '../../components/CtaLinkedIn.astro';

const labProjects = getLabProjects(await getCollection('projects'));
---

<Layout
  title="Lab | Bloss0m"
  description="Creative Lab: quick experiments and side projects. AI, tools, and experiments."
>
  <div class="block-en">
    <div class="content-region">
      <PageHeader title="Creative Lab" subtitle="Quick experiments and side projects" />

      <section class="section-spacer">
        {labProjects.length > 0 ? (
          <ul class="blog-list">
            {labProjects.map((entry) => {
              const projectHref = `/projects/${entry.id}/`;
              return (
                <li class="blog-list-item">
                  {entry.data.image && (
                    <a href={projectHref} class="blog-list-thumb" aria-hidden="true">
                      <img src={entry.data.image} alt="" class="blog-list-thumb-img" width="200" height="125" loading="lazy" />
                    </a>
                  )}
                  <div class="blog-list-body">
                    <a href={projectHref}>{entry.data.title}</a>
                    {entry.data.impact && <div class="meta">{entry.data.impact}</div>}
                    <p class="blog-list-desc">{entry.data.description}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="lab-empty" data-en="No lab projects yet. Check back later." data-zh="尚未有實驗室專案，敬請期待。">No lab projects yet. Check back later.</p>
        )}
      </section>

      <CtaLinkedIn lang="en" />
    </div>
  </div>

  <div class="block-zh">
    <div class="content-region">
      <PageHeader title="實驗室" subtitle="靈光一現的 side projects" />

      <section class="section-spacer">
        {labProjects.length > 0 ? (
          <ul class="blog-list">
            {labProjects.map((entry) => {
              const projectHref = `/projects/${entry.id}/`;
              return (
                <li class="blog-list-item">
                  {entry.data.image && (
                    <a href={projectHref} class="blog-list-thumb" aria-hidden="true">
                      <img src={entry.data.image} alt="" class="blog-list-thumb-img" width="200" height="125" loading="lazy" />
                    </a>
                  )}
                  <div class="blog-list-body">
                    <a href={projectHref}>{entry.data.title}</a>
                    {entry.data.impact && <div class="meta">{entry.data.impact}</div>}
                    <p class="blog-list-desc">{entry.data.description}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="lab-empty">尚未有實驗室專案，敬請期待。</p>
        )}
      </section>

      <CtaLinkedIn lang="zh" />
    </div>
  </div>
</Layout>

<style>
  .lab-empty {
    color: var(--text-muted);
    text-align: center;
    margin: 2rem 0;
  }
</style>
