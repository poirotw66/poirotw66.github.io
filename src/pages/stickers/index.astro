---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import PageHeader from '../../components/PageHeader.astro';
import StickerCard from '../../components/StickerCard.astro';
import CtaLinkedIn from '../../components/CtaLinkedIn.astro';
import Footer from '../../components/Footer.astro';

const allStickers = sortByPubDate(await getCollection('stickers'));
---

<Layout
  title="LINE Stickers | Bloss0m"
  description="LINE stickers created with AI. AI creation and automation for creators."
>
  <div class="block-en">
    <div class="content-region">
      <PageHeader title="LINE Stickers" subtitle="AI-created stickers · From idea to LINE Store" />

      <section class="section-spacer">
        <div class="sticker-grid">
          {allStickers.map((entry) => (
            <StickerCard entry={entry} lineStoreLabel="LINE Sticker Store" />
          ))}
        </div>
      </section>

      <CtaLinkedIn lang="en" />
      <Footer text="AI Platform & Agentic AI Engineer · LINE Stickers" />
    </div>
  </div>

  <div class="block-zh">
    <div class="content-region">
      <PageHeader title="LINE 貼圖" subtitle="AI 創作貼圖 · 從發想到上架" />

      <section class="section-spacer">
        <div class="sticker-grid">
          {allStickers.map((entry) => (
            <StickerCard entry={entry} lineStoreLabel="LINE 貼圖小舖" />
          ))}
        </div>
      </section>

      <CtaLinkedIn lang="zh" />
      <Footer text="AI 平台與 Agentic AI 工程師 · LINE 貼圖" />
    </div>
  </div>
</Layout>
