---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { resolveStickerAsset, resolveStickerAssets } from '../../utils/sticker';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { formatPublishedDate, toDate } from '../../utils/formatPublishedDate';
import { baseSlug } from '../../utils/contentLocale';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'stickers'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const slug = baseSlug(entry);

const site = Astro.site ?? new URL('https://www.bloss0m.com');
const canonicalUrl = new URL(toLocalizedPath(`/stickers/${slug}/`, lang), site).toString();
const imageSrc = entry.data.image ? resolveStickerAsset(slug, entry.data.image) : null;
const spriteSrcs = entry.data.spriteImages ? resolveStickerAssets(slug, entry.data.spriteImages) : [];
const stickerImageUrl = imageSrc ? new URL(imageSrc, site).toString() : undefined;
const pubDateObj = toDate(entry.data.pubDate);
const pubIso = pubDateObj.toISOString();
---

<Layout
  title={`${entry.data.title} | LINE Stickers`}
  description={entry.data.description}
  canonicalURL={new URL(toLocalizedPath(`/stickers/${slug}/`, lang), site)}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: entry.data.title,
      description: entry.data.description,
      ...(stickerImageUrl && { image: stickerImageUrl }),
      datePublished: pubIso,
      author: { '@type': 'Person', name: 'Bloss0m' },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Stickers' : '貼圖', item: new URL(toLocalizedPath('/stickers/', lang), site).toString() },
        { '@type': 'ListItem', position: 2, name: entry.data.title, item: canonicalUrl },
      ],
    })} />
  </Fragment>
  <div class="content-region">
    <div class="sticker-detail">
      <a href={toLocalizedPath('/stickers/', lang)} class="back">← {lang === 'en' ? 'Stickers' : '貼圖'}</a>
      <div class="sticker-detail-hero">
        {imageSrc ? (
          <img src={imageSrc} alt={entry.data.title} width="240" height="240" class="sticker-detail-image" />
        ) : (
          <div class="sticker-card-placeholder sticker-detail-image" aria-hidden="true">LINE</div>
        )}
        <div class="sticker-detail-meta">
          <h1>{entry.data.title}</h1>
          <p class="sticker-detail-desc">{entry.data.description}</p>
          <p class="article-meta sticker-detail-date">
            <time datetime={pubIso}>{formatPublishedDate(pubDateObj, lang)}</time>
          </p>
          <a href={entry.data.lineStoreUrl} class="btn btn-primary" target="_blank" rel="noopener">
            {lang === 'en' ? 'LINE Sticker Store' : 'LINE 貼圖小舖'}
          </a>
        </div>
      </div>
      {spriteSrcs.length > 0 && (
        <div class="sticker-sprites">
          {spriteSrcs.map((src, i) => (
            <figure class="sticker-sprite">
              <img
                src={src}
                alt={lang === 'en' ? `${entry.data.title} sprite ${i + 1}` : `${entry.data.title} 精靈圖分鏡 ${i + 1}`}
                class="sticker-sprite-img"
              />
            </figure>
          ))}
        </div>
      )}
      <div class="article-body sticker-detail-body">
        <Content />
      </div>
    </div>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<style>
  .sticker-detail {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: 2rem;
  }
  .sticker-detail .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-bottom: 1.25rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-card) 80%, transparent);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .sticker-detail .back:hover {
    border-color: var(--accent);
    color: var(--accent-hover);
  }
  .sticker-detail-hero {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    margin-bottom: 2.5rem;
    padding: clamp(1.25rem, 3.5vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--editorial-line, var(--border));
    border-radius: clamp(22px, 3vw, 34px);
    background:
      radial-gradient(circle at 92% 10%, var(--ambient-a, var(--accent-soft)), transparent 38%),
      color-mix(in srgb, var(--surface-raised-bg) 94%, transparent);
    box-shadow: var(--editorial-shadow, var(--shadow-card-hover));
  }
  .sticker-detail-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    border-radius: 22px;
    background: color-mix(in srgb, var(--surface) 86%, var(--accent-soft));
    box-shadow: 0 18px 45px color-mix(in srgb, var(--text) 10%, transparent);
  }
  .sticker-detail-meta {
    min-width: 200px;
  }
  .sticker-detail-meta h1 {
    font-family: var(--font-heading);
    max-width: 14ch;
    margin: 0 0 1rem;
    font-size: clamp(2.6rem, 5.4vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .sticker-detail-desc {
    max-width: 58ch;
    color: var(--text-muted);
    line-height: 1.72;
    margin-bottom: 0.65rem;
  }
  .sticker-detail-date {
    margin: 0 0 1.25rem;
  }
  .sticker-detail-body {
    max-width: min(72ch, var(--content-max));
    padding-top: 0;
  }
  .sticker-sprites {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sticker-sprite {
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--editorial-line, var(--border));
    box-shadow: 0 18px 48px color-mix(in srgb, var(--text) 8%, transparent);
  }
  .sticker-sprite-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 720px) {
    .sticker-detail-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.25rem;
    }
    .sticker-detail-image {
      max-width: 320px;
      margin-inline: auto;
    }
    .sticker-detail-meta h1 {
      max-width: none;
      font-size: clamp(2.25rem, 11vw, 3.25rem);
      line-height: 1.02;
    }
    .sticker-detail-meta .btn {
      width: 100%;
    }
    .sticker-sprites {
      gap: 1rem;
    }
    .sticker-sprite {
      border-radius: 18px;
    }
  }
</style>
