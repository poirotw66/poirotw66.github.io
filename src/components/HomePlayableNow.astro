---
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
import {
  PLAYABLE_CATEGORY_LABEL,
  PLAYABLE_NOW_ITEMS,
  playableNowCopy,
  playableNowJsonLd,
} from '../data/playableNow';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = playableNowCopy(lang);
const site = Astro.site ?? new URL('https://www.bloss0m.com');
const jsonLd = playableNowJsonLd(lang, site.toString().replace(/\/$/, ''));
---

<section
  id="playable"
  class="section-reveal home-scroll-anchor home-editorial-section home-playable"
  aria-label={copy.title}
>
  <SectionHeading kicker={copy.kicker} title={copy.title} />
  <p class="home-playable-lead">{copy.lead}</p>

  <ul class="home-playable-grid" role="list">
    {PLAYABLE_NOW_ITEMS.map((item) => {
      const title = item.title[lang];
      const category = PLAYABLE_CATEGORY_LABEL[item.category][lang];
      const dialogId = `playable-dialog-${item.id}`;
      return (
        <li class="home-playable-card" data-playable-card>
          <button
            type="button"
            class="home-playable-card-hit"
            data-playable-open={dialogId}
            aria-haspopup="dialog"
            aria-controls={dialogId}
          >
            <span class="sr-only">{copy.cardHint}: {title}</span>
            <div class="home-playable-media" aria-hidden="true">
              <img
                src={item.image}
                alt=""
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="home-playable-meta">
              <span class="home-playable-category">{category}</span>
              <span class="home-playable-status">
                <span class="home-playable-status-dot" aria-hidden="true" />
                {copy.status}
              </span>
            </div>
            <h3 class="home-playable-title">{title}</h3>
            <p class="home-playable-pitch">{item.pitch[lang]}</p>
          </button>

          <a
            class="home-playable-open"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.openAria(title)}
          >
            {copy.openLabel}
          </a>

          <dialog
            id={dialogId}
            class="home-playable-dialog"
            aria-labelledby={`${dialogId}-title`}
          >
            <div class="home-playable-dialog-panel">
              <header class="home-playable-dialog-head">
                <div class="home-playable-dialog-media" aria-hidden="true">
                  <img
                    src={item.image}
                    alt=""
                    width="960"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="home-playable-dialog-intro">
                  <p class="home-playable-meta home-playable-meta--dialog">
                    <span class="home-playable-category">{category}</span>
                    <span class="home-playable-status">
                      <span class="home-playable-status-dot" aria-hidden="true" />
                      {copy.status}
                    </span>
                  </p>
                  <h3 id={`${dialogId}-title`} class="home-playable-dialog-title">
                    {copy.dialogTitle(title)}
                  </h3>
                  <p class="home-playable-dialog-pitch">{item.pitch[lang]}</p>
                </div>
              </header>

              <ul class="home-playable-can-do">
                {item.canDo[lang].map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              {item.buildNote && (
                <p class="home-playable-build-note">{item.buildNote[lang]}</p>
              )}

              <footer class="home-playable-dialog-actions">
                <a
                  class="btn btn-primary"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {copy.openLabel}
                </a>
                <button type="button" class="btn btn-secondary" data-playable-close>
                  {copy.closeLabel}
                </button>
              </footer>
            </div>
          </dialog>
        </li>
      );
    })}
  </ul>

  <p class="text-center-mt">
    <a href={toLocalizedPath('/lab/', lang)} class="btn btn-secondary">{copy.labCta}</a>
  </p>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script src="/js/playable-now-dialog.js" defer></script>
