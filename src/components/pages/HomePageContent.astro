---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { toLocalizedPath } from '../../i18n/utils';
import SectionHeading from '../SectionHeading.astro';
import HomeTrustBar from '../HomeTrustBar.astro';
import HomeCaseStudy from '../HomeCaseStudy.astro';
import HomeRagExplorer from '../HomeRagExplorer.astro';
import HomeLatestUpdates from '../HomeLatestUpdates.astro';
import HomeReadingPicks from '../HomeReadingPicks.astro';
import FollowWriting from '../FollowWriting.astro';
import HomePlayableNow from '../HomePlayableNow.astro';
import { resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import {
  HOME_CASE_STUDY_SLUGS,
  homeCaseStudyDetails,
  type HomeCaseStudySlug,
} from '../../data/homeBrand';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const isEn = lang === 'en';
const allBlogPosts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const latestWriting = allBlogPosts.slice(0, 3);
const allProjectEntries = resolveEntriesForLang(await getCollection('projects'), lang);
const projectBySlug = new Map(allProjectEntries.map((entry) => [baseSlug(entry), entry]));
const projects = HOME_CASE_STUDY_SLUGS.flatMap((slug) => {
  const entry = projectBySlug.get(slug);
  return entry ? [entry] : [];
});
const [featuredProject, ...secondaryProjects] = projects;

const trustItems = isEn
  ? [
      { value: '98.0%', label: 'weighted RAG accuracy', detail: 'Fixed 100-query benchmark', href: toLocalizedPath('/projects/agentic-rag/#case-evaluation', lang) },
      { value: '19', label: 'modular agent subflows', detail: 'Inspectable system design', href: toLocalizedPath('/projects/agentic-ai-platform/#case-design', lang) },
      { value: '5+', label: 'hospital formats normalized', detail: 'Built against real documents', href: toLocalizedPath('/projects/ocr-automation/#case-context', lang) },
    ]
  : [
      { value: '98.0%', label: 'RAG 加權準確率', detail: '固定 100 題 benchmark', href: toLocalizedPath('/projects/agentic-rag/#case-evaluation', lang) },
      { value: '19', label: '個模組化 Agent 子流程', detail: '可查驗的系統設計', href: toLocalizedPath('/projects/agentic-ai-platform/#case-design', lang) },
      { value: '5+', label: '種醫院格式正規化', detail: '以真實文件完成實作', href: toLocalizedPath('/projects/ocr-automation/#case-context', lang) },
    ];

const copy = isEn
  ? {
      title: 'Bloss0m | Justin’s AI Engineering Notes',
      description: 'AI engineering notes by Justin: reading research, building Agent and RAG systems, and documenting the decisions along the way.',
      eyebrow: 'Justin’s AI engineering notes',
      titleLines: ['Read the research.', 'Share what I build.'],
      tagline: 'I’m Justin. I build AI platforms and write about agents, RAG, and the decisions behind working systems.',
      primaryCta: 'Start reading',
      secondaryCta: 'New here? →',
      trustLabel: 'Public engineering evidence. Open the source behind each signal.',
      showcaseTitle: 'Flagship system: a measurable Agentic RAG pipeline',
      showcaseLink: 'View all implementations',
    }
  : {
      title: 'Bloss0m｜Justin 的 AI 工程筆記',
      description: 'Justin 的個人技術部落格：讀 AI 研究、做 Agent 與 RAG 系統，寫下實作過程中的觀察與架構取捨。',
      eyebrow: 'Justin 的 AI 工程筆記',
      titleLines: ['把研究讀懂，', '把實作寫下來。'],
      tagline: '我是 Justin，AI Platform 與 Agentic AI 工程師。這裡記錄我對 Agent、RAG 與 AI 系統的研究、實作與判斷。',
      primaryCta: '開始閱讀',
      secondaryCta: '第一次來，從這裡讀 →',
      trustLabel: '公開工程證據｜每一項都有實作或評測可以查驗',
      showcaseTitle: '旗艦系統：可量測的 Agentic RAG 管線',
      showcaseLink: '看全部實作',
    };

---

<Layout title={copy.title} description={copy.description} lang={lang} bodyClass="page-home">
  <>
    <section id="hero" class="home-hero home-hero--reading section-reveal home-scroll-anchor">
        <div class="home-hero-copy">
          <p class="hero-eyebrow">{copy.eyebrow}</p>
          <h1 class="hero-title">{copy.titleLines.map((line) => <span>{line}</span>)}</h1>
          <p class="hero-tagline">{copy.tagline}</p>
          <div class="hero-actions">
            <a href="#updates" class="btn btn-primary">{copy.primaryCta}</a>
            <a href="#start-here" class="hero-secondary-link">{copy.secondaryCta}</a>
          </div>
        </div>

        <aside class="home-author-note" aria-labelledby="home-author-title">
          <img src="/brand/bloom-mark-128.webp" alt={isEn ? 'Huahua, the Bloss0m calico cat' : 'Bloss0m 的三花貓花花'} width="64" height="64" decoding="async" />
          <h2 id="home-author-title">{isEn ? 'Behind the notes' : '筆記背後的我'}</h2>
          <p>{isEn ? 'Document intelligence, retrieval, and agent platforms, with research tied to implementation.' : '從文件智能、檢索到 Agent 平台，記錄研究與實作之間的選擇。'}</p>
          <div class="home-author-links">
            <a href={toLocalizedPath('/contact/', lang)}>{isEn ? 'About Justin ↗' : '認識 Justin ↗'}</a>
            <a href={toLocalizedPath('/now/', lang)}>{isEn ? 'Current work →' : '最近在研究什麼 →'}</a>
          </div>
        </aside>
    </section>

    <HomeLatestUpdates posts={latestWriting} lang={lang} />

    <HomeReadingPicks posts={allBlogPosts} lang={lang} />

    <section id="showcase" class="section-reveal home-scroll-anchor home-editorial-section">
      <SectionHeading title={copy.showcaseTitle} />
      <HomeTrustBar label={copy.trustLabel} items={trustItems} />
      <div class="home-case-study-list">
        {featuredProject && (
          <HomeRagExplorer lang={lang} />
        )}
      </div>

      {secondaryProjects.length > 0 && (
        <div id="other-cases" class="home-secondary-cases" aria-label={isEn ? 'More engineering case studies' : '更多工程案例'}>
          <header class="home-secondary-cases-head">
            <h2>{isEn ? 'More engineering case studies' : '更多工程案例'}</h2>
          </header>
          <div class="home-secondary-case-list">
            {secondaryProjects.map((entry) => (
              <HomeCaseStudy
                entry={entry}
                lang={lang}
                variant="compact"
                detail={homeCaseStudyDetails[lang][baseSlug(entry) as HomeCaseStudySlug]}
              />
            ))}
          </div>
        </div>
      )}

      <p class="text-center-mt">
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{copy.showcaseLink}</a>
      </p>
    </section>

    <HomePlayableNow lang={lang} />

    <FollowWriting lang={lang} />
    <script src="/js/home-scroll-hash.js" defer></script>
  </>
</Layout>
