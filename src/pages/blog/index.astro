---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog | AI Platform Engineer"
  description="Articles on Generative AI, Enterprise AI, and Realtime AI. Agent design, RAG, evaluation, governance."
>
  <header class="page-header">
    <div class="page-header-inner">
      <h1>Blog</h1>
      <p>Generative AI · Enterprise AI · Realtime AI</p>
    </div>
  </header>

  <section style="padding-top: 2rem;">
    <ul class="blog-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
          <div class="meta">{post.data.category}</div>
        </li>
      ))}
    </ul>
  </section>

  <div class="cta-block">
    <a href="/" class="btn btn-secondary">← Home</a>
    <a href="/contact/" class="btn btn-primary" style="margin-left: 0.5rem;">Contact</a>
  </div>

  <footer class="footer">
    <p>AI Platform & Agentic AI Engineer</p>
  </footer>
</Layout>
