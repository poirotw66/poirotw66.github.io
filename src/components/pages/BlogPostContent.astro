---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { tagToUrlSlug } from '../../utils/tag';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import ArticlePageLayout from '../article/ArticlePageLayout.astro';
import ArticleBrief from '../article/ArticleBrief.astro';
import TopicClusterNav from '../article/TopicClusterNav.astro';
import CategoryBadge from '../CategoryBadge.astro';
import { getPostLane } from '../../utils/blogLanes';
import { toLocalizedPath, useTranslations } from '../../i18n/utils';
import { formatPublishedDate, toDate } from '../../utils/formatPublishedDate';
import { estimateReadingMinutes } from '../../utils/readingTime';
import { descriptionToTldr } from '../../utils/articleBrief';
import { blogSlug } from '../../utils/blogLocale';
import { hasMathContent } from '../../utils/mathContent';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const { Content, headings } = await render(post);
const hasMermaid = post.body.includes('```mermaid');
const hasMath = hasMathContent(post.body);
const t = useTranslations(lang);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = Boolean(post.data.showToc) && tocHeadings.length > 0;
const postLane = getPostLane(post);
const slug = blogSlug(post);

const site = Astro.site ?? new URL('https://www.bloss0m.com');
const canonicalUrl = new URL(toLocalizedPath(`/blog/${slug}/`, lang), site).toString();
const articleImage = post.data.image ? new URL(post.data.image, site).toString() : new URL('/og.webp', site).toString();
const pubDateObj = toDate(post.data.pubDate);
const pubIso = pubDateObj.toISOString();
const updatedDateObj = post.data.updatedDate ? toDate(post.data.updatedDate) : null;
const modifiedIso = updatedDateObj?.toISOString() ?? pubIso;
const readingMinutes = estimateReadingMinutes(post.body);
const readerCopy = lang === 'en'
  ? { progress: 'Article reading progress', copy: 'Copy code', copied: 'Copied', read: `${readingMinutes} min read`, updated: 'Updated' }
  : { progress: '文章閱讀進度', copy: '複製程式碼', copied: '已複製', read: `閱讀約 ${readingMinutes} 分鐘`, updated: '更新' };
const tldrItems = post.data.tldr ?? descriptionToTldr(post.data.description);
const audienceItems = post.data.audience ?? [
  lang === 'en'
    ? `Engineers and product teams interested in ${post.data.category}, implementation patterns, and technical trade-offs.`
    : `對 ${post.data.category}、實作方法與技術決策感興趣的工程師及產品團隊。`,
];
// Align all posts to the wide masthead layout used by the reference article format.
const useWideHeader = post.data.wideHeader !== false;
---

<Layout
  title={`${post.data.title} | Bloss0m`}
  description={post.data.description}
  canonicalURL={new URL(toLocalizedPath(`/blog/${slug}/`, lang), site)}
  imageURL={articleImage}
  ogType="article"
  articlePublishedTime={pubIso}
  articleModifiedTime={modifiedIso}
  articleAuthor="Bloss0m"
  lang={lang}
  bodyClass="page-article"
>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href="/css/katex.min.css" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      image: articleImage,
      datePublished: pubIso,
      dateModified: modifiedIso,
      author: { '@id': `${site.toString().replace(/\/$/, '')}/#person` },
      publisher: { '@id': `${site.toString().replace(/\/$/, '')}/#organization` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL(toLocalizedPath('/blog/', lang), site).toString() },
        { '@type': 'ListItem', position: 2, name: post.data.title, item: canonicalUrl },
      ],
    })} />
  </Fragment>
  <div class="content-region">
    <section class="section-spacer-lg">
      <ArticlePageLayout
        showToc={showToc}
        tocHeadings={tocHeadings}
        tocLabel={t('blog.tocTitle')}
        progressLabel={readerCopy.progress}
        copyLabel={readerCopy.copy}
        copiedLabel={readerCopy.copied}
        wideHeader={useWideHeader}
      >
        <div
          slot="header"
          class:list={[
            'article-masthead',
            {
              'article-masthead--with-cover': Boolean(post.data.image),
              'article-masthead--wide': useWideHeader,
              'article-masthead--text': !post.data.image,
            },
          ]}
        >
          <div class="article-masthead-copy">
            <a href={toLocalizedPath('/blog/', lang)} class="back">← {lang === 'en' ? 'Blog' : '部落格'}</a>
            <p class="article-masthead-kicker">{post.data.kind === 'guide' ? (lang === 'en' ? 'Field guide' : '深度指南') : (lang === 'en' ? 'Engineering note' : '工程筆記')}</p>
            <h1>{post.data.title}</h1>
            {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
            {post.data.guideVersion && (
              <p class="article-version" aria-label="Guide version">{post.data.guideVersion}</p>
            )}
            <p class="article-meta article-facts">
              <CategoryBadge label={post.data.category} lane={postLane ?? undefined} />
              <span class="article-meta-sep" aria-hidden="true"> · </span>
              <time datetime={pubIso}>{formatPublishedDate(pubDateObj, lang)}</time>
              <span class="article-meta-sep" aria-hidden="true"> · </span>
              <span class="article-reading-time">{readerCopy.read}</span>
              {updatedDateObj && (
                <>
                  <span class="article-meta-sep" aria-hidden="true"> · </span>
                  <span>{readerCopy.updated} <time datetime={modifiedIso}>{formatPublishedDate(updatedDateObj, lang)}</time></span>
                </>
              )}
            </p>
            {post.data.tags && post.data.tags.length > 0 && (
              <ul class="post-tags article-tags">
                {post.data.tags.map((tag) => (
                  <li><a class="tag-pill" href={toLocalizedPath(`/blog/tag/${tagToUrlSlug(tag)}/`, lang)}>{tag}</a></li>
                ))}
              </ul>
            )}
          </div>
          {post.data.image && (
            <figure class="article-cover">
              <img src={post.data.image} alt={post.data.title} width="1200" height="750" loading="eager" decoding="async" />
            </figure>
          )}
        </div>
        <ArticleBrief slot="summary" lang={lang} tldr={tldrItems} audience={audienceItems} />
        <Content />
        <TopicClusterNav slot="footer" lang={lang} currentSlug={slug} />
      </ArticlePageLayout>
      {hasMermaid && <script type="module" src="/js/mermaid.js"></script>}
      {post.body.includes('data-pdf-viewer') && <script is:inline src="/js/pdf-viewer-init.js" defer></script>}
      {post.body.includes('data-youtube-facade') && <script is:inline src="/js/youtube-facade.js" defer></script>}
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>
