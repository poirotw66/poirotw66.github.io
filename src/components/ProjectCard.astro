---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const projectHref = toLocalizedPath(`/projects/${entry.id}/`, lang);
---

<div class="showcase-card">
  {entry.data.image && (
    <a href={projectHref} class="showcase-card-image-wrap" aria-hidden="true">
      <img
        src={entry.data.image}
        alt=""
        class="showcase-card-image"
        width="400"
        height="240"
        loading="lazy"
      />
    </a>
  )}

  <h3><a href={projectHref} class="showcase-card-title-link">{entry.data.title}</a></h3>

  {entry.data.impact && (
    <p class="showcase-impact">{entry.data.impact}</p>
  )}
  <p>{entry.data.description}</p>
</div>
