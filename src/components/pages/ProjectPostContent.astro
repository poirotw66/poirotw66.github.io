---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import ArticlePageLayout from '../article/ArticlePageLayout.astro';
import ArticleBrief from '../article/ArticleBrief.astro';
import EditorialCover from '../EditorialCover.astro';
import CategoryBadge from '../CategoryBadge.astro';
import { toLocalizedPath, useTranslations } from '../../i18n/utils';
import { formatPublishedDate, toDate } from '../../utils/formatPublishedDate';
import { projectTierLabel } from '../../utils/projectTierLabel';
import { labListParentPath, labZoneLabel, resolveLabZone } from '../../utils/labZone';
import { estimateReadingMinutes } from '../../utils/readingTime';
import { descriptionToTldr } from '../../utils/articleBrief';
import { baseSlug } from '../../utils/contentLocale';
import { hasMathContent } from '../../utils/mathContent';
import { hasHuahuaCallout } from '../../utils/huahuaCallout';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const { Content, headings } = await render(entry);
const hasMermaid = entry.body.includes('```mermaid');
const hasMath = hasMathContent(entry.body);
const hasHuahua = hasHuahuaCallout(entry.body);
const t = useTranslations(lang);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length > 0;
const slug = baseSlug(entry);
const site = Astro.site ?? new URL('https://www.bloss0m.com');
const canonicalUrl = new URL(toLocalizedPath(`/projects/${slug}/`, lang), site).toString();
const articleImage = entry.data.image
  ? new URL(entry.data.image, site).toString()
  : new URL('/og.webp', site).toString();
const pubDateObj = toDate(entry.data.pubDate);
const pubIso = pubDateObj.toISOString();
const updatedDateObj = entry.data.updatedDate ? toDate(entry.data.updatedDate) : null;
const modifiedIso = updatedDateObj?.toISOString() ?? pubIso;
const readingMinutes = estimateReadingMinutes(entry.body);
const readerCopy = lang === 'en'
  ? { progress: 'Article reading progress', copy: 'Copy code', copied: 'Copied', read: `${readingMinutes} min read`, updated: 'Updated' }
  : { progress: '文章閱讀進度', copy: '複製程式碼', copied: '已複製', read: `閱讀約 ${readingMinutes} 分鐘`, updated: '更新' };
const tldrItems = entry.data.tldr ?? [...descriptionToTldr(entry.data.description), ...(entry.data.impact ? [entry.data.impact] : [])].slice(0, 4);
const audienceItems = entry.data.audience ?? [
  lang === 'en'
    ? 'Engineers, technical leads, and product teams evaluating the architecture, trade-offs, and delivery results of a real project.'
    : '想了解真實專案架構、技術取捨、成效與落地方式的工程師、技術主管及產品團隊。',
];

const tierLine = projectTierLabel(entry.data.tier, lang);
const isLabTier = entry.data.tier === 'lab';
const labZone = isLabTier ? resolveLabZone(entry.data.labZone) : undefined;
const listParentPath = isLabTier
  ? labListParentPath(entry.data.labZone, lang)
  : toLocalizedPath('/projects/', lang);
const listParentLabel = isLabTier
  ? entry.data.labZone === 'competition'
    ? lang === 'en'
      ? 'Lab · Competitions'
      : '實驗室 · 競賽專區'
    : lang === 'en'
      ? 'Lab'
      : '實驗室'
  : lang === 'en'
    ? 'Projects'
    : '專案';
const listParentUrl = new URL(listParentPath, site).toString();
const kicker = isLabTier
  ? (lang === 'en' ? 'Lab note' : '實驗室筆記')
  : (lang === 'en' ? 'Project note' : '專案筆記');
const coverLabel = isLabTier
  ? (lang === 'en' ? 'Lab' : '實驗室')
  : (lang === 'en' ? 'Projects' : '專案');
const coverNumber = slug.match(/^\d+/)?.[0].padStart(3, '0') ?? '000';
---

<Layout
  title={`${entry.data.title} | Bloss0m`}
  description={entry.data.description}
  canonicalURL={new URL(toLocalizedPath(`/projects/${slug}/`, lang), site)}
  imageURL={articleImage}
  imageAlt={`${entry.data.title} — Bloss0m ${coverLabel}`}
  imageWidth={1200}
  imageHeight={entry.data.image ? 750 : 630}
  ogType="article"
  articlePublishedTime={pubIso}
  articleModifiedTime={modifiedIso}
  articleAuthor="Bloss0m"
  lang={lang}
  bodyClass="page-article"
>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href="/css/katex.min.css" />}
    {hasHuahua && <link rel="stylesheet" href="/css/huahua-callout.css" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: entry.data.title,
      description: entry.data.description,
      image: articleImage,
      datePublished: pubIso,
      dateModified: modifiedIso,
      author: { '@id': `${site.toString().replace(/\/$/, '')}/#person` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: listParentLabel, item: listParentUrl },
        { '@type': 'ListItem', position: 2, name: entry.data.title, item: canonicalUrl },
      ],
    })} />
  </Fragment>
  <div class="content-region">
    <section class="section-spacer-lg">
      <ArticlePageLayout
        showToc={showToc}
        tocHeadings={tocHeadings}
        tocLabel={t('blog.tocTitle')}
        progressLabel={readerCopy.progress}
        copyLabel={readerCopy.copy}
        copiedLabel={readerCopy.copied}
        wideHeader
      >
        <div
          slot="header"
          class="article-masthead article-masthead--with-cover article-masthead--wide"
        >
          <div class="article-masthead-copy">
            <a href={listParentPath} class="back">← {listParentLabel}</a>
            <p class="article-masthead-kicker">{kicker}</p>
            <h1>{entry.data.title}</h1>
            {entry.data.subtitle && <p class="article-subtitle">{entry.data.subtitle}</p>}
            <p class="article-meta article-facts">
              <CategoryBadge label={tierLine} />
              {isLabTier && labZone && (
                <>
                  <span class="article-meta-sep" aria-hidden="true"> · </span>
                  <span>{labZoneLabel(labZone, lang)}</span>
                </>
              )}
              <span class="article-meta-sep" aria-hidden="true"> · </span>
              <time datetime={pubIso}>{formatPublishedDate(pubDateObj, lang)}</time>
              <span class="article-meta-sep" aria-hidden="true"> · </span>
              <span class="article-reading-time">{readerCopy.read}</span>
              {updatedDateObj && (
                <>
                  <span class="article-meta-sep" aria-hidden="true"> · </span>
                  <span>{readerCopy.updated} <time datetime={modifiedIso}>{formatPublishedDate(updatedDateObj, lang)}</time></span>
                </>
              )}
            </p>
            {entry.data.repoUrl && (
              <p class="article-repo-link">
                <a href={entry.data.repoUrl} target="_blank" rel="noopener">
                  {lang === 'en' ? 'View on GitHub →' : '於 GitHub 檢視 →'}
                </a>
              </p>
            )}
          </div>
          <figure class="article-cover">
            <EditorialCover
              title={entry.data.title}
              image={entry.data.image}
              variant="engineering"
              label={coverLabel}
              number={coverNumber}
              size="hero"
              loading="eager"
              alt={entry.data.title}
            />
          </figure>
        </div>
        <ArticleBrief slot="summary" lang={lang} tldr={tldrItems} audience={audienceItems} />
        <Content />
        {entry.data.metrics && entry.data.metrics.length > 0 && (
          <div slot="footer" class="proj-metrics mt-section">
            {entry.data.metrics.map((m) => (
              <span>{m}</span>
            ))}
          </div>
        )}
      </ArticlePageLayout>
      {hasMermaid && <script type="module" src="/js/mermaid.js"></script>}
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<style>
  .article-repo-link {
    margin: 0.85rem 0 0;
  }

  .article-repo-link a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .article-repo-link a:hover {
    text-decoration: underline;
    color: var(--accent-hover);
  }
</style>
