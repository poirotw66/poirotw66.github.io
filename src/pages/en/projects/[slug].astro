---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectPostContent from '../../../components/pages/ProjectPostContent.astro';
import { resolveEntriesForLang, baseSlug } from '../../../utils/contentLocale';

export async function getStaticPaths() {
  const projects = resolveEntriesForLang(await getCollection('projects'), 'en');
  return projects.map((entry) => ({
    params: { slug: baseSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'projects'> };
---

<ProjectPostContent lang="en" entry={entry} />
