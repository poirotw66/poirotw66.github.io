---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { toLocalizedPath } from '../../i18n/utils';
import CtaBlock from '../CtaBlock.astro';
import SectionHeading from '../SectionHeading.astro';
import HomeRoadmap from '../HomeRoadmap.astro';
import HomeTrustBar from '../HomeTrustBar.astro';
import HomeCaseStudy from '../HomeCaseStudy.astro';
import HomeFeaturedWriting from '../HomeFeaturedWriting.astro';
import {
  BLOG_WRITING_SECTION_COPY,
  getPostsForLane,
} from '../../utils/blogLanes';
import { resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import {
  HOME_CASE_STUDY_SLUGS,
  homeCaseStudyDetails,
  type HomeCaseStudySlug,
} from '../../data/homeBrand';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allBlogPosts = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang));
const featuredWriting = getPostsForLane(allBlogPosts, 'starter').slice(0, 3);
const allProjectEntries = resolveEntriesForLang(await getCollection('projects'), lang);
const projectBySlug = new Map(allProjectEntries.map((entry) => [baseSlug(entry), entry]));
const projects = HOME_CASE_STUDY_SLUGS.flatMap((slug) => {
  const entry = projectBySlug.get(slug);
  return entry ? [entry] : [];
});
const publicBuildCount = allProjectEntries.filter((entry) => Boolean(entry.data.repoUrl)).length;
const isEn = lang === 'en';
const trustItems = isEn
  ? [
      {
        value: '98.0%',
        label: 'weighted RAG accuracy',
        detail: 'Fixed 100-query benchmark',
        href: toLocalizedPath('/projects/agentic-rag/', lang),
      },
      {
        value: '19',
        label: 'modular agent subflows',
        detail: 'Inspectable system design',
        href: toLocalizedPath('/projects/agentic-ai-platform/', lang),
      },
      {
        value: '5+',
        label: 'hospital formats normalized',
        detail: 'Built against real documents',
        href: toLocalizedPath('/projects/ocr-automation/', lang),
      },
      {
        value: publicBuildCount,
        label: 'public repositories',
        detail: 'Code and experiments in public',
        href: 'https://github.com/poirotw66',
      },
    ]
  : [
      {
        value: '98.0%',
        label: 'RAG 加權準確率',
        detail: '固定 100 題 benchmark',
        href: toLocalizedPath('/projects/agentic-rag/', lang),
      },
      {
        value: '19',
        label: '個模組化 Agent 子流程',
        detail: '可查驗的系統設計',
        href: toLocalizedPath('/projects/agentic-ai-platform/', lang),
      },
      {
        value: '5+',
        label: '種醫院格式正規化',
        detail: '以真實文件完成實作',
        href: toLocalizedPath('/projects/ocr-automation/', lang),
      },
      {
        value: publicBuildCount,
        label: '個公開程式庫',
        detail: '公開程式與技術實驗',
        href: 'https://github.com/poirotw66',
      },
    ];

const pageDescription =
  lang === 'en'
    ? "Bloss0m is Justin's public AI engineering lab: frontier research, working systems, architecture notes, and reproducible experiments."
    : 'Bloss0m 是 Justin 的公開 AI 工程實驗室，記錄前沿研究、可運行系統、架構判斷與可重現的技術實驗。';

const hero = isEn
  ? {
      eyebrow: 'Justin · AI Platform & Agentic AI Engineer',
      titleLines: ['Turn frontier AI', 'into systems', 'that actually run.'],
      tagline: 'Agent, RAG, and AI Platform engineering — from architecture and evaluation to deployment, operations, and handoff.',
      primaryCta: 'View case studies',
      primaryHref: '#showcase',
      secondaryCta: 'About & contact ↗',
      secondaryHref: toLocalizedPath('/contact/', lang),
      signalTitle: 'Three technical frontiers I keep building in',
      signals: [
        { title: 'Agent systems and coordination', body: 'Explore tool use, memory, multi-agent topology, evaluation, permissions, and safety boundaries — then implement the control plane around them.', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: 'Explore the agent engineering map →' },
        { title: 'Knowledge systems beyond basic RAG', body: 'Build retrieval, GraphRAG, multimodal document pipelines, source traceability, and evaluation for knowledge-intensive systems.', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: 'Explore the RAG engineering map →' },
        { title: 'AI engineering and agent harnesses', body: 'Study the infrastructure around models: context engineering, observability, regression evaluation, long-running workflows, and developer tooling.', href: toLocalizedPath('/blog/11-harness-engineering/', lang), cta: 'Read the harness engineering notes →' },
      ],
      showcaseTitle: 'Not concept slides — working systems you can inspect',
      showcaseLink: 'View all implementations',
      ctaText: 'I welcome invitations for conference talks, internal tech sessions, architecture exchange, and research or product collaboration around AI agents, RAG, AI platforms, and engineering practice.',
      ctaButton: 'Invite me to speak or connect',
      mascotLabel: 'Bloss0m field guide · Huahua',
      mascotLine: 'Huahua maps the trail from emerging signals to engineering evidence.',
      mascotAlt: 'Huahua, the Bloss0m calico cat mascot, surrounded by flowers and a star',
      kickerSignals: 'Focus',
      kickerShowcase: 'Projects',
      thesisEyebrow: 'Bloss0m engineering method',
      thesis: 'Frontier technology becomes useful only after it survives architecture, evaluation, and operations.',
      thesisSteps: ['Observe', 'Architect', 'Evaluate', 'Operate'],
    }
  : {
      eyebrow: 'Justin · AI Platform & Agentic AI Engineer',
      titleLines: ['把前沿 AI，', '做成真正能運行的系統。'],
      tagline: '專注 Agent、RAG 與 AI Platform，從架構與評測一路做到部署、維運與交接。',
      primaryCta: '查看代表案例',
      primaryHref: '#showcase',
      secondaryCta: '關於與聯絡 ↗',
      secondaryHref: toLocalizedPath('/contact/', lang),
      signalTitle: '我持續實作的三條技術前線',
      signals: [
        { title: 'Agent 系統與協作架構', body: '研究工具使用、記憶、多代理拓撲、評測、權限與安全邊界，並實作支撐 Agent 的控制層。', href: toLocalizedPath('/blog/64-ai-agent-guide/', lang), cta: '看 Agent Engineering 技術地圖 →' },
        { title: '超越基礎 RAG 的知識系統', body: '實作檢索、GraphRAG、多模態文件管線、來源追溯與評測，處理知識密集型問題。', href: toLocalizedPath('/blog/65-enterprise-rag-guide/', lang), cta: '看 RAG Engineering 技術地圖 →' },
        { title: 'AI Engineering 與 Agent Harness', body: '拆解模型周邊的工程基礎：Context Engineering、可觀測性、回歸評測、長任務工作流與開發工具。', href: toLocalizedPath('/blog/11-harness-engineering/', lang), cta: '看 Harness Engineering 筆記 →' },
      ],
      showcaseTitle: '不是概念簡報，是可以打開查驗的實作',
      showcaseLink: '看全部實作',
      ctaText: '歡迎企業、社群與技術團隊邀請研討會演講、內部技術分享、架構交流，以及 Agent、RAG、AI Platform 相關的研究或產品合作。',
      ctaButton: '邀請演講或技術交流',
      mascotLabel: 'Bloss0m 技術導覽 · 花花',
      mascotLine: '花花標記從前沿訊號走到工程證據的研究路徑。',
      mascotAlt: 'Bloss0m 三花貓吉祥物花花，身旁有花朵與星星',
      kickerSignals: '重點 · Focus',
      kickerShowcase: '專案 · Projects',
      thesisEyebrow: 'Bloss0m 工程方法',
      thesis: '前沿技術，通過架構、評測與維運的完整驗證後，才真正有用。',
      thesisSteps: ['觀察', '架構', '評測', '維運'],
    };
---

<Layout
  title={isEn ? 'Bloss0m | Justin · AI Platform & Agentic AI Engineer' : 'Bloss0m｜Justin · AI Platform 與 Agentic AI 工程師'}
  description={pageDescription}
  lang={lang}
  bodyClass="page-home"
>
  <>
    <section id="hero" class="home-hero section-reveal home-scroll-anchor">
      <div class="home-hero-grid">
        <div class="home-hero-copy surface-raised">
          <p class="hero-eyebrow">{hero.eyebrow}</p>
          <h1 class="hero-title">
            {hero.titleLines.map((line) => <span>{line}</span>)}
          </h1>
          <p class="hero-tagline">{hero.tagline}</p>
          <div class="hero-actions">
            <a href={hero.primaryHref} class="btn btn-primary">{hero.primaryCta}</a>
            <a href={hero.secondaryHref} class="hero-contact-link">{hero.secondaryCta}</a>
          </div>
        </div>

        <aside class="hero-spotlight hero-mascot surface-raised" aria-label={hero.mascotLabel}>
          <p class="hero-spotlight-label">{hero.mascotLabel}</p>
          <div class="hero-spotlight-media hero-mascot-media surface-inset">
            <picture>
              <source media="(max-width: 640px)" srcset="/brand/bloom-mark-128.webp" />
              <img
                src="/brand/bloom-hero.webp"
                alt={hero.mascotAlt}
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div class="hero-spotlight-body hero-mascot-body">
            <p class="hero-mascot-line">{hero.mascotLine}</p>
            <div class="hero-studio-signature" aria-label={isEn ? 'Bloss0m roles' : 'Bloss0m 角色'}>
              <span><strong>Justin</strong>{isEn ? 'Research · Architecture · Implementation' : '研究 · 架構 · 實作'}</span>
              <span><strong>{isEn ? 'Huahua' : '花花'}</strong>{isEn ? 'Research trail guide' : '研究路徑導覽'}</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <HomeTrustBar
      label={isEn ? 'Public engineering evidence — open the source behind each signal' : '公開工程證據｜每一項都有實作或評測可以查驗'}
      items={trustItems}
    />

    <section class="home-thesis section-reveal" aria-labelledby="home-thesis-title">
      <div>
        <p>{hero.thesisEyebrow}</p>
        <h2 id="home-thesis-title">{hero.thesis}</h2>
      </div>
      <ol>
        {hero.thesisSteps.map((step, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>
        ))}
      </ol>
    </section>

    <section id="focus" class="section-reveal home-signals home-scroll-anchor home-editorial-section">
      <SectionHeading kicker={hero.kickerSignals} title={hero.signalTitle} index="01" />
      <ol class="home-focus-list">
        {hero.signals.map((signal, index) => (
          <li>
            <span class="home-focus-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{signal.title}</h3>
              <p>{signal.body}</p>
            </div>
            <a class="home-focus-link" href={signal.href}>{signal.cta}</a>
          </li>
        ))}
      </ol>
    </section>

    <HomeRoadmap lang={lang} />

    <section id="showcase" class="section-reveal home-scroll-anchor home-editorial-section">
      <SectionHeading kicker={hero.kickerShowcase} title={hero.showcaseTitle} index="03" />
      <div class="home-case-study-list">
        {projects.map((entry, index) => (
          <HomeCaseStudy
            entry={entry}
            lang={lang}
            index={index + 1}
            detail={homeCaseStudyDetails[lang][baseSlug(entry) as HomeCaseStudySlug]}
          />
        ))}
      </div>
      <p class="text-center-mt">
        <a href={toLocalizedPath('/projects/', lang)} class="btn btn-secondary">{hero.showcaseLink}</a>
      </p>
    </section>

    <section id="writing" class="section-reveal home-scroll-anchor home-editorial-section">
      <SectionHeading
        kicker={isEn ? BLOG_WRITING_SECTION_COPY.kicker.en : BLOG_WRITING_SECTION_COPY.kicker.zh}
        title={isEn ? BLOG_WRITING_SECTION_COPY.title.en : BLOG_WRITING_SECTION_COPY.title.zh}
        index="04"
      />
      <p class="home-section-lead">
        {isEn ? BLOG_WRITING_SECTION_COPY.lead.en : BLOG_WRITING_SECTION_COPY.lead.zh}
      </p>
      <HomeFeaturedWriting posts={featuredWriting} lang={lang} />

      <p class="text-center-mt">
        <a href={toLocalizedPath('/blog/', lang)} class="btn btn-secondary">
          {isEn ? BLOG_WRITING_SECTION_COPY.topCta.en : BLOG_WRITING_SECTION_COPY.topCta.zh}
        </a>
      </p>
    </section>

    <CtaBlock
      id="cta"
      eyebrow={isEn ? 'Speaking · Exchange · Collaboration' : '演講 · 交流 · Collaboration'}
      title={isEn ? 'Bring frontier AI and engineering reality into the same conversation.' : '把前沿 AI 講清楚，也把工程現場帶進討論'}
      text={hero.ctaText}
      buttonText={hero.ctaButton}
      buttonHref={toLocalizedPath('/contact/', lang)}
    />
    <script src="/js/home-scroll-hash.js" defer></script>
  </>
</Layout>
