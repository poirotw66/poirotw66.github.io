---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CtaLinkedIn from '../../components/CtaLinkedIn.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Bloss0m`}
  description={entry.data.description}
  canonicalURL={new URL(`/projects/${entry.id}/`, Astro.site)}
>
  <div class="content-region">
    <header class="page-header">
      <div class="page-header-inner">
        <h1>{entry.data.title}</h1>
        {entry.data.subtitle && <p>{entry.data.subtitle}</p>}
        {entry.data.repoUrl && (
          <p class="mt-half">
            <a href={entry.data.repoUrl} target="_blank" rel="noopener">View on GitHub →</a>
          </p>
        )}
      </div>
    </header>

    <section class="proj-detail-section section-spacer">
      <div class="article-body proj-detail-body">
        <Content />
      </div>
      <script type="module" src="/js/mermaid.js"></script>
      {entry.data.metrics && entry.data.metrics.length > 0 && (
        <div class="proj-metrics mt-section">
          {entry.data.metrics.map((m) => (
            <span>{m}</span>
          ))}
        </div>
      )}
    </section>

    <div class="block-en">
      <CtaLinkedIn lang="en" />
    </div>
    <div class="block-zh">
      <CtaLinkedIn lang="zh" />
    </div>
  </div>
</Layout>

<style>
  .proj-detail-section {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .proj-detail-body {
    min-width: 0;
  }
  .proj-detail-body h2 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .proj-detail-body h2:first-child {
    margin-top: 0;
  }
  .proj-detail-body p,
  .proj-detail-body ul {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .proj-detail-body ul {
    padding-left: 1.5rem;
  }
  .proj-detail-body pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 1rem 0;
  }
  .proj-detail-body code {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--surface);
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .proj-detail-body pre code {
    padding: 0;
    background: none;
    border: none;
  }
  .proj-detail-body .mermaid {
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: visible;
    text-align: center;
    padding: 0.25rem 0;
    -webkit-overflow-scrolling: touch;
  }
  .proj-detail-body .mermaid svg {
    display: block;
    max-width: none;
    height: auto;
  }
</style>
