---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { tagToUrlSlug } from '../../utils/tag';
import PageHeader from '../../components/PageHeader.astro';
import CtaLinkedIn from '../../components/CtaLinkedIn.astro';

const posts = sortByPubDate(await getCollection('blog'));
const formatDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout
  title="Blog | Bloss0m"
  description="Articles on Generative AI, Enterprise AI, and Realtime AI. Agent design, RAG, evaluation, governance."
>
  <div class="block-en">
    <div class="content-region">
      <PageHeader title="Blog" subtitle="Generative AI · Enterprise AI · Realtime AI" />

      <section class="section-spacer">
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              <div class="meta">{post.data.category} · {formatDate(post.data.pubDate)}</div>
              {post.data.tags && post.data.tags.length > 0 && (
                <ul class="post-tags">
                  {post.data.tags.map((t) => (
                    <li><a href={`/blog/tag/${tagToUrlSlug(t)}/`}>{t}</a></li>
                  ))}
                </ul>
              )}
              {post.data.description && <p class="blog-list-desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      </section>

      <CtaLinkedIn lang="en" />
    </div>
  </div>

  <div class="block-zh">
    <div class="content-region">
      <PageHeader title="部落格" subtitle="生成式 AI · 企業 AI · 即時 AI" />

      <section class="section-spacer">
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              <div class="meta">{post.data.category} · {formatDate(post.data.pubDate)}</div>
              {post.data.tags && post.data.tags.length > 0 && (
                <ul class="post-tags">
                  {post.data.tags.map((t) => (
                    <li><a href={`/blog/tag/${tagToUrlSlug(t)}/`}>{t}</a></li>
                  ))}
                </ul>
              )}
              {post.data.description && <p class="blog-list-desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      </section>

      <CtaLinkedIn lang="zh" />
    </div>
  </div>
</Layout>
