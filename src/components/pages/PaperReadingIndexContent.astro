---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import PaperReadingListItem from '../PaperReadingListItem.astro';

interface Props {
  lang: Lang;
}

type PaperEntry = CollectionEntry<'paperReading'>;

const { lang } = Astro.props;
const entries = sortByPubDate(await getCollection('paperReading'));

const uniqueSorted = (values: Array<string | undefined>): string[] => {
  const set = new Set(values.filter((v): v is string => v != null && v.trim().length > 0).map((v) => v.trim()));
  return Array.from(set).sort((a, b) => a.localeCompare(b));
};

const fields = uniqueSorted(entries.map((e) => e.data.field));
const difficulties = uniqueSorted(entries.map((e) => e.data.difficulty));
const years = uniqueSorted(entries.map((e) => String(e.data.paper.year))).sort((a, b) => Number(b) - Number(a));
const isEn = lang === 'en';
---

<Layout
  title={lang === 'en' ? 'Paper Reading | Bloss0m' : '論文精讀 | Bloss0m'}
  description={lang === 'en' ? 'Paper Reading hub: deep dives, structured notes, and reproducible takeaways.' : '論文精讀：深讀筆記、系列整理與可複現重點。'}
  lang={lang}
>
  <div class="content-region">
    <PageHeader
      title={lang === 'en' ? 'Paper Reading' : '論文精讀'}
      subtitle={lang === 'en' ? 'Deep dives · Series · Reproducible notes' : '深讀筆記 · 系列整理 · 可複現重點'}
    />

    <section class="section-spacer" style="margin-top: 0">
      <div class="filters" id="paper-reading-filters">
        <div class="filter-row filter-row-query">
          <label class="filter-label" for="filter-query">{isEn ? 'Keyword' : '關鍵字'}</label>
          <input
            id="filter-query"
            class="filter-input"
            type="search"
            placeholder={isEn ? 'Search title, summary, field, tags...' : '搜尋標題、摘要、領域、標籤...'}
            autocomplete="off"
          />
        </div>
        <div class="filter-row">
          <label class="filter-label" for="filter-field">{lang === 'en' ? 'Field' : '領域'}</label>
          <select id="filter-field" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {fields.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
        <div class="filter-row">
          <label class="filter-label" for="filter-difficulty">{lang === 'en' ? 'Difficulty' : '難度'}</label>
          <select id="filter-difficulty" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {difficulties.map((d) => <option value={d}>{d}</option>)}
          </select>
        </div>
        <div class="filter-row">
          <label class="filter-label" for="filter-year">{lang === 'en' ? 'Year' : '年份'}</label>
          <select id="filter-year" class="filter-select">
            <option value="">{lang === 'en' ? 'All' : '全部'}</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>
        <button type="button" class="btn btn-secondary filter-reset" id="filter-reset">{lang === 'en' ? 'Reset' : '重設'}</button>
      </div>
      <p id="paper-reading-summary" class="article-meta mt-half"></p>
    </section>

    <section class="section-spacer">
      {entries.length === 0 ? (
        <p class="article-meta">{lang === 'en' ? 'No paper reading posts yet.' : '目前尚無論文精讀文章。'}</p>
      ) : (
        <ul class="blog-list" id="paper-reading-list">
          {entries.map((entry: PaperEntry) => (
            <PaperReadingListItem entry={entry} lang={lang} />
          ))}
        </ul>
      )}
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>

<script is:inline>
  const root = document.getElementById('paper-reading-filters') ?? document;
  const list = document.getElementById('paper-reading-list');
  const summary = document.getElementById('paper-reading-summary');
  if (list) {
    const queryEl = root.querySelector('#filter-query');
    const fieldEl = root.querySelector('#filter-field');
    const difficultyEl = root.querySelector('#filter-difficulty');
    const yearEl = root.querySelector('#filter-year');
    const resetEl = document.getElementById('filter-reset');
    const isEn = document.documentElement.lang === 'en';

    const apply = () => {
      const query = (queryEl?.value ?? '').trim().toLowerCase();
      const field = fieldEl?.value ?? '';
      const difficulty = difficultyEl?.value ?? '';
      const year = yearEl?.value ?? '';
      let visibleCount = 0;

      const items = list.querySelectorAll('[data-paper-reading-item="1"]');
      items.forEach((el) => {
        const searchText = (el.getAttribute('data-search-text') ?? '').toLowerCase();
        const okQuery = !query || searchText.includes(query);
        const okField = !field || el.getAttribute('data-field') === field;
        const okDifficulty = !difficulty || el.getAttribute('data-difficulty') === difficulty;
        const okYear = !year || el.getAttribute('data-year') === year;
        const visible = okQuery && okField && okDifficulty && okYear;
        el.style.display = visible ? '' : 'none';
        if (visible) visibleCount += 1;
      });

      if (summary) {
        summary.textContent = isEn ? `${visibleCount} result(s)` : `共 ${visibleCount} 篇文章`;
      }
    };

    queryEl?.addEventListener('input', apply);
    fieldEl?.addEventListener('change', apply);
    difficultyEl?.addEventListener('change', apply);
    yearEl?.addEventListener('change', apply);

    resetEl?.addEventListener('click', () => {
      if (queryEl) queryEl.value = '';
      if (fieldEl) fieldEl.value = '';
      if (difficultyEl) difficultyEl.value = '';
      if (yearEl) yearEl.value = '';
      apply();
    });

    apply();
  }
</script>

<style>
  .filters {
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) repeat(3, minmax(180px, 0.55fr)) auto;
    gap: 0.8rem;
    align-items: end;
    margin-bottom: 0.8rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface) 96%, #fff 4%),
        color-mix(in srgb, var(--surface) 98%, transparent)
      );
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(42, 34, 24, 0.05);
  }
  :global([data-theme="dark"]) .filters {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface) 88%, #0b1018 12%),
        color-mix(in srgb, var(--surface) 94%, transparent)
      );
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
  }
  .filter-row {
    display: grid;
    gap: 0.25rem;
  }
  .filter-row-query {
    min-width: 0;
  }
  .filter-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .filter-input,
  .filter-select {
    height: 42px;
    padding: 0.55rem 0.72rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg) 94%, #fff 6%);
    color: var(--text);
    font: inherit;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .filter-input::placeholder {
    color: color-mix(in srgb, var(--text-muted) 82%, transparent);
  }
  .filter-input:focus-visible,
  .filter-select:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-soft) 85%, transparent);
    background: var(--bg);
  }
  .filter-reset {
    height: 42px;
    align-self: end;
    white-space: nowrap;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (max-width: 1080px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
    .filter-row-query {
      grid-column: 1 / -1;
    }
    .filter-reset {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
  @media (max-width: 720px) {
    .filters {
      grid-template-columns: 1fr;
    }
    .filter-row-query,
    .filter-reset {
      grid-column: auto;
    }
  }
</style>
