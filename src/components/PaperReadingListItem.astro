---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'paperReading'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const href = toLocalizedPath(`/paper-reading/${entry.id}/`, lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const year = String(entry.data.paper.year);
const field = entry.data.field ?? '';
const difficulty = entry.data.difficulty ?? '';
---

<li
  class="blog-list-item"
  data-paper-reading-item="1"
  data-year={year}
  data-field={field}
  data-difficulty={difficulty}
>
  {entry.data.image && (
    <a href={href} class="blog-list-thumb" aria-hidden="true">
      <img src={entry.data.image} alt="" class="blog-list-thumb-img" width="200" height="125" loading="lazy" />
    </a>
  )}
  <div class="blog-list-body">
    <a href={href}>{entry.data.title}</a>
    <div class="meta">
      {entry.data.series ? (
        <>
          <a class="series-chip" href={toLocalizedPath(`/paper-reading/series/${entry.data.series.id}/`, lang)}>
            {entry.data.series.title} · Part {entry.data.series.part}
          </a>
          <span class="meta-sep">·</span>
        </>
      ) : null}
      <span>{formatDate(entry.data.pubDate)}</span>
      <span class="meta-sep">·</span>
      <span>{entry.data.paper.year}</span>
      {entry.data.field && (
        <>
          <span class="meta-sep">·</span>
          <span>{entry.data.field}</span>
        </>
      )}
      {entry.data.difficulty && (
        <>
          <span class="meta-sep">·</span>
          <span class="difficulty">{entry.data.difficulty}</span>
        </>
      )}
    </div>
    <p class="blog-list-desc">{entry.data.description}</p>
  </div>
</li>

<style>
  .meta-sep {
    opacity: 0.7;
    margin: 0 0.25rem;
  }
  .series-chip {
    text-decoration: none;
  }
  .series-chip:hover {
    text-decoration: underline;
  }
  .difficulty {
    text-transform: capitalize;
  }
</style>
