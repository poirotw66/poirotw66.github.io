---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import HuahuaEmptyState from '../HuahuaEmptyState.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import { toLocalizedPath } from '../../i18n/utils';
import { blogSlug, resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';

interface Props {
  lang: Lang;
}

interface SearchItem {
  type: 'blog' | 'paperReading' | 'projects';
  title: string;
  description: string;
  url: string;
  date: string;
  tags: string[];
  category: string;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const blog = sortByPubDate(resolveBlogPostsForLang(await getCollection('blog'), lang)).map((entry): SearchItem => ({
  type: 'blog',
  title: entry.data.title,
  description: entry.data.description,
  url: toLocalizedPath(`/blog/${blogSlug(entry)}/`, lang),
  date: entry.data.pubDate.toISOString(),
  tags: entry.data.tags ?? [],
  category: entry.data.category,
}));

const paperReading = sortByPubDate(resolveEntriesForLang(await getCollection('paperReading'), lang)).map((entry): SearchItem => ({
  type: 'paperReading',
  title: entry.data.title,
  description: entry.data.description,
  url: toLocalizedPath(`/paper-reading/${baseSlug(entry)}/`, lang),
  date: entry.data.pubDate.toISOString(),
  tags: entry.data.tags ?? [],
  category: entry.data.field ?? (isEn ? 'Paper Reading' : '論文精讀'),
}));

const projects = sortByPubDate(resolveEntriesForLang(await getCollection('projects'), lang)).map((entry): SearchItem => ({
  type: 'projects',
  title: entry.data.title,
  description: entry.data.description,
  url: toLocalizedPath(`/projects/${baseSlug(entry)}/`, lang),
  date: entry.data.pubDate.toISOString(),
  tags: entry.data.metrics ?? [],
  category: isEn ? 'Project' : '專案',
}));

const items = [...blog, ...paperReading, ...projects].sort((a, b) => (a.date > b.date ? -1 : 1));
---

<Layout
  title={isEn ? 'Search | Bloss0m' : '搜尋 | Bloss0m'}
  description={isEn ? 'Search across blog posts, paper reading notes, and projects.' : '跨部落格、論文精讀與專案內容搜尋。'}
  lang={lang}
>
  <div class="content-region">
    <PageHeader
      title={isEn ? 'Search' : '搜尋'}
      subtitle={isEn ? 'Find blog posts, paper notes, and projects' : '快速找到部落格、論文精讀與專案'}
    />

    <section class="section-spacer inner-page-sections">
      <div class="search-controls">
        <div class="search-row search-row-query">
          <label class="search-label" for="site-search-input">{isEn ? 'Keyword' : '關鍵字'}</label>
          <input
            id="site-search-input"
            type="search"
            class="search-input"
            placeholder={isEn ? 'Search title, description, tags...' : '搜尋標題、描述、標籤...'}
            autocomplete="off"
          />
        </div>
        <div class="search-row">
          <label class="search-label" for="site-search-type">{isEn ? 'Type' : '類型'}</label>
          <select id="site-search-type" class="search-select">
            <option value="all">{isEn ? 'All types' : '全部類型'}</option>
            <option value="blog">Blog</option>
            <option value="paperReading">{isEn ? 'Paper Reading' : '論文精讀'}</option>
            <option value="projects">{isEn ? 'Projects' : '專案'}</option>
          </select>
        </div>
        <button type="button" id="site-search-reset" class="btn btn-secondary search-reset">
          {isEn ? 'Reset' : '重設'}
        </button>
      </div>

      <p id="site-search-summary" class="article-meta" role="status" aria-live="polite"></p>
      <ul id="site-search-results" class="blog-list"></ul>
      <button type="button" id="site-search-more" class="btn btn-secondary search-more" hidden>
        {isEn ? 'Show more results' : '顯示更多結果'}
      </button>
      <HuahuaEmptyState
        id="site-search-empty"
        kicker={isEn ? 'Huahua checked every note' : '花花翻過所有筆記了'}
        title={isEn ? 'Nothing matches this search yet.' : '暫時找不到相符內容。'}
        description={isEn ? 'Try a broader keyword, switch the content type, or continue from one of the curated paths below.' : '可以縮短關鍵字、切換內容類型，或從下方精選入口繼續閱讀。'}
        compact
        hidden
        live="polite"
      >
        <p class="huahua-empty-detail" id="site-search-empty-query"></p>
        <Fragment slot="actions">
          <button type="button" id="site-search-empty-reset" class="btn btn-primary">
            {isEn ? 'Clear search' : '清除搜尋'}
          </button>
          <a href={toLocalizedPath('/blog/64-ai-agent-guide/', lang)} class="btn btn-secondary">
            {isEn ? 'Start with AI agents' : '從 AI Agent 開始'}
          </a>
          <a href={toLocalizedPath('/blog/65-enterprise-rag-guide/', lang)} class="btn btn-secondary">
            {isEn ? 'Explore enterprise RAG' : '探索企業 RAG'}
          </a>
        </Fragment>
      </HuahuaEmptyState>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ items, lang }}>
  const input = document.getElementById('site-search-input');
  const typeSelect = document.getElementById('site-search-type');
  const resetButton = document.getElementById('site-search-reset');
  const resultList = document.getElementById('site-search-results');
  const summary = document.getElementById('site-search-summary');
  const moreButton = document.getElementById('site-search-more');
  const emptyState = document.getElementById('site-search-empty');
  const emptyQuery = document.getElementById('site-search-empty-query');
  const emptyResetButton = document.getElementById('site-search-empty-reset');
  const locale = lang === 'en' ? 'en-US' : 'zh-TW';
  const PAGE_SIZE = 12;
  let visibleCount = PAGE_SIZE;

  const TYPE_LABEL = {
    blog: 'Blog',
    paperReading: lang === 'en' ? 'Paper Reading' : '論文精讀',
    projects: lang === 'en' ? 'Project' : '專案',
  };

  const formatDate = (iso) =>
    new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });

  const normalize = (value) => value.toLowerCase().trim();

  const matchItem = (item, query, selectedType) => {
    if (selectedType !== 'all' && item.type !== selectedType) {
      return false;
    }
    if (!query) {
      return true;
    }
    const text = [
      item.title,
      item.description,
      item.category,
      ...(item.tags ?? []),
    ]
      .join(' ')
      .toLowerCase();
    return text.includes(query);
  };

  const render = () => {
    const query = normalize(input?.value ?? '');
    const selectedType = typeSelect?.value ?? 'all';
    const matched = items.filter((item) => matchItem(item, query, selectedType));
    const visibleItems = matched.slice(0, visibleCount);

    if (summary) {
      if (lang === 'en') {
        summary.textContent = matched.length > visibleItems.length
          ? `${matched.length} result(s), showing ${visibleItems.length}`
          : `${matched.length} result(s)`;
      } else {
        summary.textContent = matched.length > visibleItems.length
          ? `共 ${matched.length} 筆結果，目前顯示 ${visibleItems.length} 筆`
          : `共 ${matched.length} 筆結果`;
      }
    }

    if (!resultList) {
      return;
    }

    const hasResults = matched.length > 0;
    resultList.hidden = !hasResults;
    if (emptyState) {
      emptyState.hidden = hasResults;
    }
    if (moreButton) {
      moreButton.hidden = !hasResults || visibleItems.length >= matched.length;
    }
    if (emptyQuery) {
      if (lang === 'en') {
        emptyQuery.textContent = query
          ? `Current keyword: “${input?.value.trim() ?? ''}”`
          : 'No content is available under the selected type.';
      } else {
        emptyQuery.textContent = query
          ? `目前關鍵字：「${input?.value.trim() ?? ''}」`
          : '目前選擇的內容類型沒有可顯示的項目。';
      }
    }

    if (!hasResults) {
      resultList.replaceChildren();
      return;
    }

    const escapeHtml = (value) =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');

    resultList.innerHTML = visibleItems
      .map((item) => {
        const tags = (item.tags ?? [])
          .slice(0, 4)
          .map((tag) => `<li><span class="tag-pill">${escapeHtml(tag)}</span></li>`)
          .join('');
        const tagsHtml = tags ? `<ul class="post-tags">${tags}</ul>` : '';
        return `
          <li class="blog-list-item">
            <div class="blog-list-body">
              <a href="${escapeHtml(item.url)}">${escapeHtml(item.title)}</a>
              <div class="meta">${TYPE_LABEL[item.type]} · ${escapeHtml(item.category)} · ${formatDate(item.date)}</div>
              <p class="blog-list-desc">${escapeHtml(item.description)}</p>
              ${tagsHtml}
            </div>
          </li>
        `;
      })
      .join('');
  };

  input?.addEventListener('input', () => {
    visibleCount = PAGE_SIZE;
    render();
  });
  typeSelect?.addEventListener('change', () => {
    visibleCount = PAGE_SIZE;
    render();
  });
  resetButton?.addEventListener('click', () => {
    if (input) input.value = '';
    if (typeSelect) typeSelect.value = 'all';
    visibleCount = PAGE_SIZE;
    render();
  });
  emptyResetButton?.addEventListener('click', () => {
    if (input) input.value = '';
    if (typeSelect) typeSelect.value = 'all';
    visibleCount = PAGE_SIZE;
    render();
    input?.focus();
  });
  moreButton?.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    render();
  });
  render();
</script>

<style>
  .search-controls {
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) minmax(180px, 0.55fr) auto;
    gap: 0.8rem;
    align-items: end;
    margin-bottom: 0.8rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface) 96%, #fff 4%),
        color-mix(in srgb, var(--surface) 98%, transparent)
      );
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(42, 34, 24, 0.05);
  }
  .search-row {
    display: grid;
    gap: 0.25rem;
  }
  .search-row-query {
    min-width: 0;
  }
  .search-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .search-input,
  .search-select {
    height: 42px;
    padding: 0.55rem 0.72rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    font: inherit;
    background: color-mix(in srgb, var(--bg) 94%, #fff 6%);
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .search-input::placeholder {
    color: color-mix(in srgb, var(--text-muted) 82%, transparent);
  }
  .search-input:focus-visible,
  .search-select:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-soft) 85%, transparent);
    background: var(--bg);
  }
  .search-reset {
    height: 42px;
    align-self: end;
    white-space: nowrap;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .search-more {
    display: flex;
    margin: 1.5rem auto 0;
  }
  .search-more[hidden] {
    display: none;
  }
  @media (max-width: 1080px) {
    .search-controls {
      grid-template-columns: 1fr;
    }
    .search-reset {
      width: 100%;
    }
    .search-more {
      width: 100%;
      justify-content: center;
    }
  }
  @media (max-width: 720px) {
    .search-controls {
      grid-template-columns: 1fr;
    }
  }
</style>
