---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const stickers = (await getCollection('stickers')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<Layout
  title="AI Platform & Agentic AI Engineer | Designing Scalable AI Platforms"
  description="I design and build enterprise-grade AI platforms, focusing on RAG, multi-agent collaboration, and real-time AI systems."
>
  <div class="block-en">
    <header class="hero">
      <div class="hero-inner">
        <p class="hero-tag">AI Platform & Agentic AI Engineer</p>
        <h1>Designing Scalable AI Platforms</h1>
        <p class="hero-sub">RAG · Multi-Agent · Realtime AI</p>
        <p class="hero-desc">I design and build enterprise-grade AI platforms, focusing on RAG, multi-agent collaboration, and real-time AI systems. From PoC to production—reducing risk and cost for enterprise GenAI adoption.</p>
        <div class="hero-cta">
          <a href="/#showcase" class="btn btn-primary">View Projects</a>
          <a href="/contact/" class="btn btn-secondary">Get in Touch</a>
        </div>
      </div>
    </header>

    <section id="pillars">
      <div class="section-title">What I Build</div>
      <div class="pillars">
        <div class="pillar-card">
          <h3>Enterprise AI</h3>
          <p>Knowledge assistants, fact-checking agents, and Copilot-style systems that integrate with existing workflows.</p>
          <div class="pillar-tags">
            <span>M365 Copilot</span>
            <span>Knowledge assistant</span>
            <span>Fact-checking agent</span>
          </div>
        </div>
        <div class="pillar-card">
          <h3>Agentic Systems</h3>
          <p>Multi-agent collaboration, workflow automation, and tool orchestration for complex reasoning and execution.</p>
          <div class="pillar-tags">
            <span>Multi-agent</span>
            <span>Workflow automation</span>
            <span>n8n</span>
          </div>
        </div>
        <div class="pillar-card">
          <h3>Realtime AI</h3>
          <p>Voice AI, low-latency LLM pipelines, and streaming interfaces for customer support and live interactions.</p>
          <div class="pillar-tags">
            <span>Voice AI</span>
            <span>Low latency LLM</span>
            <span>Customer service</span>
          </div>
        </div>
      </div>
    </section>

    <section id="showcase">
      <div class="section-title">Selected Projects</div>
      <div class="showcase">
        <div class="showcase-card">
          <h3>Agentic AI Platform</h3>
          <p>Fact verification, knowledge search, and research automation with 15 agents—built for scale and trust.</p>
          <div class="showcase-metrics">161 users · AIGO Top 20</div>
          <a href="/projects/agentic-ai-platform/" class="btn btn-secondary">View project</a>
        </div>
        <div class="showcase-card">
          <h3>Enterprise RAG</h3>
          <p>Agentic RAG on M365 Copilot Studio for instant customer support and knowledge retrieval.</p>
          <div class="showcase-metrics">Copilot Studio · LLM judge</div>
          <a href="/projects/enterprise-rag/" class="btn btn-secondary">View project</a>
        </div>
        <div class="showcase-card">
          <h3>Realtime Voice AI</h3>
          <p>MCP + Realtime GPT integration for voice-driven customer support and low-latency dialogue.</p>
          <div class="showcase-metrics">Voice · Customer support</div>
          <a href="/projects/realtime-voice-ai/" class="btn btn-secondary">View project</a>
        </div>
        <div class="showcase-card">
          <h3>OCR Automation</h3>
          <p>Medical receipt OCR for financial and healthcare workflows—production deployment with high accuracy.</p>
          <div class="showcase-metrics">95% accuracy · Production</div>
          <a href="/projects/ocr-automation/" class="btn btn-secondary">View project</a>
        </div>
      </div>
    </section>

    <section id="stickers">
      <div class="section-title">LINE Stickers</div>
      <div class="sticker-grid">
        {stickers.map((entry) => (
          <div class="sticker-card">
            {entry.data.image ? (
              <a href={entry.data.lineStoreUrl} target="_blank" rel="noopener" class="sticker-card-image">
                <img src={entry.data.image} alt={entry.data.title} width="240" height="240" loading="lazy" />
              </a>
            ) : (
              <div class="sticker-card-image sticker-card-placeholder" aria-hidden="true">LINE</div>
            )}
            <div class="sticker-card-body">
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <a href={entry.data.lineStoreUrl} class="btn btn-secondary" target="_blank" rel="noopener">LINE Store</a>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align: center; margin-top: 1rem;">
        <a href="/stickers/" class="btn btn-secondary">View all</a>
      </p>
    </section>

    <section id="blog-preview">
      <div class="section-title">Latest from Blog</div>
      <div class="blog-preview">
        {posts.map((post) => (
          <div class="blog-preview-item">
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            <span>{post.data.category}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="cta-block">
      <p>Looking for an AI platform or Agentic AI partner? I help teams ship enterprise-grade RAG, multi-agent, and real-time AI systems.</p>
      <a href="/contact/" class="btn btn-primary">Contact</a>
    </div>

    <footer class="footer">
      <p>AI Platform & Agentic AI Engineer · RAG · Multi-Agent · Realtime AI</p>
    </footer>
  </div>

  <div class="block-zh">
    <header class="hero">
      <div class="hero-inner">
        <p class="hero-tag">AI 平台與 Agentic AI 工程師</p>
        <h1>設計可擴展的 AI 平台</h1>
        <p class="hero-sub">RAG · 多代理 · 即時 AI</p>
        <p class="hero-desc">我設計並建構企業級 AI 平台，專注於 RAG、多代理協作與即時 AI 系統。從 PoC 到上線——降低企業採用 GenAI 的風險與成本。</p>
        <div class="hero-cta">
          <a href="/#showcase" class="btn btn-primary">看專案</a>
          <a href="/contact/" class="btn btn-secondary">聯絡我</a>
        </div>
      </div>
    </header>

    <section id="pillars">
      <div class="section-title">我專注的領域</div>
      <div class="pillars">
        <div class="pillar-card">
          <h3>企業 AI</h3>
          <p>知識助手、事實查核代理與 Copilot 型系統，整合既有工作流程。</p>
          <div class="pillar-tags">
            <span>M365 Copilot</span>
            <span>知識助手</span>
            <span>事實查核</span>
          </div>
        </div>
        <div class="pillar-card">
          <h3>Agent 系統</h3>
          <p>多代理協作、工作流自動化與工具編排，支援複雜推理與執行。</p>
          <div class="pillar-tags">
            <span>多代理</span>
            <span>工作流自動化</span>
            <span>n8n</span>
          </div>
        </div>
        <div class="pillar-card">
          <h3>即時 AI</h3>
          <p>語音 AI、低延遲 LLM 管道與串流介面，用於客服與即時互動。</p>
          <div class="pillar-tags">
            <span>語音 AI</span>
            <span>低延遲 LLM</span>
            <span>客服</span>
          </div>
        </div>
      </div>
    </section>

    <section id="showcase">
      <div class="section-title">精選專案</div>
      <div class="showcase">
        <div class="showcase-card">
          <h3>Agentic AI 平台</h3>
          <p>事實查核、知識檢索與研究自動化，15 個代理——為規模與信任而建。</p>
          <div class="showcase-metrics">161 使用者 · AIGO Top 20</div>
          <a href="/projects/agentic-ai-platform/" class="btn btn-secondary">看專案</a>
        </div>
        <div class="showcase-card">
          <h3>企業 RAG</h3>
          <p>M365 Copilot Studio 上的 Agentic RAG，即時客服與知識檢索。</p>
          <div class="showcase-metrics">Copilot Studio · LLM judge</div>
          <a href="/projects/enterprise-rag/" class="btn btn-secondary">看專案</a>
        </div>
        <div class="showcase-card">
          <h3>即時語音 AI</h3>
          <p>MCP + Realtime GPT 整合，語音驅動客服與低延遲對話。</p>
          <div class="showcase-metrics">語音 · 客服</div>
          <a href="/projects/realtime-voice-ai/" class="btn btn-secondary">看專案</a>
        </div>
        <div class="showcase-card">
          <h3>OCR 自動化</h3>
          <p>醫療收據 OCR，金融與醫療流程——高準確率正式上線。</p>
          <div class="showcase-metrics">95% 準確率 · 正式環境</div>
          <a href="/projects/ocr-automation/" class="btn btn-secondary">看專案</a>
        </div>
      </div>
    </section>

    <section id="stickers">
      <div class="section-title">LINE 貼圖</div>
      <div class="sticker-grid">
        {stickers.map((entry) => (
          <div class="sticker-card">
            {entry.data.image ? (
              <a href={entry.data.lineStoreUrl} target="_blank" rel="noopener" class="sticker-card-image">
                <img src={entry.data.image} alt={entry.data.title} width="240" height="240" loading="lazy" />
              </a>
            ) : (
              <div class="sticker-card-image sticker-card-placeholder" aria-hidden="true">LINE</div>
            )}
            <div class="sticker-card-body">
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <a href={entry.data.lineStoreUrl} class="btn btn-secondary" target="_blank" rel="noopener">貼圖小舖</a>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align: center; margin-top: 1rem;">
        <a href="/stickers/" class="btn btn-secondary">看全部</a>
      </p>
    </section>

    <section id="blog-preview">
      <div class="section-title">最新文章</div>
      <div class="blog-preview">
        {posts.map((post) => (
          <div class="blog-preview-item">
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            <span>{post.data.category}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="cta-block">
      <p>正在找 AI 平台或 Agentic AI 夥伴？我協助團隊交付企業級 RAG、多代理與即時 AI 系統。</p>
      <a href="/contact/" class="btn btn-primary">聯絡</a>
    </div>

    <footer class="footer">
      <p>AI 平台與 Agentic AI 工程師 · RAG · 多代理 · 即時 AI</p>
    </footer>
  </div>
</Layout>
