---
interface Props {
  eyebrow?: string;
  title?: string;
  text: string;
  buttonText: string;
  buttonHref: string;
  /** Optional stable analytics context for mailto or conversion links. */
  buttonAnalytics?: string;
  /** e.g. _blank for external links */
  buttonTarget?: string;
  buttonRel?: string;
  /** Optional anchor id for in-page hash / scroll spy */
  id?: string;
}

const { eyebrow, title, text, buttonText, buttonHref, buttonAnalytics, buttonTarget, buttonRel, id } = Astro.props;
---

<div class:list={['cta-block', id ? 'home-scroll-anchor' : undefined]} id={id}>
  <div class="cta-block-copy">
    {eyebrow && <span class="cta-block-eyebrow">{eyebrow}</span>}
    {title && <h2>{title}</h2>}
  <p>{text}</p>
  </div>
  <a href={buttonHref} class="btn btn-primary" data-analytics-contact={buttonAnalytics} target={buttonTarget} rel={buttonRel}>{buttonText}</a>
</div>
