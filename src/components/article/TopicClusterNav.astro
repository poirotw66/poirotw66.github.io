---
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { toLocalizedPath } from '../../i18n/utils';
import { blogSlug, resolveBlogPostsForLang } from '../../utils/blogLocale';
import { baseSlug, resolveEntriesForLang } from '../../utils/contentLocale';
import { getTopicClusterById, getTopicClusterForSlug } from '../../utils/topicClusters';
import EditorialCover from '../EditorialCover.astro';
import { getBlogCoverMeta, type EditorialCoverVariant } from '../../utils/editorialCover';

interface Props {
  lang: Lang;
  currentSlug: string;
}

const CASE_COVER_VARIANT: Record<string, EditorialCoverVariant> = {
  'ai-agent': 'agent',
  'enterprise-rag': 'rag',
  'ai-platform-governance': 'engineering',
};

const { lang, currentSlug } = Astro.props;
const allPosts = resolveBlogPostsForLang(await getCollection('blog'), lang);
const allProjects = resolveEntriesForLang(await getCollection('projects'), lang);
const currentPost = allPosts.find((entry) => blogSlug(entry) === currentSlug);
const cluster = getTopicClusterById(currentPost?.data.cluster)
  ?? getTopicClusterForSlug(currentSlug);
const posts = cluster ? allPosts : [];
const postsBySlug = new Map(posts.map((entry) => [blogSlug(entry), entry]));
const metadataMembers = cluster
  ? posts
      .filter((entry) => entry.data.cluster === cluster.id)
      .sort((a, b) => (a.data.clusterOrder ?? 999) - (b.data.clusterOrder ?? 999))
  : [];
const corePost = metadataMembers.find((entry) => entry.data.clusterRole === 'pillar');
const coreSlug = corePost ? blogSlug(corePost) : cluster?.coreSlug;
const children = metadataMembers.length > 0
  ? metadataMembers.filter((entry) => blogSlug(entry) !== coreSlug)
  : cluster?.childSlugs
      .map((slug) => postsBySlug.get(slug))
      .filter((entry) => entry != null) ?? [];
const childSlugs = children.map((entry) => blogSlug(entry));
const currentIndex = childSlugs.indexOf(currentSlug);
const nextSlug = cluster
  ? currentSlug === coreSlug
    ? childSlugs[0]
    : childSlugs[currentIndex + 1]
  : undefined;
const nextPost = nextSlug ? postsBySlug.get(nextSlug) : undefined;
const nextCover = nextPost ? getBlogCoverMeta(nextPost, lang) : undefined;
const caseStudyEntry = cluster
  ? allProjects.find((entry) => baseSlug(entry) === cluster.caseStudy.slug)
  : undefined;
const caseCoverVariant = cluster
  ? (CASE_COVER_VARIANT[cluster.id] ?? 'engineering')
  : 'engineering';
const copy = lang === 'en'
  ? { core: 'Core guide', current: 'Currently reading', articles: `Full series (${children.length})`, case: 'Case study', next: 'Read next', finish: 'Put it into practice' }
  : { core: '核心指南', current: '目前閱讀', articles: `查看完整系列（${children.length} 篇）`, case: '實戰案例', next: '下一篇閱讀', finish: '接著看實戰' };
---

{cluster && (
  <nav class="topic-path" aria-label={`${cluster.title[lang]} ${copy.articles}`}>
    <div class="topic-path-head">
      <h2>{cluster.title[lang]}</h2>
    </div>
    <p class="topic-path-lead">{cluster.description[lang]}</p>
    <a
      class:list={['topic-core', { current: currentSlug === coreSlug }]}
      href={toLocalizedPath(`/blog/${coreSlug}/`, lang)}
      aria-current={currentSlug === coreSlug ? 'page' : undefined}
    >{copy.core}: {corePost?.data.title ?? cluster.title[lang]}</a>
    {currentPost && currentSlug !== coreSlug && (
      <p class="topic-current"><span>{copy.current}</span>{currentPost.data.title}</p>
    )}
    {nextPost ? (
      <a class="topic-next" href={toLocalizedPath(`/blog/${blogSlug(nextPost)}/`, lang)}>
        {nextCover && <EditorialCover title={nextPost.data.title} image={nextPost.data.image} {...nextCover} size="thumb" />}
        <span><small>{copy.next}</small><strong>{nextPost.data.title}</strong></span>
      </a>
    ) : (
      <a class="topic-next" href={toLocalizedPath(`/projects/${cluster.caseStudy.slug}/`, lang)}>
        {caseStudyEntry?.data.image && (
          <EditorialCover title={cluster.caseStudy.title[lang]} image={caseStudyEntry.data.image} variant={caseCoverVariant} label={copy.finish} number="CASE" size="thumb" alt={cluster.caseStudy.title[lang]} />
        )}
        <span><small>{copy.finish}</small><strong>{cluster.caseStudy.title[lang]}</strong></span>
      </a>
    )}
    <details class="topic-series">
      <summary>{copy.articles}</summary>
      <ol class="topic-articles">
        {children.map((entry) => {
          const slug = blogSlug(entry);
          const isCurrent = slug === currentSlug;
          return (
            <li><a href={toLocalizedPath(`/blog/${slug}/`, lang)} aria-current={isCurrent ? 'page' : undefined}>{entry.data.title}</a></li>
          );
        })}
      </ol>
      <a class="topic-case" href={toLocalizedPath(`/projects/${cluster.caseStudy.slug}/`, lang)}>
        <span>{copy.case}</span>{cluster.caseStudy.title[lang]}
      </a>
    </details>
  </nav>
)}

<style>
  .topic-path{margin-top:2.5rem;padding:1.25rem;border:1px solid var(--border);border-radius:16px;background:linear-gradient(145deg,var(--surface-card),var(--surface-card-end))}.topic-path h2{margin:0;font-size:1.35rem}.topic-path-lead{margin:.65rem 0 1rem;color:var(--text-muted)}.topic-core{display:block;padding:.15rem 0;color:var(--text);font-weight:700;line-height:1.45;text-decoration:none}.topic-core.current{color:var(--accent)}.topic-current{margin:.45rem 0 0;color:var(--text-muted);line-height:1.45}.topic-current span,.topic-next small,.topic-case span{display:block;margin-bottom:.18rem;color:var(--text-muted);font:700 .7rem/1.2 var(--font-mono);letter-spacing:.05em}.topic-next{display:grid;grid-template-columns:9rem minmax(0,1fr);gap:.8rem;align-items:center;margin-top:1rem;padding:.75rem;border:1px solid color-mix(in srgb,var(--accent) 34%,var(--border));border-radius:12px;background:var(--bg);color:var(--text);text-decoration:none}.topic-next .editorial-cover{border-radius:8px}.topic-next strong{display:block;line-height:1.4}.topic-series{margin-top:.8rem;border-top:1px solid var(--border)}.topic-series summary{min-height:2.75rem;display:flex;align-items:center;color:var(--text);font-weight:700;cursor:pointer}.topic-articles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.35rem .9rem;margin:0;padding:0 0 .75rem;list-style:none}.topic-articles a,.topic-case{display:block;padding:.35rem 0;color:var(--text);line-height:1.4;text-decoration:none}.topic-articles a[aria-current="page"]{color:var(--accent);font-weight:700}.topic-case{padding-top:.75rem;border-top:1px solid var(--border)}.topic-next:hover,.topic-core:hover,.topic-articles a:hover,.topic-case:hover{color:var(--accent)}@media(max-width:720px){.topic-next{grid-template-columns:6.5rem minmax(0,1fr)}.topic-articles{grid-template-columns:1fr}}
</style>
