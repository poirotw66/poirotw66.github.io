---
interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  /** Optional OG image URL (absolute). Defaults to site + /og.png */
  imageURL?: string;
}

const { title, description = 'I design and build enterprise-grade AI platforms, focusing on RAG, multi-agent collaboration, and real-time AI systems.', canonicalURL, imageURL } = Astro.props;
const site = Astro.site ?? new URL('https://poirotw66.github.io');
const canonical = canonicalURL ?? new URL(Astro.url.pathname, site);
const ogImage = imageURL ?? new URL('/og.png', site).toString();
---

<!DOCTYPE html>
<html lang="en" class="lang-en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a href="#main" class="skip-link" data-en="Skip to main content" data-zh="跳過至主內容">Skip to main content</a>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">Bloss0m</a>
        <ul class="nav-links">
          <li><a href="/projects/" data-en="Projects" data-zh="專案">Projects</a></li>
          <li><a href="/stickers/" data-en="Stickers" data-zh="貼圖">Stickers</a></li>
          <li><a href="/blog/" data-en="Blog" data-zh="部落格">Blog</a></li>
          <li><a href="/contact/" data-en="Contact" data-zh="聯絡">Contact</a></li>
        </ul>
        <div class="nav-right">
          <div class="theme-switcher" role="group" aria-label="Theme">
            <button type="button" data-theme-btn="dark" aria-pressed="true" class="theme-btn theme-btn-active" data-en="Dark" data-zh="黑夜">黑夜</button>
            <button type="button" data-theme-btn="warm" aria-pressed="false" class="theme-btn" data-en="Warm" data-zh="暖色">暖色</button>
          </div>
          <div class="lang-switcher">
            <button type="button" data-lang="en" aria-label="English">EN</button>
            <button type="button" data-lang="zh" aria-label="繁體中文">繁中</button>
          </div>
        </div>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <script is:inline src="/js/theme.js" defer></script>
    <script is:inline src="/js/lang.js" defer></script>
  </body>
</html>
