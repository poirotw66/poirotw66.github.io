---
import { getCollection } from 'astro:content';
import { getAllTagSlugs } from '../../../../utils/tag';
import BlogTagContent from '../../../../components/pages/BlogTagContent.astro';
import { resolveBlogPostsForLang } from '../../../../utils/blogLocale';

export async function getStaticPaths() {
  const posts = resolveBlogPostsForLang(await getCollection('blog'), 'en');
  const slugs = getAllTagSlugs(posts);
  return slugs.map((tag) => ({ params: { tag } }));
}

const { tag: tagSlug } = Astro.params;
if (!tagSlug) throw new Error('Missing tag param');
---

<BlogTagContent lang="en" tagSlug={tagSlug} />
