---
/**
 * PDFViewer Component — PDF.js-based viewer.
 * UI strings follow `lang` (default zh for Chinese pages).
 */

import type { Lang } from '../i18n/ui';

interface Props {
  src: string;
  title?: string;
  height?: string;
  initialScale?: 'page-width' | 'page-fit' | number;
  minScale?: number;
  maxScale?: number;
  showToolbar?: boolean;
  allowDownload?: boolean;
  allowFullscreen?: boolean;
  lang?: Lang;
}

const {
  src,
  title = 'PDF Document',
  height = '800px',
  initialScale = 'page-width',
  minScale = 0.5,
  maxScale = 2.0,
  showToolbar = true,
  allowDownload = true,
  allowFullscreen = true,
  lang = 'zh',
} = Astro.props;

const isEn = lang === 'en';
const ui = isEn
  ? {
      toolbar: 'PDF controls',
      prev: 'Previous page',
      prevTitle: 'Previous page (←)',
      pageInput: 'Current page',
      pageInputTitle: 'Enter a page number and press Enter',
      totalPages: 'Total pages',
      next: 'Next page',
      nextTitle: 'Next page (→)',
      zoomOut: 'Zoom out',
      zoomOutTitle: 'Zoom out (-)',
      zoomIn: 'Zoom in',
      zoomInTitle: 'Zoom in (+)',
      fitWidth: 'Fit width',
      fitPage: 'Fit page',
      fullscreen: 'Fullscreen',
      fullscreenTitle: 'Fullscreen (F)',
      download: 'Download PDF',
      downloadLabel: 'Download',
      content: `${title} content`,
      loading: 'Loading PDF...',
      timeout: 'Failed to load the PDF viewer. Please refresh the page.',
      shortcutsRegion: 'Keyboard shortcuts',
      shortcutsTitle: 'PDF viewer keyboard shortcuts',
      shortcutPrevNext: 'Left/Right arrow: previous/next page',
      shortcutZoom: 'Plus/Minus: zoom in/out',
      shortcutFullscreen: 'F: toggle fullscreen',
      shortcutHomeEnd: 'Home/End: first/last page',
    }
  : {
      toolbar: 'PDF 控制工具列',
      prev: '上一頁',
      prevTitle: '上一頁 (←)',
      pageInput: '當前頁碼',
      pageInputTitle: '輸入頁碼並按 Enter',
      totalPages: '總頁數',
      next: '下一頁',
      nextTitle: '下一頁 (→)',
      zoomOut: '縮小',
      zoomOutTitle: '縮小 (-)',
      zoomIn: '放大',
      zoomInTitle: '放大 (+)',
      fitWidth: '適應寬度',
      fitPage: '適應頁面',
      fullscreen: '全螢幕',
      fullscreenTitle: '全螢幕 (F)',
      download: '下載 PDF',
      downloadLabel: '下載',
      content: `${title} 內容`,
      loading: '載入 PDF 中...',
      timeout: '載入 PDF 檢視器失敗。請重新整理頁面。',
      shortcutsRegion: '鍵盤快捷鍵',
      shortcutsTitle: 'PDF 檢視器鍵盤快捷鍵',
      shortcutPrevNext: '左右方向鍵: 上一頁/下一頁',
      shortcutZoom: '加號/減號: 放大/縮小',
      shortcutFullscreen: 'F 鍵: 切換全螢幕',
      shortcutHomeEnd: 'Home/End: 第一頁/最後一頁',
    };

const viewerId = `pdf-viewer-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="pdf-viewer-container" style={`height: ${height}`}>
  <div class="pdf-viewer" id={viewerId}>
    {showToolbar && (
      <div class="pdf-toolbar" role="toolbar" aria-label={ui.toolbar}>
        <div class="pdf-toolbar-group pdf-page-nav">
          <button type="button" class="pdf-prev" aria-label={ui.prev} title={ui.prevTitle}>
            <span>{ui.prev}</span>
          </button>
          <div class="pdf-page-info" role="status" aria-live="polite">
            <input type="number" class="pdf-page-input" min="1" aria-label={ui.pageInput} title={ui.pageInputTitle} />
            <span>/</span>
            <span class="pdf-total-pages" aria-label={ui.totalPages}>0</span>
          </div>
          <button type="button" class="pdf-next" aria-label={ui.next} title={ui.nextTitle}>
            <span>{ui.next}</span>
          </button>
        </div>
        <div class="pdf-toolbar-group pdf-zoom-controls">
          <button type="button" class="pdf-zoom-out" aria-label={ui.zoomOut} title={ui.zoomOutTitle}>
            <span>{ui.zoomOut}</span>
          </button>
          <button type="button" class="pdf-zoom-in" aria-label={ui.zoomIn} title={ui.zoomInTitle}>
            <span>{ui.zoomIn}</span>
          </button>
          <button type="button" class="pdf-fit-width" aria-label={ui.fitWidth} title={ui.fitWidth}>
            <span>{ui.fitWidth}</span>
          </button>
          <button type="button" class="pdf-fit-page" aria-label={ui.fitPage} title={ui.fitPage}>
            <span>{ui.fitPage}</span>
          </button>
        </div>
        <div class="pdf-toolbar-group">
          {allowFullscreen && (
            <button type="button" class="pdf-fullscreen" aria-label={ui.fullscreen} title={ui.fullscreenTitle}>
              <span>{ui.fullscreen}</span>
            </button>
          )}
          {allowDownload && (
            <button type="button" class="pdf-download" aria-label={ui.download} title={ui.download}>
              <span>{ui.downloadLabel}</span>
            </button>
          )}
        </div>
      </div>
    )}

    <div class="pdf-canvas-container" role="main" aria-label={ui.content}>
      <canvas class="pdf-canvas" aria-label={title}></canvas>
      <div class="pdf-loading" role="status" aria-live="polite">
        <div class="pdf-loading-spinner" aria-hidden="true"></div>
        <div class="pdf-loading-text">{ui.loading}</div>
      </div>
      <div class="pdf-error" role="alert" aria-live="assertive"></div>
    </div>
  </div>
</div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<link rel="stylesheet" href="/css/pdf-viewer.css" />

<script is:inline define:vars={{ viewerId, src, initialScale, minScale, maxScale, title, timeoutMessage: ui.timeout }}>
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViewer);
  } else {
    initViewer();
  }

  function initViewer() {
    const checkReady = setInterval(() => {
      if (window['pdfjs-dist/build/pdf'] && window.initPDFViewer) {
        clearInterval(checkReady);
        const script = document.createElement('script');
        script.src = '/js/pdf-viewer.js';
        script.onload = () => {
          window.initPDFViewer(viewerId, src, {
            initialScale: initialScale,
            minScale: minScale,
            maxScale: maxScale,
            title: title
          });
        };
        document.head.appendChild(script);
      }
    }, 100);

    setTimeout(() => {
      clearInterval(checkReady);
      const container = document.getElementById(viewerId);
      if (container) {
        const loading = container.querySelector('.pdf-loading');
        const error = container.querySelector('.pdf-error');
        if (loading) loading.style.display = 'none';
        if (error) {
          error.textContent = timeoutMessage;
          error.style.display = 'block';
        }
      }
    }, 10000);
  }
</script>

<div class="sr-only" role="region" aria-label={ui.shortcutsRegion}>
  <h3>{ui.shortcutsTitle}</h3>
  <ul>
    <li>{ui.shortcutPrevNext}</li>
    <li>{ui.shortcutZoom}</li>
    <li>{ui.shortcutFullscreen}</li>
    <li>{ui.shortcutHomeEnd}</li>
  </ul>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
