---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import { baseSlug } from '../utils/contentLocale';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const projectHref = toLocalizedPath(`/projects/${baseSlug(entry)}/`, lang);
const pubYear = entry.data.pubDate.getFullYear().toString();
---

<div class="showcase-card">
  {entry.data.image && (
    <a href={projectHref} class="showcase-card-image-wrap" aria-hidden="true" tabindex="-1">
      <Image
        src={entry.data.image}
        alt=""
        class="showcase-card-image"
        width="400"
        height="240"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <h3><a href={projectHref} class="showcase-card-title-link">{entry.data.title}</a></h3>

  <div class="preview-card-meta preview-card-meta--project">
    <span class="project-card-year">{pubYear}</span>
  </div>

  {entry.data.impact && (
    <p class="showcase-impact">{entry.data.impact}</p>
  )}
  <p>{entry.data.description}</p>
</div>
