---
import type { CollectionEntry } from 'astro:content';
import { tagToUrlSlug } from '../utils/tag';
import type { Lang } from '../i18n/ui';
import type { BlogLaneId } from '../utils/blogLanes';
import { toLocalizedPath } from '../i18n/utils';
import { blogSlug } from '../utils/blogLocale';
import CategoryBadge from './CategoryBadge.astro';
import EditorialCover from './EditorialCover.astro';
import { getBlogCoverMeta } from '../utils/editorialCover';

type PreviewVariant = 'card' | 'featured' | 'compact';

interface Props {
  post: CollectionEntry<'blog'>;
  lang?: Lang;
  variant?: PreviewVariant;
  lane?: BlogLaneId;
}

const { post, lang = 'zh', variant = 'card', lane } = Astro.props;
const postUrl = toLocalizedPath(`/blog/${blogSlug(post)}/`, lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', {
    year: 'numeric',
    month: variant === 'compact' ? (lang === 'en' ? 'short' : '2-digit') : 'short',
    day: 'numeric',
  });
const pubIso = post.data.pubDate.toISOString().slice(0, 10);
const badgeLabel = post.data.category;
const cover = getBlogCoverMeta(post, lang);
---

{variant === 'featured' && (
  <article class="blog-preview-item blog-preview--featured">
    <a href={postUrl} class="blog-preview-image-wrap blog-preview--featured-media" aria-hidden="true" tabindex="-1">
      <EditorialCover title={post.data.title} image={post.data.image} {...cover} size="card" />
    </a>
    <div class="blog-preview--featured-body">
      <div class="blog-preview--featured-meta">
        <CategoryBadge label={badgeLabel} lane={lane} />
        <time class="blog-preview-date" datetime={pubIso}>{formatDate(post.data.pubDate)}</time>
      </div>
      <a href={postUrl} class="blog-preview-title">{post.data.title}</a>
      {post.data.description && <p class="blog-preview-desc">{post.data.description}</p>}
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class="blog-preview-item blog-preview--compact">
    <div class="blog-preview--compact-main">
      <a href={postUrl} class="blog-preview-title">{post.data.title}</a>
      <div class="blog-preview--compact-meta">
        <CategoryBadge label={badgeLabel} lane={lane} />
        <time class="blog-preview-date" datetime={pubIso}>{formatDate(post.data.pubDate)}</time>
      </div>
    </div>
  </article>
)}

{variant === 'card' && (
  <div class="blog-preview-item">
    <a href={postUrl} class="blog-preview-image-wrap" aria-hidden="true" tabindex="-1">
      <EditorialCover title={post.data.title} image={post.data.image} {...cover} size="card" />
    </a>
    <a href={postUrl} class="blog-preview-title">{post.data.title}</a>
    <div class="preview-card-meta">
      <time class="blog-preview-date" datetime={pubIso}>{formatDate(post.data.pubDate)}</time>
      <span class="preview-card-meta-sep" aria-hidden="true"> · </span>
      <span class="blog-preview-category">{post.data.category}</span>
    </div>
    {post.data.tags && post.data.tags.length > 0 && (
      <ul class="post-tags blog-preview-tags">
        {post.data.tags.slice(0, 3).map((t) => (
          <li><a class="tag-pill" href={toLocalizedPath(`/blog/tag/${tagToUrlSlug(t)}/`, lang)}>{t}</a></li>
        ))}
      </ul>
    )}
  </div>
)}
