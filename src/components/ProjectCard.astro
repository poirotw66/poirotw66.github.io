---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  viewLabel?: string;
}

const { entry, viewLabel = 'View project' } = Astro.props;
---

<div class="showcase-card">
  <h3>{entry.data.title}</h3>
  <p>{entry.data.description}</p>
  {entry.data.metrics && entry.data.metrics.length > 0 && (
    <div class="showcase-metrics">{entry.data.metrics.join(' · ')}</div>
  )}
  <a href={`/projects/${entry.slug}/`} class="btn btn-secondary">{viewLabel}</a>
</div>
