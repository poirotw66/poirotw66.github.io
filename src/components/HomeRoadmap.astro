---
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
import SectionIntro from './SectionIntro.astro';
import { homeRoadmap, type HomeRoadmapItemType } from '../data/homeRoadmap';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = homeRoadmap[lang];
const ctaHref = toLocalizedPath(copy.ctaHref, lang);
const separator = lang === 'en' ? ': ' : '：';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'zh-TW', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(new Date(`${value}T00:00:00Z`));
const resourceHref = (href: string) =>
  href.startsWith('/') ? toLocalizedPath(href, lang) : href;

const typeLabel: Record<HomeRoadmapItemType, Record<Lang, string>> = {
  article: { zh: '文章', en: 'Article' },
  research: { zh: '研究', en: 'Research' },
  project: { zh: '專案', en: 'Project' },
};
---

<section id="roadmap" class="section-reveal home-scroll-anchor home-editorial-section home-roadmap">
  <SectionHeading kicker={copy.kicker} title={copy.title} index="02" />
  <SectionIntro lead={copy.lead} />

  <ol class="home-roadmap-list">
    {copy.items.map((item, index) => (
      <li class="home-roadmap-item">
        <span class="home-roadmap-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="home-roadmap-main">
          <div class="home-roadmap-meta">
            <span class="home-roadmap-type">{typeLabel[item.type][lang]}</span>
            <span class="home-roadmap-status">{item.stage}</span>
            <time datetime={item.updatedAt}>{formatDate(item.updatedAt)}</time>
          </div>
          <h3>{item.title}</h3>
          <p>{item.weeklyProgress}</p>
        </div>
        <div class="home-roadmap-resources">
          <span>{copy.resourcesLabel}</span>
          <p>
            {item.resources.map((resource, resourceIndex) => (
              <>
                {resourceIndex > 0 && <span aria-hidden="true"> · </span>}
                <a
                  class="section-cta"
                  href={resourceHref(resource.href)}
                  target={resource.href.startsWith('http') ? '_blank' : undefined}
                  rel={resource.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {resource.label}
                </a>
              </>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ol>

  <p class="home-roadmap-cta text-center-mt">
    <a href={ctaHref} class="btn btn-secondary">{copy.ctaLabel}</a>
  </p>
</section>
