---
import { toLocalizedPath } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;

const copy = {
  en: {
    text: 'For speaking invitations, internal engineering sessions, or architecture exchange, see the topics and public work I can bring into the conversation.',
    buttonText: 'Speaking & contact',
  },
  zh: {
    text: '歡迎演講、企業內部技術分享與架構交流；可以先查看我適合分享的主題與公開工程成果。',
    buttonText: '演講與聯絡',
  },
} as const;

const { text, buttonText } = copy[lang];
---

<div class="cta-block">
  <p>{text}</p>
  <a href={toLocalizedPath('/contact/', lang)} class="btn btn-primary">{buttonText}</a>
</div>
