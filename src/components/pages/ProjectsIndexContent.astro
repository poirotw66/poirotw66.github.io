---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getMainProjects } from '../../utils/sort';
import PageHeader from '../PageHeader.astro';
import CtaLinkedIn from '../CtaLinkedIn.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { resolveEntriesForLang, baseSlug } from '../../utils/contentLocale';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const mainProjects = getMainProjects(resolveEntriesForLang(await getCollection('projects'), lang));
---

<Layout
  title={lang === 'en' ? 'Projects | Bloss0m' : '專案 | Bloss0m'}
  description={
    lang === 'en'
      ? 'Selected projects: Agentic AI, Enterprise RAG, Realtime Voice AI, OCR Automation. AI platform and agent design.'
      : '精選專案：Agentic AI、企業級 RAG、即時語音 AI、OCR 自動化等。'
  }
  lang={lang}
>
  <div class="content-region">
    <PageHeader
      title={lang === 'en' ? 'Projects' : '專案'}
      subtitle={lang === 'en' ? 'AI platform · Agent design · RAG · Realtime AI' : 'AI 平台 · Agent 設計 · RAG · 即時 AI'}
    />

    <section class="section-spacer inner-page-sections">
      <ul class="blog-list">
        {mainProjects.map((entry) => {
          const projectHref = toLocalizedPath(`/projects/${baseSlug(entry)}/`, lang);
          return (
            <li class="blog-list-item">
              {entry.data.image && (
                <a href={projectHref} class="blog-list-thumb" aria-hidden="true" tabindex="-1">
                  <Image
                    src={entry.data.image}
                    alt=""
                    class="blog-list-thumb-img"
                    width="200"
                    height="125"
                    format="webp"
                    quality={72}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="blog-list-body">
                <a href={projectHref}>{entry.data.title}</a>
                {entry.data.impact && <div class="meta">{entry.data.impact}</div>}
                <p class="blog-list-desc">{entry.data.description}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <CtaLinkedIn lang={lang} />
  </div>
</Layout>
