---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'paperReading'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const entryUrl = toLocalizedPath(`/paper-reading/${entry.id}/`, lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
---

<div class="blog-preview-item">
  {entry.data.image && (
    <a href={entryUrl} class="blog-preview-image-wrap" aria-hidden="true">
      <Image
        src={entry.data.image}
        alt=""
        class="blog-preview-image"
        width="400"
        height="240"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <a href={entryUrl} class="blog-preview-title">{entry.data.title}</a>
  <span class="blog-preview-date">{formatDate(entry.data.pubDate)}</span>
  {entry.data.tags && entry.data.tags.length > 0 && (
    <ul class="post-tags blog-preview-tags">
      {entry.data.tags.slice(0, 3).map((t) => (
        <li><span>{t}</span></li>
      ))}
    </ul>
  )}
</div>

