---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { sortByPubDate } from '../../utils/sort';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Footer from '../../components/Footer.astro';

const allProjects = sortByPubDate(await getCollection('projects'));
---

<Layout
  title="Projects | AI Platform Engineer"
  description="Selected projects: Agentic AI, Enterprise RAG, Realtime Voice AI, OCR Automation. AI platform and agent design."
>
  <div class="block-en">
    <PageHeader title="Projects" subtitle="AI platform · Agent design · RAG · Realtime AI" />

    <section style="padding-top: 2rem;">
      <div class="showcase">
        {allProjects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="View project" />
        ))}
      </div>
    </section>

    <div class="cta-block">
      <a href="/#showcase" class="btn btn-secondary">← Home</a>
      <a href="/contact/" class="btn btn-primary" style="margin-left: 0.5rem;">Contact</a>
    </div>

    <Footer text="AI Platform & Agentic AI Engineer" />
  </div>

  <div class="block-zh">
    <PageHeader title="專案" subtitle="AI 平台 · Agent 設計 · RAG · 即時 AI" />

    <section style="padding-top: 2rem;">
      <div class="showcase">
        {allProjects.map((entry) => (
          <ProjectCard entry={entry} viewLabel="看專案" />
        ))}
      </div>
    </section>

    <div class="cta-block">
      <a href="/#showcase" class="btn btn-secondary">← 回首頁</a>
      <a href="/contact/" class="btn btn-primary" style="margin-left: 0.5rem;">聯絡</a>
    </div>

    <Footer text="AI 平台與 Agentic AI 工程師" />
  </div>
</Layout>
