---
import type { Lang } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import HubHero from '../HubHero.astro';
import { toLocalizedPath } from '../../i18n/utils';
import { resolveEntriesForLang, baseSlug } from '../../utils/contentLocale';
import {
  HOME_CASE_STUDY_SLUGS,
  homeCaseStudyDetails,
  type HomeCaseStudySlug,
} from '../../data/homeBrand';

interface Props {
  lang: Lang;
}

type ProjectEntry = CollectionEntry<'projects'>;

const { lang } = Astro.props;
const isEn = lang === 'en';
const allProjects = resolveEntriesForLang(await getCollection('projects'), lang)
  .filter((entry) => entry.data.tier !== 'lab');
const projectBySlug = new Map(allProjects.map((entry) => [baseSlug(entry), entry]));
const selectProjects = (slugs: readonly string[]) =>
  slugs.flatMap((slug) => {
    const entry = projectBySlug.get(slug);
    return entry ? [entry] : [];
  });

const flagshipProjects = selectProjects(HOME_CASE_STUDY_SLUGS);
const prototypeSlugs = [
  'trendscope',
  'portfolio-opening-bell-agent',
  'realtime-voice-ai-project',
  'bloom-render',
  'ppt2preview',
] as const;
const prototypeProjects = selectProjects(prototypeSlugs);
const claimed = new Set<string>([...HOME_CASE_STUDY_SLUGS, ...prototypeSlugs]);
const toolProjects = allProjects
  .filter((entry) => !claimed.has(baseSlug(entry)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const publicRepoCount = allProjects.filter((entry) => Boolean(entry.data.repoUrl)).length;

const copy = isEn
  ? {
      kicker: 'SYSTEMS · PROTOTYPES · TOOLS',
      title: 'Engineering work you can inspect',
      lead: 'A structured record of AI systems I have designed, implemented, evaluated, and documented — from enterprise RAG and agent orchestration to document intelligence.',
      flagshipKicker: 'FLAGSHIP SYSTEMS',
      flagshipTitle: 'Three systems that show how I engineer AI',
      flagshipLead: 'Each case exposes the problem, architecture decision, my role, and a measurable result.',
      prototypeKicker: 'RESEARCH PROTOTYPES',
      prototypeTitle: 'Ideas tested as working systems',
      prototypeLead: 'Focused builds used to test emerging interfaces, workflows, and product directions.',
      toolsKicker: 'ENGINEERING TOOLS',
      toolsTitle: 'Reusable utilities and production helpers',
      toolsLead: 'Smaller tools that turn document, media, and knowledge workflows into repeatable pipelines.',
      problem: 'Problem',
      solution: 'System',
      role: 'My role',
      result: 'Evidence',
      caseStudy: 'Open case study',
      repository: 'Repository',
      project: 'Open project',
    }
  : {
      kicker: 'SYSTEMS · PROTOTYPES · TOOLS',
      title: '可以打開查驗的工程實作',
      lead: '依照系統、研究原型與工程工具分層，呈現我如何設計、實作、評測並公開記錄 AI 系統。',
      flagshipKicker: 'FLAGSHIP SYSTEMS',
      flagshipTitle: '三個最能代表工程能力的系統',
      flagshipLead: '每個案例都公開問題、架構選擇、我的角色與可量測成果。',
      prototypeKicker: 'RESEARCH PROTOTYPES',
      prototypeTitle: '把前沿想法做成可運行原型',
      prototypeLead: '用實際系統驗證新介面、工作流與產品方向，而不只停在概念。',
      toolsKicker: 'ENGINEERING TOOLS',
      toolsTitle: '可重複使用的工程工具',
      toolsLead: '把文件、媒體與知識處理流程整理成可以重複執行的工具。',
      problem: '問題',
      solution: '系統',
      role: '我的角色',
      result: '證據',
      caseStudy: '查看完整案例',
      repository: 'Repository',
      project: '開啟專案',
    };

const projectHref = (entry: ProjectEntry) =>
  toLocalizedPath(`/projects/${baseSlug(entry)}/`, lang);
---

<Layout
  title={isEn ? 'Engineering Projects | Bloss0m' : '工程實作 | Bloss0m'}
  description={isEn
    ? 'Inspectable AI engineering systems, research prototypes, and reusable tools by Justin.'
    : 'Justin 的 AI 系統、研究原型與工程工具，包含 Agentic RAG、Agent Platform 與 OCR。'}
  lang={lang}
>
  <div class="content-region projects-hub">
    <HubHero
      kicker={copy.kicker}
      title={copy.title}
      lead={copy.lead}
      stats={[
        { value: flagshipProjects.length, label: isEn ? 'flagship systems' : '個旗艦系統' },
        { value: publicRepoCount, label: isEn ? 'public repositories' : '個公開程式庫' },
        { value: allProjects.length, label: isEn ? 'documented builds' : '項公開實作' },
      ]}
    />

    <section class="hub-section projects-flagship">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{copy.flagshipKicker}</p>
          <h2>{copy.flagshipTitle}</h2>
        </div>
        <p>{copy.flagshipLead}</p>
      </div>
      <div class="project-evidence-grid">
        {flagshipProjects.map((entry) => {
          const slug = baseSlug(entry) as HomeCaseStudySlug;
          const detail = homeCaseStudyDetails[lang][slug];
          return (
            <article class="project-evidence-card">
              <div class="project-evidence-media">
                {entry.data.image ? (
                  <Image
                    src={entry.data.image}
                    alt=""
                    width="560"
                    height="350"
                    format="webp"
                    quality={76}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span aria-hidden="true">AI / SYSTEM</span>
                )}
              </div>
              <div class="project-evidence-body">
                <p class="section-kicker">{entry.data.impact}</p>
                <h3><a href={projectHref(entry)}>{entry.data.title}</a></h3>
                <dl class="project-evidence-list">
                  <div><dt>{copy.problem}</dt><dd>{detail.problem}</dd></div>
                  <div><dt>{copy.solution}</dt><dd>{detail.solution}</dd></div>
                  <div><dt>{copy.role}</dt><dd>{detail.role}</dd></div>
                  <div class="project-evidence-result"><dt>{copy.result}</dt><dd>{detail.result}</dd></div>
                </dl>
                <div class="project-card-actions">
                  <a class="btn btn-primary" href={projectHref(entry)}>{copy.caseStudy}</a>
                  {entry.data.repoUrl && (
                    <a class="btn btn-secondary" href={entry.data.repoUrl} target="_blank" rel="noopener">{copy.repository}</a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="hub-section">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{copy.prototypeKicker}</p>
          <h2>{copy.prototypeTitle}</h2>
        </div>
        <p>{copy.prototypeLead}</p>
      </div>
      <div class="project-archive-grid">
        {prototypeProjects.map((entry) => (
          <article class="project-archive-card">
            <div class="project-archive-card-head">
              <span>{isEn ? 'Prototype' : '研究原型'}</span>
              <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.getFullYear()}</time>
            </div>
            <h3><a href={projectHref(entry)}>{entry.data.title}</a></h3>
            {entry.data.impact && <p class="project-archive-impact">{entry.data.impact}</p>}
            <p>{entry.data.description}</p>
            <div class="project-card-actions">
              <a class="section-cta" href={projectHref(entry)}>{copy.project} →</a>
              {entry.data.repoUrl && <a class="section-cta" href={entry.data.repoUrl} target="_blank" rel="noopener">GitHub ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="hub-section">
      <div class="hub-section-head">
        <div>
          <p class="section-kicker">{copy.toolsKicker}</p>
          <h2>{copy.toolsTitle}</h2>
        </div>
        <p>{copy.toolsLead}</p>
      </div>
      <div class="project-archive-grid project-archive-grid--compact">
        {toolProjects.map((entry) => (
          <article class="project-archive-card">
            <div class="project-archive-card-head">
              <span>{isEn ? 'Tool' : '工程工具'}</span>
              <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.getFullYear()}</time>
            </div>
            <h3><a href={projectHref(entry)}>{entry.data.title}</a></h3>
            {entry.data.impact && <p class="project-archive-impact">{entry.data.impact}</p>}
            <p>{entry.data.description}</p>
            <div class="project-card-actions">
              <a class="section-cta" href={projectHref(entry)}>{copy.project} →</a>
              {entry.data.repoUrl && <a class="section-cta" href={entry.data.repoUrl} target="_blank" rel="noopener">GitHub ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-contact-strip">
      <div>
        <p class="section-kicker">{isEn ? 'SPEAKING · TECHNICAL EXCHANGE' : 'SPEAKING · TECHNICAL EXCHANGE'}</p>
        <h2>{isEn ? 'Discuss the architecture behind these systems' : '交流這些系統背後的架構判斷'}</h2>
      </div>
      <a class="btn btn-primary" href={toLocalizedPath('/contact/', lang)}>
        {isEn ? 'Speaking & contact' : '演講與聯絡'}
      </a>
    </section>
  </div>
</Layout>
