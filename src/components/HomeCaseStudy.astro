---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import { baseSlug } from '../utils/contentLocale';
import type { HomeCaseStudyDetail } from '../data/homeBrand';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
  index: number;
  detail: HomeCaseStudyDetail;
  variant?: 'featured' | 'compact';
}

const { entry, lang, index, detail, variant = 'featured' } = Astro.props;
const isEn = lang === 'en';
const projectHref = toLocalizedPath(`/projects/${baseSlug(entry)}/`, lang);
const sourceImage = entry.data.image;
const preferredSize = variant === 'featured' ? 'hero' : 'card';
const sizedImage = sourceImage?.startsWith('/')
  ? sourceImage.replace(/\.(?:avif|jpe?g|png|webp)$/i, `-${preferredSize}.webp`)
  : sourceImage;
const projectImage = sizedImage?.startsWith('/') && existsSync(join(process.cwd(), 'public', sizedImage.slice(1)))
  ? sizedImage
  : sourceImage;
const labels = isEn
  ? { problem: 'Problem', solution: 'Method', result: 'Outcome', cta: 'Read case study →' }
  : { problem: '問題', solution: '方法', result: '成果', cta: '閱讀完整案例 →' };
---

<article class:list={['home-case-study', `home-case-study--${variant}`]}>
  <a href={projectHref} class="home-case-study-media" aria-hidden="true" tabindex="-1">
    {projectImage && (
      <Image
        src={projectImage}
        alt=""
        class="home-case-study-image"
        width="960"
        height="600"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    )}
    <span>{String(index).padStart(2, '0')} / 03</span>
  </a>
  <div class="home-case-study-copy">
    <p class="home-case-study-kicker">{entry.data.subtitle}</p>
    <h3><a href={projectHref}>{entry.data.title}</a></h3>
    <dl>
      <div>
        <dt>{labels.problem}</dt>
        <dd>{detail.problem}</dd>
      </div>
      <div>
        <dt>{labels.solution}</dt>
        <dd>{detail.solution}</dd>
      </div>
    </dl>
    <div class="home-case-study-outcome">
      <span>{labels.result}</span>
      <strong>{detail.result}</strong>
    </div>
    <a class="section-cta" href={projectHref}>{labels.cta}</a>
  </div>
</article>
