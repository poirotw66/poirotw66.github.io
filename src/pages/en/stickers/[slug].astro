---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import StickerPostContent from '../../../components/pages/StickerPostContent.astro';
import { resolveEntriesForLang, baseSlug } from '../../../utils/contentLocale';

export async function getStaticPaths() {
  const stickers = resolveEntriesForLang(await getCollection('stickers'), 'en');
  return stickers.map((entry) => ({
    params: { slug: baseSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'stickers'> };
---

<StickerPostContent lang="en" entry={entry} />
