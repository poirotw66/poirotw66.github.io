---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import { baseSlug } from '../utils/contentLocale';

interface Props {
  entry: CollectionEntry<'paperReading'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const entryUrl = toLocalizedPath(`/paper-reading/${baseSlug(entry)}/`, lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const pubIso = entry.data.pubDate.toISOString().slice(0, 10);
const venueLine = [entry.data.paper.venue, entry.data.paper.year].filter(Boolean).join(' · ');
---

<div class="blog-preview-item">
  {entry.data.image && (
    <a href={entryUrl} class="blog-preview-image-wrap" aria-hidden="true" tabindex="-1">
      <Image
        src={entry.data.image}
        alt=""
        class="blog-preview-image"
        width="400"
        height="240"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <a href={entryUrl} class="blog-preview-title">{entry.data.title}</a>
  <div class="preview-card-meta">
    <time class="blog-preview-date" datetime={pubIso}>{formatDate(entry.data.pubDate)}</time>
    {venueLine && (
      <>
        <span class="preview-card-meta-sep" aria-hidden="true"> · </span>
        <span class="paper-preview-venue">{venueLine}</span>
      </>
    )}
  </div>
  {entry.data.tags && entry.data.tags.length > 0 && (
    <ul class="post-tags blog-preview-tags">
      {entry.data.tags.slice(0, 3).map((t) => (
        <li><span class="tag-pill">{t}</span></li>
      ))}
    </ul>
  )}
</div>

