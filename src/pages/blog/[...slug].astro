---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} | AI Platform Engineer`}
  description={post.data.description}
  canonicalURL={new URL(`/blog/${post.slug}/`, Astro.site)}
>
  <section class="section-spacer-lg">
    <div class="article-body">
      <a href="/blog/" class="back">← Blog</a>
      <h1>{post.data.title}</h1>
      <p class="article-meta">{post.data.category}</p>
      <Content />
    </div>
  </section>

  <Footer text="AI Platform & Agentic AI Engineer" />
</Layout>
