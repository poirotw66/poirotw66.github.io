---
import type { CollectionEntry } from 'astro:content';
import { tagToUrlSlug } from '../utils/tag';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang?: Lang;
}

const { post, lang = 'zh' } = Astro.props;
const postUrl = toLocalizedPath(`/blog/${post.id}/`, lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
---

<div class="blog-preview-item">
  {post.data.image && (
    <a href={postUrl} class="blog-preview-image-wrap" aria-hidden="true">
      <img src={post.data.image} alt="" class="blog-preview-image" width="400" height="240" loading="lazy" />
    </a>
  )}
  <a href={postUrl} class="blog-preview-title">{post.data.title}</a>
  <span class="blog-preview-date">{formatDate(post.data.pubDate)}</span>
  {post.data.tags && post.data.tags.length > 0 && (
    <ul class="post-tags blog-preview-tags">
      {post.data.tags.slice(0, 3).map((t) => (
        <li><a href={toLocalizedPath(`/blog/tag/${tagToUrlSlug(t)}/`, lang)}>{t}</a></li>
      ))}
    </ul>
  )}
</div>
