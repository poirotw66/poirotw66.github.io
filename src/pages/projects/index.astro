---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getMainProjects } from '../../utils/sort';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaLinkedIn from '../../components/CtaLinkedIn.astro';

const mainProjects = getMainProjects(await getCollection('projects'));
---

<Layout
  title="Projects | Bloss0m"
  description="Selected projects: Agentic AI, Enterprise RAG, Realtime Voice AI, OCR Automation. AI platform and agent design."
>
  <div class="block-en">
    <div class="content-region">
      <PageHeader title="Projects" subtitle="AI platform · Agent design · RAG · Realtime AI" />

      <section class="section-spacer">
        <div class="showcase">
          {mainProjects.map((entry) => (
            <ProjectCard entry={entry} />
          ))}
        </div>
      </section>

      <CtaLinkedIn lang="en" />
    </div>
  </div>

  <div class="block-zh">
    <div class="content-region">
      <PageHeader title="專案" subtitle="AI 平台 · Agent 設計 · RAG · 即時 AI" />

      <section class="section-spacer">
        <div class="showcase">
          {mainProjects.map((entry) => (
            <ProjectCard entry={entry} />
          ))}
        </div>
      </section>

      <CtaLinkedIn lang="zh" />
    </div>
  </div>
</Layout>
