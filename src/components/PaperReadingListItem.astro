---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { toLocalizedPath } from '../i18n/utils';
import { baseSlug } from '../utils/contentLocale';
import { extractPaperEssence } from '../utils/paperEssence';
import { paperReadingPathForSlug } from '../data/paperReadingPaths';

interface Props {
  entry: CollectionEntry<'paperReading'>;
  lang?: Lang;
}

const { entry, lang = 'zh' } = Astro.props;
const slug = baseSlug(entry);
const href = toLocalizedPath(`/paper-reading/${slug}/`, lang);
const essence = extractPaperEssence(entry.body);
const readingPath = paperReadingPathForSlug(slug);
const formatDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW', { year: 'numeric', month: 'short', day: 'numeric' });
const year = String(entry.data.paper.year);
const field = entry.data.field ?? '';
const difficulty = entry.data.difficulty ?? '';
const difficultyLabel = {
  intro: lang === 'en' ? 'Introductory' : '入門',
  intermediate: lang === 'en' ? 'Intermediate' : '中階',
  advanced: lang === 'en' ? 'Advanced' : '進階',
}[entry.data.difficulty ?? 'intro'];
const searchText = [
  entry.data.title,
  entry.data.description,
  entry.data.field ?? '',
  entry.data.difficulty ?? '',
  entry.data.paper.title,
  ...(entry.data.tags ?? []),
  ...essence.flatMap((point) => [point.label, point.text]),
]
  .join(' ')
  .toLowerCase();
---

<li
  class="blog-list-item"
  data-paper-reading-item="1"
  data-year={year}
  data-field={field}
  data-difficulty={difficulty}
  data-search-text={searchText}
>
  {entry.data.image && (
    <a href={href} class="blog-list-thumb" aria-hidden="true" tabindex="-1">
      <Image
        src={entry.data.image}
        alt=""
        class="blog-list-thumb-img"
        width="200"
        height="125"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <div class="blog-list-body">
    <h3 class="blog-list-title"><a href={href}>{entry.data.title}</a></h3>
    <div class="paper-list-labels">
      {entry.data.difficulty && <span class={`difficulty difficulty-${entry.data.difficulty}`}>{difficultyLabel}</span>}
      {readingPath && <span class="reading-path-chip">{readingPath.title[lang]}</span>}
    </div>
    <div class="meta">
      {entry.data.series ? (
        <>
          <a class="series-chip" href={toLocalizedPath(`/paper-reading/series/${entry.data.series.id}/`, lang)}>
            {entry.data.series.title}: Part {entry.data.series.part}
          </a>
          <span class="meta-sep">,</span>
        </>
      ) : null}
      <span>{lang === 'en' ? 'Note' : '筆記'}: {formatDate(entry.data.pubDate)}</span>
      <span class="meta-sep">,</span>
      <span>{lang === 'en' ? 'Paper' : '論文'}: {entry.data.paper.year}</span>
      {entry.data.field && (
        <>
          <span class="meta-sep">,</span>
          <span>{entry.data.field}</span>
        </>
      )}
    </div>
    <p class="blog-list-desc">{entry.data.description}</p>
    {essence.length > 0 && (
      <details class="paper-essence" data-paper-essence={slug}>
        <summary>{lang === 'en' ? 'Understand it in 90 seconds' : '90 秒掌握這篇論文'}</summary>
        <dl>
          {essence.map((point) => (
            <div>
              <dt>{point.label}</dt>
              <dd>{point.text}</dd>
            </div>
          ))}
        </dl>
        <a href={href} class="paper-essence-read" data-paper-next="essence">
          {lang === 'en' ? 'Read the full deep dive' : '進入完整精讀'} <span aria-hidden="true">→</span>
        </a>
      </details>
    )}
  </div>
</li>

<style>
  .meta-sep {
    opacity: 0.7;
    margin: 0 0.25rem;
  }
  .series-chip {
    text-decoration: none;
  }
  .series-chip:hover {
    text-decoration: underline;
  }
  .difficulty {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.12rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--surface) 88%, var(--accent) 12%);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .paper-list-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.35rem 0 0.55rem;
  }
  .reading-path-chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.76rem;
  }
  .paper-essence {
    margin-top: 0.8rem;
    border-top: 1px solid var(--border);
    padding-top: 0.65rem;
  }
  .paper-essence summary {
    width: fit-content;
    cursor: pointer;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .paper-essence dl {
    display: grid;
    gap: 0.5rem;
    margin: 0.8rem 0;
  }
  .paper-essence dl > div {
    display: grid;
    grid-template-columns: minmax(4.5rem, 0.26fr) 1fr;
    gap: 0.65rem;
  }
  .paper-essence dt {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .paper-essence dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .paper-essence-read {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }
  .paper-essence-read:hover {
    text-decoration: underline;
  }
  .blog-list-title {
    margin: 0;
    font: inherit;
  }
  @media (max-width: 640px) {
    .paper-essence dl > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
